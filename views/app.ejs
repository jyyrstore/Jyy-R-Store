<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="theme-color" content="#191827">
  <% if (view === 'pages/home') { %>
  <meta name="description" content="Jyyr Store menyediakan produk digital dan layanan online dengan proses pemesanan yang aman dan praktis.">
  <% } %>
  <title><%= title || appName %> · <%= appName %></title>
  <link rel="icon" href="<%= staticAsset('/favicon/icon-app.webp') %>" type="image/webp">
  <link rel="preload" href="/fonts/font-brand-jyyr.ttf" as="font" type="font/ttf" crossorigin="anonymous">
  <link rel="stylesheet" href="<%= staticAsset('/css/reset.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/variables.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/layout.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/components.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/navigation.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/store.css') %>">
  <% if (view !== 'pages/home') { %>
  <link rel="stylesheet" href="<%= staticAsset('/css/pages.css') %>">
  <% } %>
  <link rel="stylesheet" href="<%= staticAsset('/css/animations.css') %>">
  <link rel="stylesheet" href="<%= staticAsset('/css/responsive.css') %>">
  <script defer src="<%= staticAsset('/js/app.js') %>"></script>
</head>
<body data-view="<%= view || '' %>" data-user-id="<%= currentUser?.id || '' %>">
  <% if (view !== 'pages/configuration' && !String(view||'').startsWith('pages/auth')) { %>
    <%- include('partials/header') %>
    <div class="app-shell">
      <%- include('partials/sidebar') %>
      <div class="main-column">
        <main class="main-content" id="main-content">
          <%- include(view) %>
        </main>
        <%- include('partials/footer') %>
      </div>
    <%- include('partials/bottom-nav') %>
    </div>
  <% } else { %>
    <main class="auth-shell<%= view === 'pages/auth' && (mode === 'login' || mode === 'register') ? ' auth-shell-login' : '' %>"><%- include(view) %></main>
  <% } %>
  <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
  <div id="modal-root"></div>
  <script nonce="<%= cspNonce %>">
    window.JYYR = {
      user: <%- JSON.stringify(profile || null) %>,
      csrf: <%- JSON.stringify(csrfToken || '') %>,
      icons: <%- JSON.stringify(iconPaths || {}) %>,
      iconViewBoxes: {
        "editing-design": "0 0 1200 1175",
        "console-game": "0 0 1200 937",
        "withicons-skeuo-images": "0 0 24 24",
        'premium-app': "0 0 1092 1200",
        'withicons-lunar:crown':'0 0 24 24',
        'streamline-plump-color:star-medal':'0 0 48 48',
        'trophy-v1':'0 0 128 128',
        'video-game':'0 0 128 128',
        'qris':'0 0 108.37466 17.412731'
      }
    };

    let iconRenderSequence=0;

    window.JYYRIcon = function(name, cls='icon', label=''){
      const registry=window.JYYR?.icons||{};
      const iconViewBoxes=window.JYYR?.iconViewBoxes||{};
      const isCustom=Object.prototype.hasOwnProperty.call(iconViewBoxes,name);
      let body=registry[name]||registry.info||'';

      if(name==='withicons-lunar:crown'){
        const gradientId=`jyyr-crown-gradient-client-${++iconRenderSequence}`;
        body=body.replace(/SVGjjqMcdLQ/g,gradientId);
      }

      if(name==='trophy-v1'){
        const svgId=`jyyr-trophy-v1-client-${++iconRenderSequence}`;
        body=body.replace(/SVGKFFKCdLp/g,svgId);
      }

      const viewBox=iconViewBoxes[name]||'0 0 24 24';
      const stroke=isCustom?'none':'currentColor';
      const aria=label
        ? ` role="img" aria-label="${String(label).replace(/"/g,'&quot;')}"`
        : ' aria-hidden="true"';

      return `<svg class="${cls}" viewBox="${viewBox}" fill="none" stroke="${stroke}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"${aria}>${body}</svg>`;
    };
  </script>
  <script defer src="<%= staticAsset('/js/api.js') %>"></script>
  <script defer src="<%= staticAsset('/js/navigation.js') %>"></script>
  <script defer src="<%= staticAsset('/js/modal.js') %>"></script>
  <script defer src="<%= staticAsset('/js/pickers.js') %>"></script>
  <script defer src="<%= staticAsset('/js/toast.js') %>"></script>
  <script defer src="<%= staticAsset('/js/pages.js') %>"></script>
</body>
</html>
