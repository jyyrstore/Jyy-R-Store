      class="jyyr-picker-input"
      readonly
      data-jyyr-picker
      data-jyyr-picker-mode="date"
      data-jyyr-value=""
      placeholder="Pilih tanggal mulai"
      aria-label="Tanggal mulai analytics"
    >
    <input
      type="hidden"
      data-analytics-from
      data-jyyr-picker-value
      value=""
    >
  </div>

  <div class="jyyr-date-field" data-jyyr-date-field>
    <input
      type="text"
      class="jyyr-picker-input"
      readonly
      data-jyyr-picker
      data-jyyr-picker-mode="date"
      data-jyyr-value=""
      placeholder="Pilih tanggal akhir"
      aria-label="Tanggal akhir analytics"
    >
    <input
      type="hidden"
      data-analytics-to
      data-jyyr-picker-value
      value=""
    >
  </div>

  <button
    class="button button-secondary"
    type="button"
    data-analytics-apply
  >Terapkan</button>
</div></div>
          <div class="panel"><div class="section-header"><div><h2>Deposit & Pengguna Baru</h2><p class="muted">Deposit sukses dan pertumbuhan user.</p></div></div><div class="chart-wrap"><canvas id="owner-growth-chart" height="260"></canvas></div></div>
          <div class="panel"><h2>Status Pesanan</h2><div class="status-bars"><% (analytics.status||[]).forEach(s=>{ const max=Math.max(...(analytics.status||[]).map(x=>Number(x.count)||0),1); %><div><div class="bar-value"><%= s.count %></div><div class="bar"><span style="height:<%= Math.min(100,Number(s.count)/max*100) %>%"></span></div><div class="bar-label"><span><%= s.status %></span></div></div><% }) %></div></div>
        </div>
      <% } else if(ownerSection==='products'){ %>
        <div class="toolbar panel">
          <form class="owner-filter-bar" method="get">
            <label class="owner-filter-field owner-filter-search">
              <span class="owner-filter-label">Cari produk</span>
              <span class="owner-filter-input-wrap">
                <%- icon('search') %>
                <input
                  name="search"
                  value="<%= req.query.search||'' %>"
                  placeholder="Cari nama/slug"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Cari produk berdasarkan nama atau slug"
                >
              </span>
            </label>

            <div class="owner-filter-field owner-filter-status">
              <span class="owner-filter-label">Status</span>

              <div
                class="owner-filter-dropdown"
                data-owner-filter-dropdown
              >
                <input
                  type="hidden"
                  name="status"
                  value="<%= req.query.status||'' %>"
                  data-owner-filter-value
                >

                <button
                  class="owner-filter-trigger"
                  type="button"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  data-owner-filter-trigger
                >
