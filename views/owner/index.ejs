    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="1y" data-label="1 Tahun">1 Tahun</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="custom" data-label="Kustom">Kustom</button>
  </div>
</div></div><div class="inline-actions analytics-custom owner-revenue-orders-custom" data-analytics-custom hidden>
  <div class="jyyr-date-field" data-jyyr-date-field>
