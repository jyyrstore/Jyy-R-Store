<% if(ownerSection==='products'){ %>
<script nonce="<%= cspNonce %>">
(() => {
  const root = document.querySelector('[data-owner-filter-dropdown]');
  if (!root) return;

  const trigger = root.querySelector('[data-owner-filter-trigger]');
  const menu = root.querySelector('[data-owner-filter-menu]');
  const value = root.querySelector('[data-owner-filter-value]');
  const label = root.querySelector('[data-owner-filter-label]');
  const options = [...root.querySelectorAll('[data-owner-filter-option]')];

  if (!trigger || !menu || !value || !label) return;

  const close = () => {
    root.classList.remove('open');
    trigger.setAttribute('aria-expanded', 'false');
  };

  const open = () => {
    root.classList.add('open');
    trigger.setAttribute('aria-expanded', 'true');
  };

  trigger.addEventListener('click', (event) => {
    event.preventDefault();
    root.classList.contains('open') ? close() : open();
  });

  options.forEach(option => {
    option.addEventListener('click', () => {
      const nextValue = option.dataset.ownerFilterOption || '';
      value.value = nextValue;

      label.textContent =
        nextValue === 'DRAFT'
          ? 'Draft'
          : nextValue === 'PUBLISHED'
            ? 'Tersedia'
            : nextValue === 'ARCHIVED'
              ? 'Diarsipkan'
              : 'Semua status';

      options.forEach(item => {
        const selected = (item.dataset.ownerFilterOption || '') === nextValue;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-selected', selected ? 'true' : 'false');
      });

      close();
      trigger.focus();
    });
  });

  document.addEventListener('click', (event) => {
    if (!root.contains(event.target)) close();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      close();
      trigger.focus();
    }
  });
})();
</script>
<% } %>

<% if(ownerSection==='dashboard' || ownerSection==='reports'){ %>
<script nonce="<%= cspNonce %>">
document.addEventListener('DOMContentLoaded',()=>{let charts={};const daily0=<%- JSON.stringify((analytics&&analytics.daily)||[]) %>;const render=(daily,status)=>{if(!window.Chart)return;const mk=(id,type,data,chartOptions={})=>{const c=document.getElementById(id);if(!c)return;if(charts[id])charts[id].destroy();charts[id]=new Chart(c,{type,data,options:{responsive:true,maintainAspectRatio:false,...chartOptions}})};mk('owner-chart','line',{labels:daily.map(x=>x.day),datasets:[{label:'Pendapatan',yAxisID:'yRevenue',data:daily.map(x=>Number(x.revenue))},{label:'Pesanan',yAxisID:'yOrders',data:daily.map(x=>Number(x.orders))}]},{plugins:{legend:{position:'bottom'},tooltip:{callbacks:{label:ctx=>ctx.dataset.yAxisID==='yRevenue'?`Pendapatan: ${new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(ctx.parsed.y)}`:`Pesanan: ${new Intl.NumberFormat('id-ID').format(ctx.parsed.y)}`}}},scales:{yRevenue:{type:'linear',position:'left',beginAtZero:true,ticks:{callback:value=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',notation:'compact',maximumFractionDigits:1}).format(value)}},yOrders:{type:'linear',position:'right',beginAtZero:true,grid:{drawOnChartArea:false},ticks:{precision:0,callback:value=>new Intl.NumberFormat('id-ID').format(value)}}}});mk('owner-growth-chart','line',{labels:daily.map(x=>x.day),datasets:[{label:'Deposit',data:daily.map(x=>Number(x.deposit||0))},{label:'New Users',data:daily.map(x=>Number(x.new_users||0))}]});mk('report-chart','bar',{labels:daily.map(x=>x.day),datasets:[{label:'Revenue',data:daily.map(x=>Number(x.revenue))},{label:'Deposit',data:daily.map(x=>Number(x.deposit||0))}]});};render(daily0,<%- JSON.stringify((analytics&&analytics.status)||[]) %>);const period=document.querySelector('[data-owner-period]');const custom=document.querySelector('[data-analytics-custom]');const from=document.querySelector('[data-analytics-from]');const to=document.querySelector('[data-analytics-to]');const apply=async()=>{const p=period?.value||'30d';const url=new URL('/api/owner/analytics',location.origin);url.searchParams.set('period',p);if(p==='custom'){if(!from?.value||!to?.value)return window.JYYRToast?.error('Pilih rentang tanggal analytics.');url.searchParams.set('from',from.value+'T00:00:00');url.searchParams.set('to',to.value+'T23:59:59')}try{const r=await window.JYYRApi.request(url.pathname+url.search);render(r.daily||[],r.status||[])}catch(err){window.JYYRToast?.error(err.message)}};period?.addEventListener('change',()=>{if(custom)custom.hidden=period.value!=='custom';if(period.value!=='custom')apply()});document.querySelector('[data-analytics-apply]')?.addEventListener('click',apply)});
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% } %>

<% function dataKeys(s){ const map={orders:['order_number','username','total','status'],payments:['reference','order_number','username','amount','status'],deposits:['reference','username','amount','status']}; return map[s]||['id']; } function formatCell(row,k){ let v=row[k]; if(k==='price'||k==='amount'||k==='balance'||k==='total'||k==='revenue') return formatIDR(v); if(k==='status') return labelStatus(v); if(k==='created_at') return formatDate(v); if(typeof v==='object'&&v) return JSON.stringify(v); return v??'—'; } %>
