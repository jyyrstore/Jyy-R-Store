                    <span>Draft</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='PUBLISHED'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='PUBLISHED' ? 'true' : 'false' %>"
                    data-owner-filter-option="PUBLISHED"
                  >
                    <span>Tersedia</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='ARCHIVED'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='ARCHIVED' ? 'true' : 'false' %>"
                    data-owner-filter-option="ARCHIVED"
                  >
                    <span>Diarsipkan</span>
                  </button>
                </div>
              </div>
            </div>

            <button class="button button-primary owner-filter-submit" type="submit">
              <%- icon('search') %>
              <span>Filter</span>
            </button>
          </form>
        </div>
        <div class="owner-product-list-panel">
          <% if(!items?.length){ %>
            <div class="empty-state compact"><%- icon('shop-twotone') %><h3>Belum ada produk</h3><p>Buat produk, lengkapi content, lalu publish saat semuanya siap.</p></div>
          <% } else { %>
            <div class="owner-product-card-grid">
              <% (items||[]).forEach(row=>{ %>
                <article class="owner-product-card">
                  <h3 class="owner-product-card-title"><%= row.name %></h3>

                  <div class="owner-product-card-details">
                    <div class="owner-product-card-metric-group">
                      <div class="owner-product-card-metric-labels">
                        <span>Kategori</span>
                        <span>Slug</span>
                        <span>Harga</span>
                      </div>
                      <div class="owner-product-card-metric-values">
                        <strong><%= row.category_name||'—' %></strong>
                        <strong><%= row.slug %></strong>
                        <strong><%= formatIDR(row.price) %></strong>
                      </div>
                    </div>

                    <div class="owner-product-card-metric-group">
                      <div class="owner-product-card-metric-labels">
                        <span>Stock</span>
                        <span>Content</span>
                        <span>Status</span>
                      </div>
                      <div class="owner-product-card-metric-values">
                        <strong><%= row.stock %></strong>
                        <strong><%= row.content_count||0 %></strong>
                        <strong><%= Number(row.stock) > 0 ? 'Tersedia' : 'Habis' %></strong>
                      </div>
                    </div>
                  </div>

                  <div class="owner-product-card-actions">
                    <button class="button button-secondary button-small" data-owner-edit-product='<%- JSON.stringify({...row,thumbnail_url:row.thumbnail_path?assetUrl(publicAssetBucket,row.thumbnail_path):null}).replace(/'/g,"&#39;") %>'>Edit</button>
                    <button class="button button-secondary button-small"
                      data-owner-content="<%= row.id %>"
                      data-owner-product-name="<%- row.name.replace(/"/g,'&quot;') %>"
                      data-owner-product-status="<%= row.status %>"
                      data-owner-has-thumbnail="<%= row.thumbnail_path ? '1' : '0' %>">Konten & Publikasi</button>
                    <% if(row.status==='PUBLISHED'){ %>
                      <button class="button button-secondary button-small" data-owner-unpublish="<%= row.id %>">Batalkan Publikasi</button>
                    <% } else if(row.status!=='ARCHIVED'){ %>
                      <button class="button button-success button-small" data-owner-publish="<%= row.id %>">Publikasikan</button>
                    <% } %>
                    <button class="button button-secondary button-small" data-owner-duplicate="<%= row.id %>">Duplikat</button>
                    <button class="button button-danger button-small" data-owner-delete-product="<%= row.id %>"><%- icon('trash-can') %>Hapus</button>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
          <%- include('../partials/pagination',{
            pagination:ownerPagination,
            param:'page',
            query:req.query,
            label:'Pagination produk'
          }) %>
        </div>

      <% } else if(ownerSection==='roles'){ %>
        <div class="panel table-panel owner-audit-table-panel owner-roles-table-panel"><h2>Status Pengguna</h2><div class="table-scroll"><table><thead><tr><th>Code</th><th>Name</th><th>Permissions</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td data-label="Code"><%= row.code %></td><td data-label="Name"><%= row.name %></td><td data-label="Permissions"><%= JSON.stringify(row.permissions||{}) %></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='categories'){ %>
          <% if(!items?.length){ %>
            <div class="empty-state compact"><%- icon('layers') %><h3>Belum ada kategori</h3></div>
          <% } else { %>
            <div class="owner-categories-grid">
              <% (items||[]).forEach(row=>{ %>
                <article class="owner-category-card">
                  <div class="owner-category-fields">
                    <div><span>Name</span><strong><%= row.name %></strong></div>
                    <div><span>Slug</span><strong><%= row.slug %></strong></div>
                    <div><span>Active</span><strong><%= row.is_active?'Aktif':'Nonaktif' %></strong></div>
                  </div>
                  <div class="owner-category-actions">
                    <button class="button button-secondary button-small" data-owner-edit-category='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button>
                    <button class="button button-danger button-small" type="button" data-owner-delete-category="<%= row.id %>"><%- icon('trash-can') %>Hapus</button>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
      <% } else if(ownerSection==='users'){ %>
        <%
          const userSearch=String(req.query.search||'');
          const userRole=String(req.query.role||'').toUpperCase();
          const userStatus=String(req.query.status||'').toUpperCase();
          const hasUserFilters=!!(userSearch||userRole||userStatus);
        %>

        <div class="panel owner-users-toolbar">
          <form class="owner-users-filter" method="get">
            <label class="owner-users-filter-field owner-users-search">
              <span>Cari pengguna</span>
              <input
                name="search"
                value="<%= userSearch %>"
                placeholder="Cari username atau email"
                autocomplete="off"
                spellcheck="false"
              >
            </label>

            <label class="owner-users-filter-field">
              <span>Role</span>
              <div class="jyyr-select" data-jyyr-select>
  <input type="hidden" name="role" value="<%= userRole %>" data-jyyr-select-value>
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua role</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua role">Semua role</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="USER" data-label="User">User</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="MODERATOR" data-label="Moderator">Moderator</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="ADMIN" data-label="Admin">Admin</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="OWNER" data-label="Owner">Owner</button>
  </div>
</div>
<script>
/* server-selected role is synchronized by the global picker */
</script>
            </label>

            <label class="owner-users-filter-field">
              <span>Status</span>
              <div class="jyyr-select" data-jyyr-select>
  <input type="hidden" name="status" value="<%= userStatus %>" data-jyyr-select-value>
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua status</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua status">Semua status</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="ACTIVE" data-label="Aktif">Aktif</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="SUSPENDED" data-label="Suspended">Suspended</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="BANNED" data-label="Banned">Banned</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="PENDING" data-label="Pending">Pending</button>
  </div>
</div>
            </label>

            <button class="button button-primary owner-users-filter-submit" type="submit">
              <%- icon('search') %>
              <span>Filter</span>
            </button>

            <% if(hasUserFilters){ %>
              <a class="button button-secondary owner-users-filter-reset" href="/owner/users">
                Reset
              </a>
            <% } %>
          </form>
        </div>

        <div class="panel table-panel owner-audit-table-panel owner-users-table-panel">
          <h2>Detail Pengguna</h2>
          <div class="table-scroll">
            <table class="owner-users-table">
              <colgroup>
                <col class="owner-users-col-user">
                <col class="owner-users-col-role">
                <col class="owner-users-col-status">
                <col class="owner-users-col-balance">
                <col class="owner-users-col-orders">
                <col class="owner-users-col-registered">
                <col class="owner-users-col-action">
              </colgroup>

              <thead>
                <tr>
                  <th>User</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Balance</th>
                  <th>Orders</th>
                  <th>Registered</th>
                  <th>Aksi</th>
                </tr>
              </thead>

              <tbody>
                <% if(!items?.length){ %>
                  <tr>
                    <td colspan="7">
                      <div class="empty-state compact">
                        <%- icon('interface-user-circle-circle-geometric') %>
                        <h3>Belum ada user</h3>
                        <p>Tidak ada pengguna yang cocok dengan filter.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>

                <% (items||[]).forEach(row=>{ %>
                  <tr>
                    <td data-label="User">
                      <strong class="owner-users-username"><%= row.username %></strong>
                      <small class="muted block owner-users-email"><%= row.email %></small>
                    </td>

                    <td data-label="Role">
                      <%= row.role %>
                    </td>

                    <td data-label="Status">
                      <span class="status-badge status-<%= String(row.status).toLowerCase() %>">
                        <%= labelStatus(row.status) %>
                      </span>
                    </td>

                    <td data-label="Balance">
                      <%= formatIDR(row.balance) %>
                    </td>

                    <td data-label="Orders">
                      <%= row.orders %>
                    </td>

                    <td data-label="Registered">
                      <%= formatDate(row.created_at) %>
                    </td>

                    <td data-label="Aksi">
                      <div class="table-actions">
                        <button
                          class="button button-secondary button-small"
                          data-owner-user="<%= row.id %>"
                          data-owner-username="<%= row.username %>"
                          data-owner-role="<%= row.role %>"
                          data-owner-status="<%= row.status %>"
                        >Kelola</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination pengguna'
}) %>
        </div>
      <% } else if(['orders','payments','deposits'].includes(ownerSection)){ %>
        <div class="panel table-panel<%= ['deposits','payments','orders'].includes(ownerSection)?' owner-audit-table-panel owner-'+ownerSection+'-table-panel':'' %>"><% if(['deposits','payments','orders'].includes(ownerSection)){ %><h2><%= ownerSection==='deposits'?'History Deposits':ownerSection==='payments'?'History Payments':'History Orders' %></h2><% } %><div class="table-scroll"><table><thead><tr><% const keys=dataKeys(ownerSection); keys.forEach(k=>{ %><th><%= k.replace(/_/g,' ') %></th><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><th>Created</th><% } %></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="<%= keys.length+((ownerSection==='payments'||ownerSection==='deposits')?1:0) %>"><div class="empty-state compact"><%- icon('inbox') %><h3>Belum ada data</h3><p>Coba ubah filter atau rentang data.</p></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><% keys.forEach(k=>{ %><td data-label="<%= k.replace(/_/g,' ') %>"><%= formatCell(row,k) %></td><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><td data-label="Created"><%= formatDate(row.created_at) %></td><% } %></tr><% if(ownerSection==='orders'){ %><tr class="owner-order-actions-row"><td class="owner-order-actions-cell" colspan="<%= keys.length %>"><div class="table-actions"><button class="button button-secondary button-small" data-owner-order-inspect='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Lihat</button><% if(row.status==='PAID'){ %><button class="button button-secondary button-small" data-owner-order-status="<%= row.id %>" data-status="PROCESSING">Proses</button><% } else if(row.status==='PROCESSING'){ %><button class="button button-success button-small" data-owner-order-status="<%= row.id %>" data-status="COMPLETED">Selesaikan</button><% } %><% if(row.status==='PENDING'){ %><button class="button button-danger button-small" data-owner-order-status="<%= row.id %>" data-status="CANCELLED"><%- icon('circle-x','icon icon-circle-x') %>Batalkan</button><% } %></div></td></tr><% } %><% }) %></tbody></table></div>
<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination transaksi'
}) %>
</div>
