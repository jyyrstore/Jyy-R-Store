<script nonce="<%= cspNonce %>">window.__OWNER_CATEGORIES=<%- JSON.stringify(typeof categories !== "undefined" ? categories : []) %>;</script>
<section class="page-shell owner-page">
  <div class="owner-content">
      <div class="page-header">
        <div><div class="eyebrow">Owner</div><h1><%= ownerSection==='dashboard'?'Ringkasan':ownerSection.replace(/(^|-)/g,m=>m.toUpperCase()).replace(/-/g,' ') %></h1><p>Semua aksi sensitif tetap diverifikasi server-side dan dicatat ke activity log.</p></div>
        <% if(['products','categories','services','faq','information','notifications'].includes(ownerSection)){ %>
          <button class="button button-primary" data-owner-create="<%= ownerSection %>"><%- icon('circle-plus') %> Tambah</button>
        <% } %>
      </div>

      <% if(ownerSection==='dashboard'){ %>
        <div class="stat-grid">
          <div class="stat-card"><span>Total Pengguna</span><strong><%= dashboard.users %></strong></div>
          <div class="stat-card"><span>Total Pesanan</span><strong><%= dashboard.orders %></strong></div>
          <div class="stat-card"><span>Total Pendapatan</span><strong><%= formatIDR(dashboard.revenue) %></strong></div>
          <div class="stat-card"><span>Total Deposit</span><strong><%= formatIDR(dashboard.deposit) %></strong></div>
          <div class="stat-card"><span>Total Produk</span><strong><%= dashboard.products %></strong></div>
          <div class="stat-card"><span>Tiket Aktif</span><strong><%= dashboard.tickets %></strong></div>
        </div>
        <div class="chart-grid">
          <div class="panel"><div class="section-header"><div><h2>Pendapatan & Pesanan</h2><p class="muted">Data berasal dari analytics service/database.</p></div><div class="jyyr-select" data-jyyr-select>
  <input
    type="hidden"
    value="30d"
    data-owner-period
    data-jyyr-select-value
  >
  <button
    class="jyyr-select-trigger"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-jyyr-select-trigger
  >
    <span data-jyyr-select-label>30 Hari</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="today" data-label="Hari Ini">Hari Ini</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="7d" data-label="7 Hari">7 Hari</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="30d" data-label="30 Hari">30 Hari</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="90d" data-label="3 Bulan">3 Bulan</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="180d" data-label="6 Bulan">6 Bulan</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="1y" data-label="1 Tahun">1 Tahun</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="custom" data-label="Kustom">Kustom</button>
  </div>
</div></div><div class="inline-actions analytics-custom" data-analytics-custom hidden>
  <div class="jyyr-date-field" data-jyyr-date-field>
    <input
      type="text"
      class="jyyr-picker-input"
      readonly
      data-jyyr-picker
      data-jyyr-picker-mode="date"
      data-jyyr-value=""
      placeholder="Tanggal mulai"
      aria-label="Tanggal mulai analytics"
    >
    <input
      type="hidden"
      data-analytics-from
      data-jyyr-picker-value
      value=""
    >
  </div>

  <div class="jyyr-date-field" data-jyyr-date-field>
    <input
      type="text"
      class="jyyr-picker-input"
      readonly
      data-jyyr-picker
      data-jyyr-picker-mode="date"
      data-jyyr-value=""
      placeholder="Tanggal akhir"
      aria-label="Tanggal akhir analytics"
    >
    <input
      type="hidden"
      data-analytics-to
      data-jyyr-picker-value
      value=""
    >
  </div>

  <button
    class="button button-secondary"
    type="button"
    data-analytics-apply
  >Terapkan</button>
</div></div>
          <div class="panel"><div class="section-header"><div><h2>Deposit & Pengguna Baru</h2><p class="muted">Deposit sukses dan pertumbuhan user.</p></div></div><div class="chart-wrap"><canvas id="owner-growth-chart" height="260"></canvas></div></div>
          <div class="panel"><h2>Status Pesanan</h2><div class="status-bars"><% (analytics.status||[]).forEach(s=>{ const max=Math.max(...(analytics.status||[]).map(x=>Number(x.count)||0),1); %><div><div class="bar-label"><span><%= s.status %></span><b><%= s.count %></b></div><div class="bar"><span style="width:<%= Math.min(100,Number(s.count)/max*100) %>%"></span></div></div><% }) %></div></div>
        </div>
      <% } else if(ownerSection==='products'){ %>
        <div class="toolbar panel">
          <form class="owner-filter-bar" method="get">
            <label class="owner-filter-field owner-filter-search">
              <span class="owner-filter-label">Cari produk</span>
              <span class="owner-filter-input-wrap">
                <%- icon('search') %>
                <input
                  name="search"
                  value="<%= req.query.search||'' %>"
                  placeholder="Cari nama/slug"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Cari produk berdasarkan nama atau slug"
                >
              </span>
            </label>

            <div class="owner-filter-field owner-filter-status">
              <span class="owner-filter-label">Status</span>

              <div
                class="owner-filter-dropdown"
                data-owner-filter-dropdown
              >
                <input
                  type="hidden"
                  name="status"
                  value="<%= req.query.status||'' %>"
                  data-owner-filter-value
                >

                <button
                  class="owner-filter-trigger"
                  type="button"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  data-owner-filter-trigger
                >
                  <span data-owner-filter-label>
                    <%= req.query.status==='DRAFT'
                      ? 'Draft'
                      : req.query.status==='PUBLISHED'
                        ? 'Tersedia'
                        : req.query.status==='ARCHIVED'
                          ? 'Diarsipkan'
                          : 'Semua status' %>
                  </span>
                  <span class="owner-filter-chevron" aria-hidden="true"></span>
                </button>

                <div
                  class="owner-filter-menu"
                  role="listbox"
                  aria-label="Pilih status produk"
                  data-owner-filter-menu
                >
                  <button
                    type="button"
                    class="owner-filter-option <%= !req.query.status?'active':'' %>"
                    role="option"
                    aria-selected="<%= !req.query.status ? 'true' : 'false' %>"
                    data-owner-filter-option=""
                  >
                    <span>Semua status</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='DRAFT'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='DRAFT' ? 'true' : 'false' %>"
                    data-owner-filter-option="DRAFT"
                  >
                    <span>Draft</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='PUBLISHED'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='PUBLISHED' ? 'true' : 'false' %>"
                    data-owner-filter-option="PUBLISHED"
                  >
                    <span>Tersedia</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='ARCHIVED'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='ARCHIVED' ? 'true' : 'false' %>"
                    data-owner-filter-option="ARCHIVED"
                  >
                    <span>Diarsipkan</span>
                  </button>
                </div>
              </div>
            </div>

            <button class="button button-primary owner-filter-submit" type="submit">
              <%- icon('search') %>
              <span>Filter</span>
            </button>
          </form>
        </div>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Produk</th><th>Kategori</th><th>Harga</th><th>Stock</th><th>Content</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
          <% if(!items?.length){ %><tr><td colspan="7"><div class="empty-state compact"><%- icon('shop-twotone') %><h3>Belum ada produk</h3><p>Buat produk, lengkapi content, lalu publish saat semuanya siap.</p></div></td></tr><% } %>
          <% (items||[]).forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small class="muted block">/<%= row.slug %></small></td><td><%= row.category_name||'—' %></td><td><%= formatIDR(row.price) %></td><td><%= row.stock %></td><td><span class="status-badge"><%= row.content_count||0 %></span></td><td><span class="status-badge status-<%= String(row.status).toLowerCase() %>"><%= labelStatus(row.status) %></span></td><td><div class="table-actions"><button class="button button-secondary button-small" data-owner-edit-product='<%- JSON.stringify({...row,thumbnail_url:row.thumbnail_path?assetUrl(publicAssetBucket,row.thumbnail_path):null}).replace(/'/g,"&#39;") %>'>Edit</button><button class="button button-secondary button-small"
  data-owner-content="<%= row.id %>"
  data-owner-product-name="<%- row.name.replace(/"/g,'&quot;') %>"
  data-owner-product-status="<%= row.status %>"
  data-owner-has-thumbnail="<%= row.thumbnail_path ? '1' : '0' %>">Konten & Publikasi</button><% if(row.status==='PUBLISHED'){ %><button class="button button-secondary button-small" data-owner-unpublish="<%= row.id %>">Batalkan Publikasi</button><% } else if(row.status!=='ARCHIVED'){ %><button class="button button-success button-small" data-owner-publish="<%= row.id %>">Publikasikan</button><% } %><button class="button button-secondary button-small" data-owner-duplicate="<%= row.id %>">Duplikat</button><button class="button button-danger button-small" data-owner-delete-product="<%= row.id %>">Hapus</button></div></td></tr><% }) %>
        </tbody></table></div>
<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination produk'
}) %>
</div>
      <% } else if(ownerSection==='roles'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Code</th><th>Name</th><th>Permissions</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td><%= row.code %></td><td><%= row.name %></td><td><%= JSON.stringify(row.permissions||{}) %></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='messages'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>User</th><th>Sender</th><th>Message</th><th>Created</th><th>Action</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="5"><div class="empty-state compact"><%- icon('message') %><h3>Belum ada pesan</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.user_username %></td><td><%= row.sender_username %></td><td><%= row.body %></td><td><%= formatDate(row.created_at) %></td><td><button class="button button-secondary button-small" data-owner-message="<%= row.user_id %>">Balas</button></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination pesan'
}) %>
</div>
      <% } else if(ownerSection==='categories'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Name</th><th>Slug</th><th>Active</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="4"><div class="empty-state compact"><%- icon('layers') %><h3>Belum ada kategori</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.name %></td><td><%= row.slug %></td><td><%= row.is_active?'Aktif':'Nonaktif' %></td><td><button class="button button-secondary button-small" data-owner-edit-category='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='users'){ %>
        <%
          const userSearch=String(req.query.search||'');
          const userRole=String(req.query.role||'').toUpperCase();
          const userStatus=String(req.query.status||'').toUpperCase();
          const hasUserFilters=!!(userSearch||userRole||userStatus);
        %>

        <div class="panel owner-users-toolbar">
          <form class="owner-users-filter" method="get">
            <label class="owner-users-filter-field owner-users-search">
              <span>Cari pengguna</span>
              <input
                name="search"
                value="<%= userSearch %>"
                placeholder="Cari username atau email"
                autocomplete="off"
                spellcheck="false"
              >
            </label>

            <label class="owner-users-filter-field">
              <span>Role</span>
              <div class="jyyr-select" data-jyyr-select>
  <input type="hidden" name="role" value="<%= userRole %>" data-jyyr-select-value>
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua role</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua role">Semua role</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="USER" data-label="User">User</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="MODERATOR" data-label="Moderator">Moderator</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="ADMIN" data-label="Admin">Admin</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="OWNER" data-label="Owner">Owner</button>
  </div>
</div>
<script>
/* server-selected role is synchronized by the global picker */
</script>
            </label>

            <label class="owner-users-filter-field">
              <span>Status</span>
              <div class="jyyr-select" data-jyyr-select>
  <input type="hidden" name="status" value="<%= userStatus %>" data-jyyr-select-value>
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua status</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua status">Semua status</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="ACTIVE" data-label="Aktif">Aktif</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="SUSPENDED" data-label="Suspended">Suspended</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="BANNED" data-label="Banned">Banned</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="PENDING" data-label="Pending">Pending</button>
  </div>
</div>
            </label>

            <button class="button button-primary owner-users-filter-submit" type="submit">
              <%- icon('search') %>
              <span>Filter</span>
            </button>

            <% if(hasUserFilters){ %>
              <a class="button button-secondary owner-users-filter-reset" href="/owner/users">
                Reset
              </a>
            <% } %>
          </form>
        </div>

        <div class="panel table-panel">
          <div class="table-scroll">
            <table class="owner-users-table">
              <colgroup>
                <col class="owner-users-col-user">
                <col class="owner-users-col-role">
                <col class="owner-users-col-status">
                <col class="owner-users-col-balance">
                <col class="owner-users-col-orders">
                <col class="owner-users-col-registered">
                <col class="owner-users-col-action">
              </colgroup>

              <thead>
                <tr>
                  <th>User</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Balance</th>
                  <th>Orders</th>
                  <th>Registered</th>
                  <th>Aksi</th>
                </tr>
              </thead>

              <tbody>
                <% if(!items?.length){ %>
                  <tr>
                    <td colspan="7">
                      <div class="empty-state compact">
                        <%- icon('interface-user-circle-circle-geometric') %>
                        <h3>Belum ada user</h3>
                        <p>Tidak ada pengguna yang cocok dengan filter.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>

                <% (items||[]).forEach(row=>{ %>
                  <tr>
                    <td data-label="User">
                      <strong class="owner-users-username"><%= row.username %></strong>
                      <small class="muted block owner-users-email"><%= row.email %></small>
                    </td>

                    <td data-label="Role">
                      <%= row.role %>
                    </td>

                    <td data-label="Status">
                      <span class="status-badge status-<%= String(row.status).toLowerCase() %>">
                        <%= labelStatus(row.status) %>
                      </span>
                    </td>

                    <td data-label="Balance">
                      <%= formatIDR(row.balance) %>
                    </td>

                    <td data-label="Orders">
                      <%= row.orders %>
                    </td>

                    <td data-label="Registered">
                      <%= formatDate(row.created_at) %>
                    </td>

                    <td data-label="Aksi">
                      <div class="table-actions">
                        <button
                          class="button button-secondary button-small"
                          data-owner-user="<%= row.id %>"
                          data-owner-username="<%= row.username %>"
                          data-owner-role="<%= row.role %>"
                          data-owner-status="<%= row.status %>"
                        >Kelola</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination pengguna'
}) %>
        </div>
      <% } else if(['orders','payments','deposits'].includes(ownerSection)){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><% const keys=dataKeys(ownerSection); keys.forEach(k=>{ %><th><%= k.replace(/_/g,' ') %></th><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><th>Created</th><% } %><% if(ownerSection==='orders'){ %><th>Aksi</th><% } %></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="<%= keys.length+((ownerSection==='payments'||ownerSection==='deposits')?1:0)+((ownerSection==='orders')?1:0) %>"><div class="empty-state compact"><%- icon('inbox') %><h3>Belum ada data</h3><p>Coba ubah filter atau rentang data.</p></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><% keys.forEach(k=>{ %><td><%= formatCell(row,k) %></td><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><td><%= formatDate(row.created_at) %></td><% } %><% if(ownerSection==='orders'){ %><td><div class="table-actions"><button class="button button-secondary button-small" data-owner-order-inspect='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Lihat</button><% if(row.status==='PAID'){ %><button class="button button-secondary button-small" data-owner-order-status="<%= row.id %>" data-status="PROCESSING">Proses</button><% } else if(row.status==='PROCESSING'){ %><button class="button button-success button-small" data-owner-order-status="<%= row.id %>" data-status="COMPLETED">Selesaikan</button><% } %><% if(row.status==='PENDING'){ %><button class="button button-danger button-small" data-owner-order-status="<%= row.id %>" data-status="CANCELLED">Batalkan</button><% } %></div></td><% } %></tr><% }) %></tbody></table></div>
<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination transaksi'
}) %>
</div>
      <% } else if(ownerSection==='tickets'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Ticket</th><th>User</th><th>Subject</th><th>Status</th><th>Created</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="6"><div class="empty-state compact"><%- icon('user-headset-outline') %><h3>Belum ada ticket</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.ticket_number %></td><td><%= row.username %></td><td><%= row.subject %></td><td><%= row.status %></td><td><%= formatDate(row.created_at) %></td><td><button class="button button-secondary button-small" data-owner-ticket="<%= row.id %>" data-owner-ticket-number="<%= row.ticket_number %>">Balas / Status</button></td></tr><% }) %></tbody></table></div>
<%- include('../partials/pagination',{
  pagination:ownerPagination,
  param:'page',
  query:req.query,
  label:'Pagination tiket'
}) %>
</div>
      <% } else if(ownerSection==='services'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Layanan</th><th>Kategori</th><th>Harga</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="5"><div class="empty-state compact"><%- icon('layanan') %><h3>Belum ada layanan</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small class="muted block"><%= row.description||'—' %></small></td><td><%= row.category||'—' %></td><td><%= formatIDR(row.price) %></td><td><%= row.is_active?labelStatus('ACTIVE'):labelStatus('INACTIVE') %></td><td><button class="button button-secondary button-small" data-owner-edit-service='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='faq'){ %>
