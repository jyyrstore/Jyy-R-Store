<script nonce="<%= cspNonce %>">window.__OWNER_CATEGORIES=<%- JSON.stringify(typeof categories !== "undefined" ? categories : []) %>;</script>
<section class="page-shell owner-page">
  <div class="owner-layout">
    <%- include('../partials/owner-sidebar') %>
    <div class="owner-content">
      <div class="page-header">
        <div><div class="eyebrow">Owner</div><h1><%= ownerSection==='dashboard'?'Ringkasan':ownerSection.replace(/(^|-)/g,m=>m.toUpperCase()).replace(/-/g,' ') %></h1><p>Semua aksi sensitif tetap diverifikasi server-side dan dicatat ke activity log.</p></div>
        <% if(['products','categories','services','faq','information','notifications'].includes(ownerSection)){ %>
          <button class="button button-primary" data-owner-create="<%= ownerSection %>"><%- icon('plus') %> Tambah</button>
        <% } %>
      </div>

      <% if(ownerSection==='dashboard'){ %>
        <div class="stat-grid">
          <div class="stat-card"><span>Total Pengguna</span><strong><%= dashboard.users %></strong></div>
          <div class="stat-card"><span>Total Pesanan</span><strong><%= dashboard.orders %></strong></div>
          <div class="stat-card"><span>Total Pendapatan</span><strong><%= formatIDR(dashboard.revenue) %></strong></div>
          <div class="stat-card"><span>Total Deposit</span><strong><%= formatIDR(dashboard.deposit) %></strong></div>
          <div class="stat-card"><span>Total Produk</span><strong><%= dashboard.products %></strong></div>
          <div class="stat-card"><span>Tiket Aktif</span><strong><%= dashboard.tickets %></strong></div>
        </div>
        <div class="chart-grid">
          <div class="panel"><div class="section-header"><div><h2>Pendapatan & Pesanan</h2><p class="muted">Data berasal dari analytics service/database.</p></div><select data-owner-period><option value="today">Hari Ini</option><option value="7d">7 Hari</option><option value="30d" selected>30 Hari</option><option value="90d">3 Months</option><option value="180d">6 Months</option><option value="1y">1 Tahun</option><option value="custom">Kustom</option></select></div><div class="inline-actions analytics-custom" data-analytics-custom hidden><input type="date" data-analytics-from aria-label="Tanggal mulai analytics"><input type="date" data-analytics-to aria-label="Tanggal akhir analytics"><button class="button button-secondary" type="button" data-analytics-apply>Terapkan</button></div><div class="chart-wrap"><canvas id="owner-chart" height="260"></canvas></div></div>
          <div class="panel"><div class="section-header"><div><h2>Deposit & Pengguna Baru</h2><p class="muted">Deposit sukses dan pertumbuhan user.</p></div></div><div class="chart-wrap"><canvas id="owner-growth-chart" height="260"></canvas></div></div>
          <div class="panel"><h2>Status Pesanan</h2><div class="status-bars"><% (analytics.status||[]).forEach(s=>{ const max=Math.max(...(analytics.status||[]).map(x=>Number(x.count)||0),1); %><div><div class="bar-label"><span><%= s.status %></span><b><%= s.count %></b></div><div class="bar"><span style="width:<%= Math.min(100,Number(s.count)/max*100) %>%"></span></div></div><% }) %></div></div>
        </div>
      <% } else if(ownerSection==='products'){ %>
        <div class="toolbar panel"><form class="filter-bar" method="get"><input name="search" value="<%= req.query.search||'' %>" placeholder="Cari nama/slug"><select name="status"><option value="">Semua status</option><option value="DRAFT" <%= req.query.status==='DRAFT'?'selected':'' %>>Draft</option><option value="PUBLISHED" <%= req.query.status==='PUBLISHED'?'selected':'' %>>Tersedia</option><option value="ARCHIVED" <%= req.query.status==='ARCHIVED'?'selected':'' %>>Diarsipkan</option></select><button class="button button-secondary">Filter</button></form></div>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Produk</th><th>Kategori</th><th>Harga</th><th>Stock</th><th>Content</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
          <% if(!items?.length){ %><tr><td colspan="7"><div class="empty-state compact"><%- icon('package') %><h3>Belum ada produk</h3><p>Buat produk, lengkapi content, lalu publish saat semuanya siap.</p></div></td></tr><% } %>
          <% (items||[]).forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small class="muted block">/<%= row.slug %></small></td><td><%= row.category_name||'—' %></td><td><%= formatIDR(row.price) %></td><td><%= row.stock %></td><td><span class="status-badge"><%= row.content_count||0 %></span></td><td><span class="status-badge status-<%= String(row.status).toLowerCase() %>"><%= labelStatus(row.status) %></span></td><td><div class="table-actions"><button class="button button-secondary button-small" data-owner-edit-product='<%- JSON.stringify({...row,thumbnail_url:row.thumbnail_path?assetUrl(publicAssetBucket,row.thumbnail_path):null}).replace(/'/g,"&#39;") %>'>Edit</button><button class="button button-secondary button-small"
  data-owner-content="<%= row.id %>"
  data-owner-product-name="<%- row.name.replace(/"/g,'&quot;') %>"
  data-owner-product-status="<%= row.status %>"
  data-owner-has-thumbnail="<%= row.thumbnail_path ? '1' : '0' %>">Konten & Publikasi</button><% if(row.status==='PUBLISHED'){ %><button class="button button-secondary button-small" data-owner-unpublish="<%= row.id %>">Batalkan Publikasi</button><% } else if(row.status!=='ARCHIVED'){ %><button class="button button-success button-small" data-owner-publish="<%= row.id %>">Publikasikan</button><% } %><button class="button button-secondary button-small" data-owner-duplicate="<%= row.id %>">Duplikat</button><button class="button button-danger button-small" data-owner-delete-product="<%= row.id %>">Hapus</button></div></td></tr><% }) %>
        </tbody></table></div></div>
      <% } else if(ownerSection==='roles'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Code</th><th>Name</th><th>Permissions</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td><%= row.code %></td><td><%= row.name %></td><td><%= JSON.stringify(row.permissions||{}) %></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='messages'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>User</th><th>Sender</th><th>Message</th><th>Created</th><th>Action</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="5"><div class="empty-state compact"><%- icon('message') %><h3>Belum ada pesan</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.user_username %></td><td><%= row.sender_username %></td><td><%= row.body %></td><td><%= formatDate(row.created_at) %></td><td><button class="button button-secondary button-small" data-owner-message="<%= row.user_id %>">Balas</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='categories'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Name</th><th>Slug</th><th>Active</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="4"><div class="empty-state compact"><%- icon('layers') %><h3>Belum ada kategori</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.name %></td><td><%= row.slug %></td><td><%= row.is_active?'Aktif':'Nonaktif' %></td><td><button class="button button-secondary button-small" data-owner-edit-category='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='users'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Balance</th><th>Orders</th><th>Registered</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="7"><div class="empty-state compact"><%- icon('user') %><h3>Belum ada user</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><strong><%= row.username %></strong><small class="muted block"><%= row.email %></small></td><td><%= row.role %></td><td><span class="status-badge status-<%= String(row.status).toLowerCase() %>"><%= labelStatus(row.status) %></span></td><td><%= formatIDR(row.balance) %></td><td><%= row.orders %></td><td><%= formatDate(row.created_at) %></td><td><div class="table-actions"><button class="button button-secondary button-small" data-owner-user="<%= row.id %>" data-owner-username="<%= row.username %>" data-owner-role="<%= row.role %>" data-owner-status="<%= row.status %>">Kelola</button></div></td></tr><% }) %></tbody></table></div></div>
      <% } else if(['orders','payments','deposits'].includes(ownerSection)){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><% const keys=dataKeys(ownerSection); keys.forEach(k=>{ %><th><%= k.replace(/_/g,' ') %></th><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><th>Created</th><% } %><% if(ownerSection==='orders'){ %><th>Aksi</th><% } %></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="<%= keys.length+((ownerSection==='payments'||ownerSection==='deposits')?1:0)+((ownerSection==='orders')?1:0) %>"><div class="empty-state compact"><%- icon('inbox') %><h3>Belum ada data</h3><p>Coba ubah filter atau rentang data.</p></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><% keys.forEach(k=>{ %><td><%= formatCell(row,k) %></td><% }) %><% if(ownerSection==='payments'||ownerSection==='deposits'){ %><td><%= formatDate(row.created_at) %></td><% } %><% if(ownerSection==='orders'){ %><td><div class="table-actions"><button class="button button-secondary button-small" data-owner-order-inspect='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Lihat</button><% if(row.status==='PAID'){ %><button class="button button-secondary button-small" data-owner-order-status="<%= row.id %>" data-status="PROCESSING">Proses</button><% } else if(row.status==='PROCESSING'){ %><button class="button button-success button-small" data-owner-order-status="<%= row.id %>" data-status="COMPLETED">Selesaikan</button><% } %><% if(row.status==='PENDING'){ %><button class="button button-danger button-small" data-owner-order-status="<%= row.id %>" data-status="CANCELLED">Batalkan</button><% } %></div></td><% } %></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='tickets'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Ticket</th><th>User</th><th>Subject</th><th>Status</th><th>Created</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="6"><div class="empty-state compact"><%- icon('ticket') %><h3>Belum ada ticket</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.ticket_number %></td><td><%= row.username %></td><td><%= row.subject %></td><td><%= row.status %></td><td><%= formatDate(row.created_at) %></td><td><button class="button button-secondary button-small" data-owner-ticket="<%= row.id %>" data-owner-ticket-number="<%= row.ticket_number %>">Balas / Status</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='services'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Layanan</th><th>Kategori</th><th>Harga</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="5"><div class="empty-state compact"><%- icon('settings') %><h3>Belum ada layanan</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small class="muted block"><%= row.description||'—' %></small></td><td><%= row.category||'—' %></td><td><%= formatIDR(row.price) %></td><td><%= row.is_active?labelStatus('ACTIVE'):labelStatus('INACTIVE') %></td><td><button class="button button-secondary button-small" data-owner-edit-service='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='faq'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Kategori</th><th>Question</th><th>Tersedia</th><th>Aksi</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td><%= row.category %></td><td><%= row.question %></td><td><%= row.is_published?'Ya':'Tidak' %></td><td><button class="button button-secondary button-small" data-owner-edit-faq='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='information'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Type</th><th>Title</th><th>Tersedia</th><th>Publish At</th><th>Aksi</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td><%= row.type %></td><td><%= row.title %></td><td><%= row.is_published?'Ya':'Tidak' %></td><td><%= formatDate(row.publish_at) %></td><td><button class="button button-secondary button-small" data-owner-edit-info='<%- JSON.stringify(row).replace(/'/g,"&#39;") %>'>Edit</button></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='notifications'){ %>
        <div class="panel stack-form"><h2>Buat Notifikasi</h2><form data-owner-notification-create><div class="form-grid"><label class="field"><span>Type</span><select name="type"><option>SYSTEM</option><option>PROMOTION</option><option>ORDER</option><option>PAYMENT</option><option>DEPOSIT</option><option>TICKET</option></select></label><label class="field"><span>User ID (opsional)</span><input name="user_id" placeholder="Kosong = broadcast"></label><label class="field"><span>Title</span><input name="title" required maxlength="160"></label></div><label class="field"><span>Body</span><textarea name="body" maxlength="5000" required></textarea></label><label class="field"><span>Link</span><input name="link"></label><div class="inline-actions"><button class="button button-primary">Kirim</button><button class="button button-secondary" type="button" data-owner-broadcast>Kirim ke Semua</button></div></form></div>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Type</th><th>Title</th><th>User</th><th>Read</th><th>Created</th></tr></thead><tbody><% (items||[]).forEach(row=>{ %><tr><td><%= row.type %></td><td><%= row.title %></td><td><%= row.user_id||'ALL' %></td><td><%= row.is_read?'Ya':'Belum' %></td><td><%= formatDate(row.created_at) %></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='maintenance'){ %>
        <form class="panel stack-form" data-owner-maintenance><div class="panel subdued"><strong>Preview</strong><p class="muted"><%= maintenance?.title||"Maintenance Jyy'R Store" %></p><small class="muted"><%= maintenance?.message||'Saat aktif, user akan melihat halaman maintenance. Webhook dan backend kritis tetap bekerja.' %></small></div><label class="switch-row"><span>Maintenance ON</span><input type="checkbox" name="enabled" <%= maintenance?.enabled?'checked':'' %>></label><label class="field"><span>Title</span><input name="title" value="<%= maintenance?.title||'' %>" required></label><label class="field"><span>Message</span><textarea name="message"><%= maintenance?.message||'' %></textarea></label><label class="field"><span>Scheduled Start</span><input type="datetime-local" name="scheduled_start" value="<%= maintenance?.scheduled_start?new Date(maintenance.scheduled_start).toISOString().slice(0,16):'' %>"></label><label class="field"><span>Scheduled End</span><input type="datetime-local" name="scheduled_end" value="<%= maintenance?.scheduled_end?new Date(maintenance.scheduled_end).toISOString().slice(0,16):'' %>"></label><label class="switch-row"><span>Allow Owner Access</span><input type="checkbox" name="allow_owner_access" <%= maintenance?.allow_owner_access?'checked':'' %>></label><button class="button button-primary">Simpan maintenance</button></form>
      <% } else if(ownerSection==='storage'){ %>
        <div class="stat-grid"><div class="stat-card"><span>Public Assets</span><strong class="small-value"><%= storage?.publicBucket||'—' %></strong></div><div class="stat-card"><span>Private Products</span><strong class="small-value"><%= storage?.privateBucket||'—' %></strong></div><div class="stat-card"><span>User Uploads</span><strong class="small-value"><%= storage?.userBucket||'—' %></strong></div></div><div class="panel"><h2>Storage Security</h2><p class="muted">Premium content tetap private dan diakses melalui authorization server-side + signed URL.</p></div>
      <% } else if(ownerSection==='system'){ %>
        <div class="stat-grid"><div class="stat-card"><span>Runtime</span><strong><%= system?.node||'—' %></strong></div><div class="stat-card"><span>Lingkungan</span><strong><%= system?.environment||'—' %></strong></div><div class="stat-card"><span>Uptime</span><strong><%= system?.uptime?Math.round(system.uptime)+'s':'—' %></strong></div></div><div class="panel"><h2>Konfigurasi</h2><p class="muted"><%= system?.configured?'Konfigurasi dapat dibaca oleh server.':'Konfigurasi belum lengkap.' %></p></div>
      <% } else if(ownerSection==='settings'){ %>
        <div class="panel"><div class="section-header"><div><h2>Settings</h2><p class="muted">Secret payment/email/session tidak disimpan melalui halaman ini.</p></div></div><div class="settings-grid"><% const groups={'General':[],'Brand':[],'Store':[],'Payment':[],'Authentication':[],'Storage':[],'Email':[],'Notifications':[],'Maintenance':[],'Social Media':[],'System':[]}; (items||[]).forEach(s=>{const key=groups[s.category]?s.category:'System';groups[key].push(s)}); Object.entries(groups).forEach(([group,rows])=>{if(!rows.length)return;%><section class="settings-group"><h3><%= group %></h3><% rows.forEach(s=>{ %><div class="setting-row"><div><strong><%= s.key %></strong><small class="muted"><%= JSON.stringify(s.value_json) %></small></div><span class="status-badge"><%= s.is_public?'PUBLIC':'SERVER' %></span></div><% }) %></section><% }) %></div></div>
      <% } else if(ownerSection==='activity'||ownerSection==='security'||ownerSection==='login-history'||ownerSection==='reports'){ %>
        <% if(ownerSection==='reports'){ %><div class="chart-grid"><div class="panel"><div class="chart-wrap"><canvas id="report-chart" height="280"></canvas></div></div><div class="panel"><h2>Ringkasan</h2><div class="list-stack"><div class="list-card"><span>Orders</span><b><%= analytics.summary?.orders||analytics.orders||0 %></b></div><div class="list-card"><span>Revenue</span><b><%= formatIDR(analytics.summary?.revenue||0) %></b></div><div class="list-card"><span>Deposit</span><b><%= formatIDR(analytics.summary?.deposit||0) %></b></div></div></div></div><% } else { const rows=ownerSection==='activity'?(items||[]):(logins||[]); %><div class="panel table-panel"><div class="table-scroll"><table><thead><tr><% const keys=ownerSection==='activity'?['action','entity_type','entity_id','created_at','masked_ip']:['user_id','status','device','browser','masked_ip','created_at']; keys.forEach(k=>{ %><th><%= k.replace(/_/g,' ') %></th><% }) %></tr></thead><tbody><% rows.forEach(row=>{ %><tr><% keys.forEach(k=>{ %><td><%= formatCell(row,k) %></td><% }) %></tr><% }) %></tbody></table></div></div><% } %>
      <% } else if(ownerSection==='top-orders'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Rank</th><th>Product</th><th>Purchases</th><th>Revenue Activity</th><th>Views</th><th>Cart Adds</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="6"><div class="empty-state compact"><%- icon('package') %><h3>Belum ada data top order</h3></div></td></tr><% } %><% (items||[]).forEach((row,i)=>{ %><tr><td><strong>#<%= i+1 %></strong></td><td><%= row.name %></td><td><%= row.purchase_count||0 %></td><td><%= formatIDR(Number(row.price||0)*Number(row.purchase_count||0)) %></td><td><%= row.view_count||0 %></td><td><%= row.cart_add_count||0 %></td></tr><% }) %></tbody></table></div></div>
      <% } else if(ownerSection==='refunds'){ %>
        <div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Order</th><th>User</th><th>Amount</th><th>Status</th><th>Created</th><th>Aksi</th></tr></thead><tbody><% if(!items?.length){ %><tr><td colspan="6"><div class="empty-state compact"><%- icon('credit-card') %><h3>Belum ada refund</h3></div></td></tr><% } %><% (items||[]).forEach(row=>{ %><tr><td><%= row.order_number||row.order_id %></td><td><%= row.username||row.user_id %></td><td><%= formatIDR(row.amount) %></td><td><%= row.status %></td><td><%= formatDate(row.created_at) %></td><td><% if(row.status==='PENDING'){ %><button class="button button-primary button-small" data-owner-refund-order="<%= row.order_id %>">Proses</button><% } %></td></tr><% }) %></tbody></table></div></div>
      <% } %>
    </div>
  </div>
</section>

<% if(ownerSection==='dashboard' || ownerSection==='reports'){ %>
<script nonce="<%= cspNonce %>">
document.addEventListener('DOMContentLoaded',()=>{let charts={};const daily0=<%- JSON.stringify((analytics&&analytics.daily)||[]) %>;const render=(daily,status)=>{if(!window.Chart)return;const mk=(id,type,data)=>{const c=document.getElementById(id);if(!c)return;if(charts[id])charts[id].destroy();charts[id]=new Chart(c,{type,data,options:{responsive:true,maintainAspectRatio:false}})};mk('owner-chart','line',{labels:daily.map(x=>x.day),datasets:[{label:'Revenue',data:daily.map(x=>Number(x.revenue))},{label:'Orders',data:daily.map(x=>Number(x.orders))}]});mk('owner-growth-chart','line',{labels:daily.map(x=>x.day),datasets:[{label:'Deposit',data:daily.map(x=>Number(x.deposit||0))},{label:'New Users',data:daily.map(x=>Number(x.new_users||0))}]});mk('report-chart','bar',{labels:daily.map(x=>x.day),datasets:[{label:'Revenue',data:daily.map(x=>Number(x.revenue))},{label:'Deposit',data:daily.map(x=>Number(x.deposit||0))}]});};render(daily0,<%- JSON.stringify((analytics&&analytics.status)||[]) %>);const period=document.querySelector('[data-owner-period]');const custom=document.querySelector('[data-analytics-custom]');const from=document.querySelector('[data-analytics-from]');const to=document.querySelector('[data-analytics-to]');const apply=async()=>{const p=period?.value||'30d';const url=new URL('/api/owner/analytics',location.origin);url.searchParams.set('period',p);if(p==='custom'){if(!from?.value||!to?.value)return window.JYYRToast?.error('Pilih rentang tanggal analytics.');url.searchParams.set('from',from.value+'T00:00:00');url.searchParams.set('to',to.value+'T23:59:59')}try{const r=await window.JYYRApi.request(url.pathname+url.search);render(r.daily||[],r.status||[])}catch(err){window.JYYRToast?.error(err.message)}};period?.addEventListener('change',()=>{if(custom)custom.hidden=period.value!=='custom';if(period.value!=='custom')apply()});document.querySelector('[data-analytics-apply]')?.addEventListener('click',apply)});
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% } %>

<% function dataKeys(s){ const map={orders:['order_number','username','total','status'],payments:['reference','order_number','username','amount','status'],deposits:['reference','username','amount','status']}; return map[s]||['id']; } function formatCell(row,k){ let v=row[k]; if(k==='price'||k==='amount'||k==='balance'||k==='total'||k==='revenue') return formatIDR(v); if(k==='status') return labelStatus(v); if(k==='created_at') return formatDate(v); if(typeof v==='object'&&v) return JSON.stringify(v); return v??'—'; } %>
