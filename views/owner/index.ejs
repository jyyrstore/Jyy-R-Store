                    aria-selected="<%= !req.query.status ? 'true' : 'false' %>"
                    data-owner-filter-option=""
                  >
                    <span>Semua status</span>
                  </button>

                  <button
                    type="button"
                    class="owner-filter-option <%= req.query.status==='DRAFT'?'active':'' %>"
                    role="option"
                    aria-selected="<%= req.query.status==='DRAFT' ? 'true' : 'false' %>"
                    data-owner-filter-option="DRAFT"
