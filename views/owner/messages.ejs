<section class="page-shell messages-page owner-messages-page">
  <div class="messages-shell">

    <header class="messages-header">
      <div class="messages-header-title">
        <div class="eyebrow">Owner</div>
        <h1>Pesan</h1>
        <p>Kelola percakapan pengguna dalam satu ruang.</p>
      </div>
    </header>

    <section class="messages-panel" aria-label="Percakapan pengguna">

      <div class="messages-panel-top">

        <div class="messages-panel-heading">
          <div>
            <h2>Percakapan</h2>
            <span>
              <%= messages.length %>
              <%= messages.length===1 ? 'percakapan' : 'percakapan' %>
            </span>
          </div>
        </div>

        <label class="messages-search" aria-label="Cari percakapan">
          <%- icon('search', 'messages-search-icon') %>
          <input
            type="search"
            data-message-search
            placeholder="Cari pengguna atau pesan..."
            autocomplete="off"
          >
        </label>

      </div>

      <div class="messages-filter-row">

        <button
          class="messages-filter active"
          type="button"
        >
          Semua
        </button>

        <span class="messages-filter-info">
          <%- icon('message') %>
          Kotak pesan Jyyr Store
        </span>

      </div>

      <div class="message-chat-list">

        <% if(!messages.length){ %>

          <div class="messages-empty">

            <div class="messages-empty-icon">
              <%- icon('message') %>
            </div>

            <h3>Belum ada percakapan</h3>

            <p>
              Pesan dari pengguna akan muncul di sini.
            </p>

          </div>

        <% } else { %>

          <% messages.forEach(m=>{ %>

            <%
              const mine=m.sender_id===currentUser.id;

              const participantName=
                String(
                  m.user_display_name||
                  m.user_username||
                  'Pengguna'
                ).trim()||'Pengguna';

              const preview=
                String(m.body||'')
                  .replace(/\s+/g,' ')
                  .trim();

              const initial=
                participantName
                  .slice(0,1)
                  .toUpperCase()||'P';
            %>

            <a
              class="message-chat-row"
              href="/owner/messages/<%= m.id %>"
              data-message-row
              data-message-search-text="<%= participantName+' '+preview %>"
            >

              <span class="message-chat-avatar is-user">
                <%= initial %>
              </span>

              <span class="message-chat-main">

                <span class="message-chat-topline">

                  <span class="message-chat-name">

                    <strong>
                      <%= participantName %>
                    </strong>

                    <span class="message-chat-role">
                      User
                    </span>

                  </span>

                  <time>
                    <%= formatDate(m.created_at) %>
                  </time>

                </span>

                <span class="message-chat-bottomline">

                  <span class="message-chat-preview">

                    <% if(mine){ %>
                      <span class="message-chat-you">
                        Anda:
                      </span>
                    <% } %>

                    <%= preview||'Pesan kosong' %>

                  </span>

                  <% if(mine){ %>
                    <span
                      class="message-chat-status"
                      title="Pesan terkirim"
                      aria-label="Pesan terkirim"
                    >
                      <%- icon('check') %>
                    </span>
                  <% } else { %>
                    <span
                      class="message-chat-open"
                      aria-hidden="true"
                    >
                      <%- icon('chevron-right') %>
                    </span>
                  <% } %>

                </span>

              </span>

            </a>

          <% }) %>

          <div
            class="messages-search-empty"
            data-message-search-empty
            hidden
          >
            <%- icon('search-off') %>
            <strong>Percakapan tidak ditemukan</strong>
            <span>Coba kata kunci lain.</span>
          </div>

        <% } %>

      </div>

    </section>

    <%- include('../partials/pagination',{
      pagination:messagesPagination,
      param:'page',
      query:req.query,
      label:'Pagination percakapan owner'
    }) %>

  </div>
</section>
