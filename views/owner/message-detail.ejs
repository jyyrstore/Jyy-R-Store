<section class="page-shell message-detail-page owner-message-detail-page">

  <div class="message-detail-shell">

    <section class="message-detail-card">

      <header class="message-detail-header">

        <a
          class="message-detail-back"
          href="/owner/messages"
          aria-label="Kembali ke pesan"
          title="Kembali"
        >
          <%- icon('arrow-back-up') %>
        </a>

        <%
          const participantName=
            message.user_display_name||
            message.user_username||
            'Pengguna';

          const participantInitial=
            String(participantName)
              .trim()
              .slice(0,1)
              .toUpperCase()||'P';
        %>

        <div class="message-detail-avatar" aria-hidden="true">
          <strong><%= participantInitial %></strong>
        </div>

        <div class="message-detail-user">

          <strong>
            <%= participantName %>
          </strong>

          <span>
            Pengguna Jyyr Store
          </span>

        </div>

      </header>

      <div class="message-detail-body">

        <% (messages||[]).forEach(chatMessage=>{ %>

          <%
            const isMine=
              chatMessage.sender_id===currentUser.id;
          %>

          <article
            class="message-bubble <%= isMine ? 'is-mine' : 'is-theirs' %>"
          >

            <div class="message-bubble-text">
              <%= String(chatMessage.body||'').trim() %>
            </div>

            <div class="message-bubble-meta">

              <time>
                <%= formatDate(chatMessage.created_at) %>
              </time>

              <% if(isMine){ %>

                <span
                  class="message-bubble-status"
                  aria-label="Terkirim"
                  title="Terkirim"
                >
                  <%- icon('check') %>
                </span>

              <% } %>

            </div>

          </article>

        <% }) %>

      </div>

      <footer class="message-detail-composer">

        <form
          class="message-detail-form"
          data-owner-message-form
          data-owner-message-detail="1"
        >

          <input
            type="hidden"
            name="user_id"
            value="<%= message.user_id %>"
          >

          <label
            class="message-detail-input"
            aria-label="Balas pesan"
          >

            <textarea
              name="body"
              rows="1"
              maxlength="10000"
              required
              aria-label="Balas pesan"
              placeholder="Ketik balasan..."
            ></textarea>

          </label>

          <button
            class="message-detail-send"
            type="submit"
            aria-label="Kirim balasan"
            title="Kirim balasan"
          >
            <%- icon('send') %>
            <span>Kirim</span>
          </button>

        </form>

      </footer>

    </section>

  </div>

</section>
