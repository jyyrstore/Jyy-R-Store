<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Wallet</div><h1>Deposit / Saldo</h1></div></div><div class="stat-card featured"><span>Saldo saat ini</span><strong><%= formatIDR(wallet.balance) %></strong></div><div class="section"><h2>Pilih nominal</h2><div class="amount-grid"><% [10000,25000,50000,100000].forEach(v=>{ %><button class="amount-button" data-deposit-amount="<%= v %>"><%= formatIDR(v) %></button><% }) %><label class="field amount-custom"><span>Custom</span><input id="deposit-custom" inputmode="numeric" type="number" min="1000" placeholder="Rp"></label></div><button class="button button-primary" data-deposit-submit><%- icon('wallet') %> Buat transaksi deposit</button><p class="muted small">Provider payment belum dapat diaktifkan sampai owner mengisi credential gateway resmi.</p></div><div class="section"><div class="section-header"><h2>Riwayat deposit</h2></div><div class="stack-list"><% deposits.forEach(d=>{ %><div class="list-card"><div><strong><%= d.reference||d.id.slice(0,8) %></strong><span><%= formatDate(d.created_at) %></span></div><div class="align-right"><b><%= formatIDR(d.amount) %></b><span class="badge"><%= d.status %></span></div></div><% }) %><% if(!deposits.length){ %><%- include('../partials/empty',{title:'Belum ada deposit',description:'Transaksi deposit akan tampil di sini.'}) %><% } %></div></div></section>
