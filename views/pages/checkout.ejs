<% const recipient=preview.recipientContact||null; %>
<% const recipientComplete=Boolean(
  recipient?.email&&
  recipient?.countryCode&&
  recipient?.dialCode&&
  recipient?.phone
); %>
<section class="page-shell">
  <div class="page-header">
    <div>
      <div class="eyebrow">Checkout</div>
      <h1>Konfirmasi pembelian</h1>
      <p>Periksa item, saldo, dan metode pembayaran sebelum melanjutkan.</p>
    </div>
  </div>

  <div class="checkout-layout">
    <div class="stack-list">
      <div class="section-header">
        <div>
          <div class="eyebrow">Ringkasan</div>
          <h2>Item pesanan</h2>
        </div>
      </div>

      <% if(preview.items.length){ %>
        <% preview.items.forEach(i=>{ %>
          <div class="list-card">
            <div>
              <strong><%= i.name %></strong>
              <span><%= i.quantity %> × <%= formatIDR(i.price) %></span>
            </div>

            <div class="checkout-item-actions">
              <% if(!preview.directBuyNow){ %>
                <button
                  class="button button-secondary checkout-item-remove"
                  type="button"
                  data-checkout-remove="<%= i.id %>"
                  aria-label="Hapus <%= i.name %> dari keranjang"
                  title="Hapus item"
                >
                  <%- icon('trash') %>
                </button>
              <% } %>

              <b><%= formatIDR(i.lineTotal) %></b>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <%- include('../partials/empty',{
          title:'Tidak ada item',
          description:'Keranjang kosong. Tambahkan produk sebelum checkout.',
          actionUrl:'/store',
          actionLabel:'Buka Store'
        }) %>
      <% } %>
    </div>

    <aside class="summary-card">
      <div class="eyebrow">Kontak Penerima</div>

      <% if(recipientComplete){ %>
        <div class="recipient-checkout-summary">
          <div class="summary-row">
            <span>Email</span>
            <strong><%= recipient.email %></strong>
          </div>
          <div class="summary-row">
            <span>WhatsApp</span>
            <strong><%= recipient.dialCode %><%= recipient.phone %></strong>
          </div>
          <a class="button button-secondary button-block" href="/cart">
            Ubah kontak
          </a>
        </div>
      <% } else { %>
        <div class="recipient-checkout-summary recipient-checkout-summary--warning">
          <strong>Kontak penerima belum lengkap.</strong>
          <span>
            Lengkapi email dan WhatsApp di Keranjang sebelum membayar.
          </span>
          <a class="button button-secondary button-block" href="/cart">
            Lengkapi kontak di Keranjang
          </a>
        </div>
      <% } %>

      <hr>

      <div class="eyebrow">Pembayaran</div>


      <div class="summary-row">
        <span>Subtotal</span>
        <b><%= formatIDR(preview.subtotal) %></b>
      </div>

      <fieldset class="payment-group">
        <legend>Metode pembayaran</legend>

        <div class="payment-options">
          <label class="payment-option <%= selectedPaymentMethod==='BALANCE' ? 'is-selected' : '' %> <%= walletSufficient ? '' : 'is-unavailable' %>">
            <input
              type="radio"
              name="paymentMethod"
              value="BALANCE"
              <%= selectedPaymentMethod==='BALANCE' ? 'checked' : '' %>
              <%= walletSufficient ? '' : 'disabled' %>
            >
            <span class="payment-option__copy">
              <strong>Saldo Wallet</strong>
              <small>
                <% if(walletSufficient){ %>
                  Saldo tersedia <%= formatIDR(wallet.balance) %>
                <% } else { %>
                  Saldo <%= formatIDR(wallet.balance) %> · kurang <%= formatIDR(Number(preview.total)-Number(wallet.balance)) %>
                <% } %>
              </small>

              <% if(!walletSufficient){ %>
                <a class="checkout-balance-help" href="/deposit">
                  Isi saldo Wallet
                </a>
              <% } %>
            </span>
          </label>

          <label class="payment-option <%= selectedPaymentMethod==='GATEWAY' ? 'is-selected' : '' %>">
            <input
              type="radio"
              name="paymentMethod"
              value="GATEWAY"
              <%= selectedPaymentMethod==='GATEWAY' ? 'checked' : '' %>
            >
            <span class="payment-option__copy">
              <strong>Pembayaran online</strong>
              <small>Bayar melalui metode online yang tersedia.</small>
            </span>
          </label>
        </div>

      </fieldset>

      <hr>

      <div class="summary-row total">
        <span>Total</span>
        <strong><%= formatIDR(preview.total) %></strong>
      </div>

      <% if(!preview.items.length || !recipientComplete){ %>
        <div class="checkout-action-hint" role="status">
          <%- icon('alert-triangle') %>
          <span>
            <% if(!preview.items.length){ %>
              Tidak ada item yang dapat dibayar.
            <% }else{ %>
              Tombol Bayar belum aktif. Lengkapi email dan WhatsApp penerima terlebih dahulu.
            <% } %>
          </span>
        </div>
      <% } %>

      <button
        class="button button-primary button-block"
        data-checkout-confirm
        data-buy-now-product="<%= preview.buyNowProductId||'' %>"
        <%= preview.items.length && recipientComplete ? '' : 'disabled' %>
      >
        <%- icon('check') %>
        <span
          data-checkout-label
          data-balance-label="Bayar <%= formatIDR(preview.total) %>"
        ><%= selectedPaymentMethod==='BALANCE'
          ? `Bayar ${formatIDR(preview.total)}`
          : 'Lanjut ke Pembayaran' %></span>
      </button>

      <p class="muted small">
        Untuk gateway, status akhir berasal dari verifikasi server dan webhook provider.
      </p>
    </aside>
  </div>
</section>
