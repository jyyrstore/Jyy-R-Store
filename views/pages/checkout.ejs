<section class="page-shell">
  <div class="page-header">
    <div><div class="eyebrow">Checkout</div><h1>Konfirmasi pembelian</h1><p>Pastikan item dan metode pembayaran sudah sesuai sebelum konfirmasi.</p></div>
  </div>

  <div class="checkout-layout">
    <div class="stack-list">
      <div class="section-header"><div><div class="eyebrow">Review</div><h2>Item pesanan</h2></div></div>

      <% preview.items.forEach(i=>{ %>
        <div class="list-card">
          <div><strong><%= i.name %></strong><span><%= i.quantity %> × <%= formatIDR(i.price) %></span></div>
          <b><%= formatIDR(i.lineTotal) %></b>
        </div>
      <% }) %>
    </div>

    <aside class="summary-card">
      <div class="eyebrow">Payment</div>
      <div class="summary-row"><span>Subtotal</span><b><%= preview.total %></b></div>

      <label class="field">
        <span>Metode pembayaran</span>
        <select id="payment-method">
          <option value="BALANCE" <%= selectedPaymentMethod==='BALANCE'?'selected':'' %>>Saldo Wallet</option>
          <option value="GATEWAY" <%= selectedPaymentMethod==='GATEWAY'?'selected':'' %>>Payment Gateway</option>
        </select>
      </label>

      <hr>

      <div class="summary-row total"><span>Total</span><strong><%= preview.total %></strong></div>

      <button class="button button-primary button-block" data-checkout-confirm>
        <%- icon('check') %> Konfirmasi & Bayar
      </button>

      <p class="muted small">Untuk gateway, status akhir berasal dari verifikasi server dan webhook provider.</p>
    </aside>
  </div>
</section>
