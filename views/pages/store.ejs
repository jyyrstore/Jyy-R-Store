<section class="page-shell">
  <div class="page-header">
    <div>
      <div class="eyebrow">Store</div>
      <h1>Katalog produk</h1>
      <p><%= total %> produk tersedia. Gunakan filter untuk mempersempit pilihan.</p>
    </div>
    <% if (currentUser) { %>
      <a class="button button-secondary" href="/cart" data-cart-link>
        <%- icon('cart') %>
        <span>Keranjang</span>
        <span class="cart-count" data-cart-badge hidden></span>
      </a>
    <% } %>
  </div>

  <%
    const activeFilters = [
      String(req.query.search||'').trim(),
      String(req.query.category||'').trim(),
      String(req.query.minPrice||'').trim(),
      String(req.query.maxPrice||'').trim(),
      String(req.query.sort||'').trim() && req.query.sort !== 'newest' ? req.query.sort : ''
    ].filter(Boolean);
    const activeFilterCount = activeFilters.length;
  %>

  <form class="filter-bar" method="get" action="/store">
    <label class="field-inline filter-search">
      <input
        name="search"
        value="<%= req.query.search||'' %>"
        type="search"
        placeholder="Cari produk..."
        aria-label="Cari produk"
      >
    </label>

    <div class="jyyr-select filter-category" data-jyyr-select>
  <input
    type="hidden"
    class="filter-category-value"
    name="category"
    value="<%= req.query.category||'' %>"
    data-jyyr-select-value
  >
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Semua kategori</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
      <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Semua kategori">Semua kategori</button>
      <% categories.forEach(c=>{ %>
        <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="<%= c.slug %>" data-label="<%= c.name %>"><%= c.name %></button>
      <% }) %>
  </div>
</div>

    <input
      class="filter-min"
      name="minPrice"
      value="<%= req.query.minPrice||'' %>"
      type="number"
      min="0"
      placeholder="Harga min"
      aria-label="Harga minimum"
    >

    <input
      class="filter-max"
      name="maxPrice"
      value="<%= req.query.maxPrice||'' %>"
      type="number"
      min="0"
      placeholder="Harga max"
      aria-label="Harga maksimum"
    >

    <div class="jyyr-select filter-sort" data-jyyr-select>
  <input
    type="hidden"
    class="filter-sort-value"
    name="sort"
    value="<%= req.query.sort||'newest' %>"
    data-jyyr-select-value
  >
  <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
    <span data-jyyr-select-label>Terbaru</span>
    <span class="jyyr-select-chevron" aria-hidden="true"></span>
  </button>
  <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="newest" data-label="Terbaru">Terbaru</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="popular" data-label="Populer">Populer</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="price_asc" data-label="Harga rendah">Harga rendah</button>
    <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="price_desc" data-label="Harga tinggi">Harga tinggi</button>
  </div>
</div>

    <button class="button button-primary button-small filter-submit" type="submit">
      Terapkan Filter
    </button>
  </form>

  <div class="filter-status" aria-live="polite">
    <span>
      <%= activeFilterCount ? `${activeFilterCount} filter aktif` : 'Menampilkan semua produk' %>
    </span>
    <% if(activeFilterCount){ %>
      <a href="/store">Hapus filter</a>
    <% } %>
  </div>

  <% if(items.length){ %>
    <div class="product-grid"><% items.forEach(product=>{ %><%- include('../partials/product-card',{product}) %><% }) %></div>
    <%- include('../partials/pagination',{
  pagination:storePagination,
  param:'page',
  query:{
    search:req.query.search,
    category:req.query.category,
    minPrice:req.query.minPrice,
    maxPrice:req.query.maxPrice,
    sort:req.query.sort
  },
  label:'Pagination produk store'
}) %>
  <% } else { %>
    <%- include('../partials/empty',{title:'Belum ada produk tersedia',description:'Coba kata kunci atau filter lain.',actionUrl:'/store',actionLabel:'Reset Filter'}) %>
  <% } %>
</section>
