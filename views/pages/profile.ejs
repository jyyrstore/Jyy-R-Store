<%
  const formatIdr = value => new Intl.NumberFormat(
    'id-ID',
    {
      style:'currency',
      currency:'IDR',
      maximumFractionDigits:0
    }
  ).format(Number(value || 0));

  const profileName =
    profile.display_name ||
    profile.username ||
    'Pengguna';

  const profileUsername =
    profile.username ||
    'user';

  const profileInitial =
    String(profileName).trim().slice(0,1).toUpperCase() || 'U';
%>

<section class="page-shell profile-page">

  <section
  class="profile-hero panel"
  aria-labelledby="profile-page-title"
>

  <div class="profile-card-head">

    <div class="profile-section-heading">
      <h1 id="profile-page-title">
        Profil
      </h1>
    </div>

    <button
      class="button button-secondary button-small profile-edit-trigger"
      type="button"
      data-profile-edit-open
      aria-haspopup="dialog"
    >
      <%- icon('edit') %>
      <span>Edit profil</span>
    </button>

  </div>

  <div class="profile-identity">

    <div class="profile-avatar" aria-hidden="true">
      <span data-profile-avatar>
        <%= profileInitial %>
      </span>
    </div>

    <div class="profile-identity-copy">

      <h2
        id="profile-identity-title"
        data-profile-display
      >
        <%= profileName %>
      </h2>

      <p
        class="profile-identity-username"
        data-profile-username
        data-profile-detail="username"
      >
        @<%= profileUsername %>
      </p>

      <p
        class="profile-identity-email"
        data-profile-email
        data-profile-detail="email"
      >
        <%= profile.email || 'Tidak tersedia' %>
      </p>

      <p
        class="profile-identity-bio"
        data-profile-detail="bio"
      >
        <%= profile.bio || 'Belum ada bio.' %>
      </p>

      <p
        class="profile-identity-phone"
        data-profile-detail="phone"
      >
        <%= profile.phone || 'Belum ditambahkan' %>
      </p>

    </div>

  </div>

  <div
    class="profile-account-view"
    aria-label="Informasi akun"
    hidden
    aria-hidden="true"
  >

    <section
      class="profile-detail-section"
      aria-labelledby="profile-details-title"
    >

      <div
        class="profile-detail-kicker"
        id="profile-details-title"
      >
        Informasi akun
      </div>

      <dl class="profile-detail-list">

        <div class="profile-detail-row">
          <dt>Username</dt>

          <dd data-profile-detail="username">
            @<%= profile.username || 'user' %>
          </dd>
        </div>

        <div class="profile-detail-row">
          <dt>Nama tampilan</dt>

          <dd data-profile-detail="display_name">
            <%= profile.display_name || 'Belum diatur' %>
          </dd>
        </div>

        <div class="profile-detail-row">
          <dt>Email</dt>

          <dd data-profile-detail="email">
            <%= profile.email || 'Tidak tersedia' %>
          </dd>
        </div>

        <div class="profile-detail-row">
          <dt>Nomor telepon</dt>

          <dd
            class="profile-detail-value-muted"
            data-profile-detail="phone"
          >
            <%= profile.phone || 'Belum ditambahkan' %>
          </dd>
        </div>

        <div class="profile-detail-row profile-detail-row-bio">
          <dt>Bio</dt>

          <dd
            class="profile-detail-value-muted profile-detail-bio"
            data-profile-detail="bio"
          >
            <%= profile.bio || 'Belum ada bio.' %>
          </dd>
        </div>

      </dl>

    </section>

  </div>

  <div
        class="profile-stat-grid"
        aria-label="Ringkasan akun"
      >

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('shield-user-broken') %>
          </div>

          <div>
            <span>Role</span>
            <strong><%= labelStatus(profile.role) %></strong>
          </div>
        </article>

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('check') %>
          </div>

          <div>
            <span>Status</span>
            <strong><%= labelStatus(profile.status) %></strong>
          </div>
        </article>

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('transaction-history') %>
          </div>

          <div>
            <span>Pesanan</span>
            <strong><%= Number(profile.total_orders || 0) %></strong>
          </div>
        </article>

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('wallet') %>
          </div>

          <div>
            <span>Saldo</span>
            <strong><%= formatIdr(profile.balance) %></strong>
          </div>
        </article>

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('wallet-plus') %>
          </div>

          <div>
            <span>Deposit</span>
            <strong><%= formatIdr(profile.total_deposit) %></strong>
          </div>
        </article>

        <article class="profile-stat-card">
          <div class="profile-stat-icon">
            <%- icon('trophy') %>
          </div>

          <div>
            <span>Top</span>
            <strong><%= profile.top_rank ? Number(profile.top_rank) : '—' %></strong>
          </div>
        </article>

      </div>

  <details class="profile-edit-disclosure" hidden>
    <template id="profile-edit-template">

      <div class="profile-edit-modal">

        <div class="profile-edit-modal-head">

          <div class="eyebrow">
            Profil akun
          </div>

          <h2>
            Edit profil
          </h2>

          <p>
            Perbarui informasi utama akun Anda.
          </p>

        </div>

        <form
                id="profile-form"
                class="form-grid profile-form"
              >

                <label class="field">
                  <span>Username</span>

                  <input
                    name="username"
                    value="<%= profile.username || '' %>"
                    autocomplete="username"
                    minlength="3"
                    maxlength="32"
                    spellcheck="false"
                    required
                  />
                </label>

                <label class="field">
                  <span>Nama tampilan</span>

                  <input
                    name="display_name"
                    value="<%= profile.display_name || '' %>"
                    autocomplete="name"
                    maxlength="80"
                  />
                </label>

                <label class="field full">
                  <span>Email</span>

                  <input
                    type="email"
                    value="<%= profile.email || '' %>"
                    readonly
                    aria-readonly="true"
                    autocomplete="email"
                  />

                  <small class="field-help">
                    Email autentikasi dikelola melalui sistem akun dan
                    tidak diubah dari halaman ini.
                  </small>
                </label>

                <label class="field">
                  <span>Nomor telepon</span>

                  <input
                    name="phone"
                    type="tel"
                    inputmode="tel"
                    value="<%= profile.phone || '' %>"
                    autocomplete="tel"
                    maxlength="30"
                  />
                </label>

                <label class="field full">
                  <span>Bio</span>

                  <textarea
                    name="bio"
                    data-profile-bio
                    rows="4"
                    maxlength="500"
                    placeholder="Ceritakan sedikit tentang Anda..."
                  ><%= profile.bio || '' %></textarea>

                  <small class="field-help profile-bio-help">
                    <span>Maksimal 500 karakter.</span>

                    <span>
                      <strong data-profile-bio-count>
                        <%= String(profile.bio || '').length %>
                      </strong>/500
                    </span>
                  </small>
                </label>

                <div class="profile-form-actions full">
                  <button
                    class="button button-primary"
                    id="profile-save"
                    type="submit"
                  >
                    Simpan perubahan
                  </button>
                </div>

              </form>

      </div>

    </template>
  </details>

</section>

  <div class="two-column profile-content-grid">

    <section
      class="profile-security-card"
      aria-labelledby="profile-security-title"
    >
      <div class="profile-security-icon">
        <%- icon('shield-user-broken') %>
      </div>

      <div class="profile-security-copy">
        <div class="eyebrow">Proteksi akun</div>

        <h2 id="profile-security-title">
          <a href="/security" class="profile-security-title-link">
            Keamanan akun
          </a>
        </h2>

        <p>
          Kelola keamanan dan perlindungan akun Anda.
        </p>
      </div>

      <a
        class="button button-secondary button-small profile-security-action"
        href="/security"
      >
        Lihat keamanan
      </a>
    </section>

    <section
      class="panel profile-login-panel"
      aria-labelledby="profile-login-title"
    >

      <div class="profile-section-heading">
        <div>
          <div class="eyebrow">Aktivitas</div>

          <h2 id="profile-login-title">
            Riwayat login
          </h2>

          <p>
            Aktivitas autentikasi terbaru pada akun Anda.
          </p>
        </div>
      </div>

      <div class="profile-login-list">

        <% if (loginHistory.length) { %>

          <% loginHistory.forEach(l => { %>

            <article
              class="profile-login-item"
              data-login-status="<%= String(l.status || '').toUpperCase() %>"
            >
              <div
                class="profile-login-icon"
                aria-hidden="true"
              >
                <%- icon(
                  String(l.status || '').toUpperCase() === 'SUCCESS'
                    ? 'check'
                    : 'alert'
                ) %>
              </div>

              <div class="profile-login-copy">
                <strong>
                  <%= labelStatus(l.status) %>
                </strong>

                <span>
                  <%= l.device || 'Perangkat tidak diketahui' %>
                </span>

                <small>
                  <%= l.browser || 'Browser tidak diketahui' %>
                </small>
              </div>

              <time
                class="profile-login-time"
                datetime="<%= l.created_at %>"
              >
                <%= formatDate(l.created_at) %>
              </time>
            </article>

          <% }) %>

        <% } else { %>

          <%- include('../partials/empty',{
            title:'Belum ada riwayat login',
            description:'Aktivitas login akan tampil setelah proses autentikasi.'
          }) %>

        <% } %>

        <%- include('../partials/pagination',{
          pagination:loginPagination,
          param:'loginPage'
        }) %>

      </div>

    </section>

  </div>

</section>
