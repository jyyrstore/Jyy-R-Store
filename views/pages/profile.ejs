<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Account</div><h1>Profil & Security</h1><p>Role: <strong><%= profile.role %></strong> · Status: <strong><%= profile.status %></strong></p></div></div><div class="two-column"><section class="panel"><h2>Data akun</h2><form id="profile-form" class="form-grid"><label class="field"><span>Username</span><input name="username" value="<%= profile.username %>"></label><label class="field"><span>Display name</span><input name="display_name" value="<%= profile.display_name||'' %>"></label><label class="field"><span>Phone</span><input name="phone" value="<%= profile.phone||'' %>"></label><label class="field full"><span>Bio</span><textarea name="bio" rows="4"><%= profile.bio||'' %></textarea></label><button class="button button-primary" type="submit">Simpan perubahan</button></form></section><section class="panel"><h2>Login history</h2><div class="stack-list compact"><% loginHistory.forEach(l=>{ %><div class="list-card"><div><strong><%= l.status %></strong><span><%= l.device||'Unknown device' %> · <%= l.browser||'Unknown browser' %></span></div><span><%= formatDate(l.created_at) %></span></div><% }) %><% if(!loginHistory.length){ %><%- include('../partials/empty',{title:'Belum ada history',description:'Riwayat login akan tampil setelah authentication.'}) %><% } %></div></section></div></section>
