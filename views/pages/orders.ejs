<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Orders</div><h1>Pesanan saya</h1></div></div><div class="stack-list"><% orders.forEach(o=>{ %><a class="list-card" href="/orders/<%= o.id %>"><div><strong><%= o.order_number %></strong><span><%= o.items?.map(i=>`${i.product_name} × ${i.quantity}`).join(', ') %></span></div><div class="align-right"><b><%= formatIDR(o.total) %></b><span class="badge"><%= o.status %></span></div></a><% }) %><% if(!orders.length){ %><%- include('../partials/empty',{title:'Belum ada pesanan',description:'Order akan muncul setelah checkout.'}) %><% } %></div></section>
