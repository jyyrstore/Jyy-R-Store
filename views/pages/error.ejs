<section class="page-shell"><div class="error-state panel"><div class="empty-icon"><%- icon(status===404?'search':'alert') %></div><div><div class="eyebrow"><%= code || 'ERROR' %></div><h1><%= status===404?'Halaman tidak ditemukan':'Terjadi kesalahan' %></h1><p><%= message %></p><div class="inline-actions"><a class="button button-primary" href="/">Kembali ke Home</a><button class="button button-secondary" type="button" data-retry>Coba Lagi</button></div><small class="muted">Request ID: <%= requestId %></small></div></div></section>
