<section class="page-shell">
  <%
%>

  <div class="product-detail">
    <div class="detail-media">
      <div class="detail-image-frame">
        <% if(product.thumbnail_url || product.thumbnail_path){ %>
          <img
            src="<%= product.thumbnail_url || assetUrl(publicAssetBucket,product.thumbnail_path) %>"
            alt="<%= product.name %>"
            class="detail-image"
            loading="eager"
            data-image-fallback
          >
          <div class="detail-image-fallback image-fallback" hidden>
            <%- icon('image') %>
            <span>Gambar tidak tersedia</span>
          </div>
        <% } else { %>
          <div class="detail-image-fallback image-fallback">
            <%- icon('image') %>
            <span>Gambar tidak tersedia</span>
          </div>
        <% } %>
      </div>
    </div>
    <div class="detail-copy">
      <div class="detail-stock-summary" aria-label="Stok produk">
        <strong><%= Number(product.stock) || 0 %></strong>
        <span><%= Number(product.stock) > 0 ? 'Tersedia' : 'Habis' %></span>
      </div>
      <div class="detail-category-card"><%= product.category_name || 'Produk' %></div><h1><%= product.name %></h1>
      <div class="detail-price"><%= formatIDR(product.price) %></div>
<div class="detail-actions" aria-label="Aksi produk">
        <% if(currentUser && product.stock>0){ %>
          <button class="button button-secondary" data-add-cart="<%= product.id %>"><%- icon('cart') %> Keranjang</button>
          <button class="button button-primary" data-buy-now="<%= product.id %>"><%- icon('check') %> Beli Sekarang</button>
        <% } else if (!currentUser){ %><a class="button button-primary" href="/auth/login?next=<%= encodeURIComponent(req.originalUrl) %>">Masuk untuk membeli</a><% } %>
      </div>
      <div class="security-note">
        <%- icon('shield-key-outline') %>
        <div>
          <strong>Pengiriman aman</strong>
          <span>Konten premium diverifikasi server sebelum akses dan menggunakan tautan akses sementara.</span>
        </div>
      </div>
    </div>
    <p class="detail-description"><%= product.description || 'Tidak ada deskripsi.' %></p>
  </div>
  </section>
