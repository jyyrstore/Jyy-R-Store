<section class="page-shell">
  <%
%>

  <div class="product-detail">
    <div class="detail-media">
      <button
        type="button"
        class="icon-button detail-share-button"
        data-product-share
        data-share-title="<%= product.name %>"
        aria-label="Bagikan produk"
        title="Bagikan produk"
      >
        <%- icon('share') %>
      </button>
      <div class="detail-image-frame">
        <% if(product.thumbnail_url || product.thumbnail_path){ %>
          <img
            src="<%= product.thumbnail_url || assetUrl(publicAssetBucket,product.thumbnail_path) %>"
            alt="<%= product.name %>"
            class="detail-image"
            loading="eager"
            data-image-fallback
          >
          <div class="detail-image-fallback image-fallback" hidden>
            <%- icon('image') %>
            <span>Gambar tidak tersedia</span>
          </div>
        <% } else { %>
          <div class="detail-image-fallback image-fallback">
            <%- icon('image') %>
            <span>Gambar tidak tersedia</span>
          </div>
        <% } %>
      </div>
    </div>
    <div class="detail-product-stats" aria-label="Statistik produk">
      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <%- icon('category-management') %>
          <span><%= product.category_name || 'Produk' %></span>
        </span>
      </div>
      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <%- icon('eye') %>
          <span><%= new Intl.NumberFormat('id-ID', { notation: 'compact', maximumFractionDigits: 1 }).format(Number(product.view_count || 0)).replace(/\s/g, '') %> Dilihat</span>
        </span>
      </div>
      <div class="detail-product-stat">
        <span class="detail-product-stat-value">
          <%- icon('tag-sale-price') %>
          <span><%= new Intl.NumberFormat('id-ID', { notation: 'compact', maximumFractionDigits: 1 }).format(Number(product.purchase_count || 0)).replace(/\s/g, '') %> Terjual</span>
        </span>
      </div>
    </div>
    <div class="detail-copy">
      <div class="detail-stock-summary" aria-label="Stok produk">
        <strong data-product-stock-count><%= Number(product.stock) || 0 %></strong>
        <span data-product-stock-state class="<%= Number(product.stock) > 0 ? 'is-available' : 'is-unavailable' %>"><%= Number(product.stock) > 0 ? 'Tersedia' : 'Habis' %></span>
      </div>

      <div class="detail-category-card"><%= product.category_name || 'Produk' %></div>

      <% if(product.pricing_mode==='VARIANT'){ %>
        <div class="field" data-product-variant-field>
          <span>Pilih Nominal</span>
          <div class="jyyr-select" data-jyyr-select data-product-variant-picker>
            <input type="hidden" name="variant_id" value="" data-jyyr-select-value data-product-variant-select>
            <button class="jyyr-select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-jyyr-select-trigger>
              <span data-jyyr-select-label>Pilih nominal produk</span>
              <span class="jyyr-select-chevron" aria-hidden="true"></span>
            </button>
            <div class="jyyr-select-menu" role="listbox" data-jyyr-select-menu>
              <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="" data-label="Pilih nominal produk">Pilih nominal produk</button>
              <% (product.variants||[]).forEach(v=>{ const available=Math.max(0,Number(v.stock)-Number(v.reserved_stock||0)); if(available>0){ const variantLabel=String(v.label)+' — '+formatIDR(v.price); %>
                <button type="button" class="jyyr-select-option" role="option" data-jyyr-select-option data-value="<%= v.id %>" data-label="<%= variantLabel %>" data-price="<%= v.price %>" data-stock="<%= available %>"><%= variantLabel %></button>
              <% } }) %>
            </div>
          </div>
        </div>
      <% } %>
      <div class="detail-title-row">
        <h1><%= product.name %></h1>
        <div class="detail-price" data-product-price><%= product.pricing_mode==='VARIANT'?'Pilih nominal':formatIDR(product.price) %></div>
      </div>

      <% if(currentUser){ %>
        <section class="recipient-contact-card product-detail-recipient-contact">
          <div class="recipient-contact-header">
            <div>

              <h2>Kontak Penerima</h2>
              <p class="muted small">
                Digunakan untuk informasi pesanan dan komunikasi admin.
              </p>
            </div>
          </div>

          <form data-recipient-contact-form class="stack-form" method="POST" action="/cart/contact">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <input type="hidden" name="returnTo" value="/product/<%= product.slug %>">
            <label class="field">
              <span>Email Penerima</span>
              <input
                type="email"
                name="email"
                value="<%= recipientContact?.email||'' %>"
                placeholder="Email@gmail.com"
                maxlength="254"
                autocomplete="email"
                required
              >
            </label>

            <% const countryFlag=(code)=>String(code||'').toUpperCase().split('').map(char=>String.fromCodePoint(127397+char.charCodeAt(0))).join(''); %>

            <%
              const selectedRecipientCountry =
                (recipientCountries||[]).find(
                  country=>country.code===(recipientContact?.countryCode||'ID')
                ) ||
                (recipientCountries||[])[0] ||
                {code:'ID',name:'Indonesia',dialCode:'+62'};
            %>

            <label class="field recipient-country-field">
              <span>Nomor WhatsApp</span>

              <input
                type="hidden"
                name="countryCode"
                data-recipient-country
                value="<%= selectedRecipientCountry.code %>"
              >

              <button
                type="button"
                class="recipient-country-trigger"
                data-recipient-country-trigger
                aria-haspopup="dialog"
              >
                <span data-recipient-country-label>
                  <%= selectedRecipientCountry.name %> <%= countryFlag(selectedRecipientCountry.code) %>
                </span>
                <span class="recipient-country-trigger-arrow" aria-hidden="true">⌄</span>
              </button>

              <template data-recipient-country-options>
                <% (recipientCountries||[]).forEach(country=>{ %>
                  <button
                    type="button"
                    class="recipient-country-option<%= country.code===selectedRecipientCountry.code ? ' is-active' : '' %>"
                    data-recipient-country-option
                    data-country-code="<%= country.code %>"
                    data-dial-code="<%= country.dialCode %>"
                    data-country-name="<%= country.name %>"
                    data-country-flag="<%= countryFlag(country.code) %>"
                    aria-selected="<%= country.code===selectedRecipientCountry.code ? 'true' : 'false' %>"
                  >
                    <span>
                      <%= country.name %> <%= countryFlag(country.code) %>
                    </span>
                    <strong><%= country.dialCode %></strong>
                  </button>
                <% }) %>
              </template>
            </label>

            <div class="recipient-phone-row">
              <div class="recipient-dial-field">
                <div class="recipient-dial-code" data-recipient-dial-code>
                  <strong><%= recipientContact?.dialCode||selectedRecipientCountry.dialCode||'+62' %></strong>
                </div>
              </div>

              <label class="field recipient-phone-field">
                <input
                  type="tel"
                  name="phone"
                  value="<%= recipientContact?.phone||'' %>"
                  placeholder="Nomor WhatsApp"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  maxlength="14"
                  pattern="[1-9][0-9]{5,13}"
                  required
                >
              </label>
            </div>

            <small>
              Isi nomor tanpa angka 0 di depan agar admin bisa menghubungi Anda via WhatsApp.
            </small>

            <div class="recipient-contact-actions">
              <button class="button button-primary" type="submit">
                <%- icon('device-floppy') %>
                Simpan kontak
              </button>
            </div>
          </form>
        </section>
      <% } else { %>
        <section class="recipient-contact-card product-detail-recipient-contact">
          <div class="recipient-contact-header">
            <div>

              <h2>Kontak Penerima</h2>
              <p class="muted small">
                Masuk untuk mengatur email dan nomor WhatsApp penerima.
              </p>
            </div>
          </div>

          <a
            class="button button-primary button-block"
            href="/auth/login?next=<%= encodeURIComponent(req.originalUrl) %>"
          >
            Masuk untuk mengatur kontak
          </a>
        </section>
      <% } %>

      <div class="detail-actions" aria-label="Aksi produk">
        <% if(currentUser && product.stock>0){ %>
          <button class="button button-secondary" data-add-cart="<%= product.id %>"><%- icon('cart') %> Keranjang</button>
          <button class="button button-primary" data-buy-now="<%= product.id %>"><%- icon('check') %> Beli Sekarang</button>
        <% } else if (!currentUser){ %><a class="button button-primary" href="/auth/login?next=<%= encodeURIComponent(req.originalUrl) %>">Masuk untuk membeli</a><% } %>
      </div>
      <div class="security-note">
        <%- icon('shield-key-outline') %>
        <div>
          <strong>Pengiriman aman</strong>
          <span>Konten premium diverifikasi server sebelum akses dan menggunakan tautan akses sementara.</span>
        </div>
      </div>
    </div>
    <h2 class="detail-description-heading">Detail <%= product.name %></h2>
    <p class="detail-description"><%= product.description || 'Tidak ada deskripsi.' %></p>
  </div>

    <section
  class="section product-detail-info"
  aria-labelledby="product-detail-info-title"
>
  <header class="product-detail-info-header">
    <h2 id="product-detail-info-title">
      Keunggulan Berbelanja Produk Digital di Jyyr Store
    </h2>
    <p class="product-detail-info-lead">
      Jyyr Store menyediakan layanan pembelian Produk Digital dengan proses
      yang cepat, aman, dan terpercaya.
    </p>
  </header>

  <h3>Harga Lebih Terjangkau</h3>
  <p>Nikmati harga kompetitif tanpa mengurangi kualitas layanan.</p>

  <p>
    Jyyr Store merupakan platform digital yang menyediakan berbagai kebutuhan
    digital dalam satu tempat, mulai dari:
  </p>
  <ul>
    <li>Overlay Premium</li>
    <li>Aplikasi Premium</li>
    <li>Social Media Marketing</li>
    <li>Preset Premium</li>
    <li>Bahan Editing</li>
  </ul>
  <p>
    Dengan sistem transaksi yang mudah, cepat, dan aman, Jyyr Store menjadi
    pilihan tepat untuk memenuhi berbagai kebutuhan digital Anda.
  </p>

  <h3>Proses Cepat</h3>
  <p>Pesanan diproses secepat mungkin setelah pembayaran berhasil.</p>

  <h3>Aman &amp; Terpercaya</h3>
  <p>
    Ribuan pelanggan telah mempercayakan kebutuhan produk digital mereka
    melalui Jyyr Store.
  </p>

  <h3>Banyak Metode Pembayaran</h3>
  <p>Pembayaran semakin mudah menggunakan:</p>
  <ul>
    <li>QRIS</li>
    <li>Transfer Bank</li>
    <li>DANA</li>
    <li>GoPay</li>
    <li>OVO</li>
    <li>ShopeePay</li>
    <li>Virtual Account</li>
    <li>E-Wallet lainnya</li>
  </ul>

  <h3>Customer Support Responsif</h3>
  <p>
    Tim customer service siap membantu apabila mengalami kendala saat proses
    pembelian maupun aktivasi.
  </p>

  <h3>Bergaransi</h3>
  <p>
    Setiap transaksi mendapatkan garansi sesuai ketentuan produk sehingga
    pelanggan dapat berbelanja dengan lebih tenang.
  </p>

  <h3>Cara Memesan</h3>
  <ol class="product-detail-steps">
    <li>Pilih Produk yang kamu inginkan.</li>
    <li>
      Lengkapi data yang diminta (Kontak Penerima/nomor tujuan), lalu klik Beli Sekarang.
    </li>
    <li>Selesaikan pembayaran melalui QRIS atau e-wallet.</li>
    <li>Pesanan diproses dan dikirim ke akun/tujuanmu.</li>
  </ol>

  <div class="product-detail-info-cta">
    <p>
      Lihat produk lain di kategori
      <a class="product-detail-category-link" href="#product-category-title">Kategori Produk</a>.
    </p>
  </div>
</section>

    <section
      class="product-reviews-section"
      aria-labelledby="product-reviews-title"
    >
      <div class="section-header product-reviews-header">
        <div>

          <h2 id="product-reviews-title">Ulasan Pembeli</h2>
          <p>Rating dan pengalaman dari pembeli yang telah melakukan transaksi.</p>
        </div>
      </div>

      <div class="product-review-summary-grid product-review-summary-grid-single">

        <section
          class="product-review-chart panel"
          aria-labelledby="product-review-chart-title"
        >
          <div class="product-review-panel-title">
            <div>
              <div class="eyebrow">Grafik Pembelian</div>
              <h3 id="product-review-chart-title">Rating Pembelian</h3>
            </div>

            <span class="product-review-count">
              <%= Number(reviewSummary.reviewCount||0) %> Ulasan
            </span>
          </div>

          <div class="product-review-bars">
            <% [5,4,3,2,1].forEach(star=>{
              const count=Number(
                reviewSummary.distribution?.[star]||0
              );

              const total=Number(
                reviewSummary.reviewCount||0
              );

              const percent=total
                ? Math.round((count/total)*100)
                : 0;
            %>

              <div class="product-review-bar-row">

                <span
                  class="product-review-stars-label"
                  aria-label="<%= star %> dari 5 bintang"
                >
                  <%= '★'.repeat(star) %><%= '☆'.repeat(5-star) %>
                </span>

                <span
                  class="product-review-bar-track"
                  aria-hidden="true"
                >
                  <span style="width:<%= percent %>%"></span>
                </span>

                <strong><%= percent %>%</strong>

              </div>

            <% }) %>
          </div>

          <div class="product-review-summary-foot">
            <strong>
              ★ <%= Number(reviewSummary.averageRating||0).toFixed(1) %> / 5.0
            </strong>

            <span>•</span>

            <span>
              <%= Number(product.purchase_count||0) %> Pembelian
            </span>
          </div>
        </section>

      </div>


      <div class="product-review-list-wrap">

        <div class="product-review-list-head">
          <div>
              <h3>Ulasan terbaru</h3>
          </div>
        </div>

        <% if(reviews.length){ %>

          <div class="product-review-list">

            <% reviews.forEach(review=>{
              const displayName=
                review.display_name ||
                review.username ||
                'Pembeli';

              const initial=
                String(displayName).trim().slice(0,1).toUpperCase() ||
                'P';
            %>

              <article class="product-review-card">

                <div
                  class="product-review-avatar"
                  aria-hidden="true"
                >
                  <%= initial %>
                </div>

                <div class="product-review-content">

                  <div class="product-review-topline">

                    <div class="product-review-user">
                      <strong><%= displayName %></strong>
                    </div>

                    <span class="product-review-verified">
                      ✓ Terverifikasi
                    </span>

                  </div>

                  <div
                    class="product-review-rating"
                    aria-label="Rating <%= review.rating %> dari 5"
                  >
                    <% for(let star=1;star<=5;star++){ %>

                      <span
                        class="<%= star<=Number(review.rating)
                          ? 'is-filled'
                          : 'is-empty' %>"
                        aria-hidden="true"
                      ><%= star<=Number(review.rating)
                        ? '★'
                        : '☆' %></span>

                    <% } %>
                  </div>

                  <p class="product-review-comment">
                    <%= review.comment %><span class="product-review-time"> · <%= formatDate(
                      review.purchase_at ||
                      review.created_at
                    ) %></span>
                  </p>

                </div>
              </article>

            <% }) %>

          </div>

          <%- include('../partials/pagination',{
            pagination:reviewsPagination,
            param:'reviewPage',
            label:'Pagination ulasan pembeli'
          }) %>

        <% } else { %>

          <%- include('../partials/empty',{
            title:'Belum ada ulasan pembeli',
            description:'Belum ada rating untuk produk ini. Jadilah pembeli pertama yang memberikan ulasan.'
          }) %>

        <% } %>

      </div>
    </section>


    <section
      class="section product-detail-recommendations"
      aria-labelledby="product-other-title"
    >
      <div class="section-header">
        <div>
          <h2 id="product-other-title">Produk Lainnya</h2>
          <p>Produk lain yang bisa Anda pertimbangkan.</p>
        </div>
      </div>

      <% if(relatedProducts.length){ %>

        <div class="product-grid">
          <% relatedProducts.forEach(product=>{ %>
            <%- include('../partials/product-card',{product}) %>
          <% }) %>
        </div>

      <% } else { %>

        <%- include('../partials/empty',{
          title:'Belum ada produk lainnya',
          description:'Belum ada produk lain yang tersedia saat ini.'
        }) %>

      <% } %>
    </section>


    <section
      class="section product-detail-recommendations"
      aria-labelledby="product-best-title"
    >
      <div class="section-header">
        <div>

          <h2 id="product-best-title">Produk Terlaris</h2>
          <p>Produk dengan jumlah pembelian tertinggi.</p>
        </div>
      </div>

      <% if(bestSellerProducts.length){ %>

        <div class="product-grid">
          <% bestSellerProducts.forEach(product=>{ %>
            <%- include('../partials/product-card',{product}) %>
          <% }) %>
        </div>

      <% } else { %>

        <%- include('../partials/empty',{
          title:'Belum ada produk terlaris',
          description:'Data pembelian belum tersedia.'
        }) %>

      <% } %>
    </section>



    <section
      class="section product-detail-recommendations"
      aria-labelledby="product-category-title"
    >
      <div class="section-header">
        <div>
          <h2 id="product-category-title">Jelajahi Kategori</h2>
          <p>Pilih kategori untuk melihat lebih banyak produk.</p>
        </div>
      </div>

      <% if(categoryList.length){ %>

        <div class="category-grid product-detail-category-grid">

          <% categoryList.forEach(category=>{ %>

            <a
              class="category-card"
              href="/store?category=<%= encodeURIComponent(category.slug) %>"
            >
              <span class="category-card__content">

                <strong class="category-card__name">
                  <%= category.name %>
                </strong>

                <% if(category.description){ %>
                  <span class="category-card__description">
                    <%= category.description %>
                  </span>
                <% } %>

              </span>
            </a>

          <% }) %>

        </div>

      <% } else { %>

        <%- include('../partials/empty',{
          title:'Belum ada kategori',
          description:'Kategori produk akan muncul di sini.'
        }) %>

      <% } %>

    </section>
</section>
