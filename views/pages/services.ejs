<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Services</div><h1>Layanan</h1><p>Service aktif yang tersedia dari Jyy'R Store. Pesanan service tersimpan sebagai order nyata.</p></div></div><div class="service-grid"><% services.forEach(s=>{ %><article class="service-card"><div><div class="eyebrow"><%= s.category||'Service' %></div><h3><%= s.name %></h3><p><%= s.description||'Service store.' %></p><% if(s.requirements&&Object.keys(s.requirements).length){ %><small class="muted">Requirements dikonfigurasi oleh Owner.</small><% } %></div><div class="service-footer"><strong><%= formatIDR(s.price) %></strong><button class="button button-secondary button-small" data-service-order="<%= s.id %>" data-service-name="<%= s.name %>" data-service-price="<%= s.price %>">Pesan</button></div></article><% }) %></div></section>
