<section class="page-shell home-page">
  <figure class="home-brand-banner">
    <img
      src="/images/banners/brand-banner.jpg"
      alt="Jyyr Store"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  </figure>
  <ul class="home-trust-labels" aria-label="Keunggulan layanan">
    <li><%- icon('shield') %><span>Transaksi Aman</span></li>
    <li><%- icon('rotate-ccw') %><span>Garansi Uang Kembali</span></li>
    <li><%- icon('timer') %><span>Proses Cepat</span></li>
  </ul>
  <section class="hero">
    <div>
      <div class="hero-actions">
        <a href="/store" class="button button-primary"><%- icon('shop-twotone', 'icon hero-store-icon') %> Jelajahi Store</a>
        <% if (!currentUser) { %><a href="/auth/register" class="button button-secondary">Buat Akun</a><% } %>
      </div>
    </div>
    <div class="hero-stat">
      <div><span>Pembayaran</span><strong>Terverifikasi server</strong></div>
      <div><span>Produk digital</span><strong>Akses terlindungi</strong></div>
    </div>
  </section>

  <nav class="home-category-filters" aria-label="Filter kategori produk">
    <button
      class="home-category-filter is-active"
      type="button"
      data-home-category-filter="all"
      aria-pressed="true"
    >
      <%- icon('category-management') %>
      <span>Semua</span>
    </button>
    <% categories.filter(c=>!c.parent_id).filter(c=>subcategoryGroups.some(group=>String(group.category.id)===String(c.id)||String(group.category.parent_id)===String(c.id))).forEach(c=>{ %>
    <button
      class="home-category-filter"
      type="button"
      data-home-category-filter="<%= c.id %>"
      aria-pressed="false"
    >
      <%- icon(c.icon_key||'category-management','icon category-inline-icon') %>
      <span><%= c.name %></span>
    </button>
    <% }) %>
  </nav>

  <% let homepageProductIndex=0; %>
  <% subcategoryGroups.forEach(group=>{ %>
    <section
      class="section home-category-group"
      data-home-category-group="<%= group.category.parent_id || group.category.id || 'uncategorized' %>"
    >
      <% const parentCategory=categories.find(category=>String(category.id)===String(group.category.parent_id)); %>
      <div class="section-header home-subcategory-header">
        <span class="home-parent-category-name"><% if(parentCategory){ %><span class="category-name-with-icon"><%- icon(parentCategory.icon_key||'category-management','icon category-inline-icon') %><span><%= parentCategory.name %></span></span><% } %></span>
        <div class="home-subcategory-heading">
          <h2><span class="category-name-with-icon"><%- icon(group.category.icon_key||'category-management','icon category-inline-icon') %><span><%= group.category.name %></span></span></h2>
          <span class="home-subcategory-count" aria-label="<%= group.total %> item produk"><%= group.total %></span>
        </div>
        <span class="home-subcategory-rule" aria-hidden="true"></span>
        <a href="<%= group.category.slug ? '/store?category='+encodeURIComponent(group.category.slug) : '/store' %>" class="text-link" aria-label="Lihat semua produk kategori <%= group.category.name %>">Lihat semua</a>
      </div>
      <div class="product-grid"><% group.products.forEach(product=>{ %><%- include('../partials/product-card',{product,productCardImageLoading:homepageProductIndex===1?'eager':'lazy',productCardImageFetchPriority:homepageProductIndex===1?'high':null}) %><% homepageProductIndex++; %><% }) %></div>
    </section>
  <% }) %>



</section>
