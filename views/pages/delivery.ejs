<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Delivery</div><h1>Product delivery</h1><p>Akses content yang sudah dibeli.</p></div></div><div class="stack-list"><% entitlements.forEach(e=>{ %><article class="list-card"><div><strong><%= e.product_name || e.product_id %></strong><span><%= e.status %> · <%= formatDate(e.granted_at) %></span></div><a class="button button-primary button-small" href="/orders/<%= e.order_id %>">Buka Order</a></article><% }) %><% if(!entitlements.length){ %><%- include('../partials/empty',{title:'Belum ada delivery',description:'Setelah order paid, entitlement akan muncul di sini.',cta:'/store',ctaText:'Jelajahi Store'}) %><% } %></div></section>
