<section class="page-shell">
  <div class="page-header">
    <div><h1>Produk Saya</h1><p>Akses produk digital yang sudah tersedia untuk akunmu.</p></div>
  </div>

  <div class="stack-list">
    <% entitlements.forEach(e=>{ %>
      <a class="list-card delivery-card"
         href="/orders/<%= e.order_id %>"
         aria-label="Buka order: <%= e.product_name || e.product_id %>">
        <span class="eyebrow accent delivery-card-label">Akses digital</span>
        <span class="delivery-card-status"><%= labelStatus(e.status) %></span>
        <strong class="delivery-card-product"><%= e.product_name || e.product_id %></strong>
        <span class="delivery-card-date"><%= formatDate(e.granted_at) %></span>
      </a>
    <% }) %>

    <% if(!entitlements.length){ %>
      <%- include('../partials/empty',{title:'Belum ada akses produk',description:'Setelah pesanan berhasil, akses produk akan muncul di sini.',cta:'/store',ctaText:'Jelajahi Store'}) %>
    <% } %>

<%- include('../partials/pagination',{
  pagination:deliveryPagination,
  param:'page'
}) %>
</div>
</section>
