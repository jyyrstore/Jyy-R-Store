<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Bantuan</div><h1>Tiket bantuan</h1></div><button class="button button-primary" data-open-ticket-form><%- icon('plus') %> Buat Tiket</button></div><div class="stack-list"><% tickets.forEach(t=>{ %><a class="list-card" href="/tickets/<%= t.id %>"><div><strong><%= t.ticket_number %></strong><span><%= t.subject %> · <%= t.category %></span></div><div class="align-right"><span class="badge badge-<%= String(t.status||'').toLowerCase() %>"><%= labelStatus(t.status) %></span><span><%= formatDate(t.updated_at) %></span></div></a><% }) %><% if(!tickets.length){ %><%- include('../partials/empty',{title:'Belum ada tiket',description:'Tiket bantuan yang kamu buat akan tampil di sini.'}) %><% } %></div></section>
