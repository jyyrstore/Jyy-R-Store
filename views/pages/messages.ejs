<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Bantuan</div><h1>Pesan</h1><p>Hubungi tim Jyy'R Store dan lihat respons pada satu ruang percakapan.</p></div></div><section class="panel stack-form"><h2>Kirim pesan</h2><p class="muted">Pesanmu akan masuk ke tim Jyy’R Store dan tersimpan sebagai percakapan.</p><form data-message-form><label class="field"><span>Pesan</span><textarea name="body" rows="5" maxlength="10000" required placeholder="Tulis pesan Anda..."></textarea></label><button class="button button-primary">Kirim Pesan</button></form></section><div class="section"><div class="section-header"><div><h2>Percakapan</h2></div></div><div class="stack-list"><% if(!messages.length){ %><div class="empty-state"><%- icon('message') %><h3>Belum ada pesan</h3><p>Pesan dan respons support akan tampil di sini.</p></div><% } else { %><% messages.forEach(m=>{ %><a class="list-card" href="/messages/<%= m.id %>"><div><strong><%= m.sender_id===currentUser.id?'Anda':(m.sender_username||"Jyy'R Store") %></strong><span><%= m.body.slice(0,160) %><%= m.body.length > 160 ? "…" : "" %></span></div><time><%= formatDate(m.created_at) %></time></a><% }) %><% } %></div></div></section>
