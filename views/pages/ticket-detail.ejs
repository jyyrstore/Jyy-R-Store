<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Tiket <%= ticket.ticket_number %></div><h1><%= ticket.subject %></h1><p><span class="badge badge-<%= String(ticket.status||'').toLowerCase() %>"><%= labelStatus(ticket.status) %></span> · <%= ticket.category %></p></div></div><div class="conversation"><% ticket.messages.forEach(m=>{ %><article class="message <%= m.sender_id===currentUser.id?'mine':'theirs' %>"><div class="message-meta"><strong><%= m.username %></strong><span><%= formatDate(m.created_at) %></span></div><p><%= m.body %></p></article><% }) %></div><form class="reply-form inline-form" data-ticket-reply="<%= ticket.id %>"><input name="body" placeholder="Tulis balasan..." autocomplete="off" required><button class="button button-primary">Kirim</button></form></section>
