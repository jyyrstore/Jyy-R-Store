<section class="page-shell">
  <div class="page-header">
    <div><div class="eyebrow">Pesan</div><h1>Percakapan</h1><p><%= formatDate(message.created_at) %></p></div>
    <a class="button button-secondary" href="/messages">Kembali</a>
  </div>

  <section class="panel">
    <article class="message <%= message.sender_id===currentUser.id?'mine':'theirs' %>">
      <div class="message-meta">
        <strong><%= message.sender_id===currentUser.id?'Anda':(message.sender_username||"Jyy'R Store") %></strong>
        <span><%= formatDate(message.created_at) %></span>
      </div>
      <p><%= message.body %></p>
    </article>
  </section>

  <section class="panel section stack-form">
    <div>
      <div class="eyebrow">Balasan</div>
      <h2>Balas pesan</h2>
      <p class="muted small">Balasan tetap berada di thread pesan yang sama.</p>
    </div>

    <form data-message-form>
      <label class="field">
        <span>Pesan</span>
        <textarea name="body" rows="4" maxlength="10000" required placeholder="Tulis balasan..."></textarea>
      </label>
      <button class="button button-primary" type="submit">Kirim Balasan</button>
    </form>
  </section>
</section>
