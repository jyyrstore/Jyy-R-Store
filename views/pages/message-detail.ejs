<section class="page-shell message-detail-page">

  <div class="message-detail-shell">

    <section class="message-detail-card">

      <!-- CHAT HEADER -->
      <header class="message-detail-header">

        <a
          class="message-detail-back"
          href="/messages"
          aria-label="Kembali ke pesan"
          title="Kembali"
        >
          <%- icon('arrow-back-up') %>
        </a>

        <div class="message-detail-avatar" aria-hidden="true">
          <%- icon('user-headset-outline') %>
        </div>

        <div class="message-detail-user">

          <%
            const isMine = message.sender_id === currentUser.id;

            const senderName = isMine
              ? 'Anda'
              : (message.sender_display_name ||
                 message.sender_username ||
                 'Jyyr Store');
          %>

          <strong><%= senderName %></strong>

          <span>
            <%= isMine ? 'Pesan Anda' : 'Support Jyyr Store' %>
          </span>

        </div>

      </header>

      <!-- CHAT BODY -->
      <div class="message-detail-body">

        <div class="message-detail-date">
          <span><%= formatDate(message.created_at) %></span>
        </div>

        <article
          class="message-bubble <%= isMine ? 'is-mine' : 'is-theirs' %>"
        >

          <div class="message-bubble-text"><%= String(message.body || '').trim() %></div>

          <div class="message-bubble-meta">

            <time>
              <%= formatDate(message.created_at) %>
            </time>

            <% if(isMine){ %>
              <span
                class="message-bubble-status"
                aria-label="Terkirim"
                title="Terkirim"
              >
                <%- icon('check') %>
              </span>
            <% } %>

          </div>

        </article>

      </div>

      <!-- CHAT COMPOSER -->
      <footer class="message-detail-composer">

        <form
          class="message-detail-form"
          data-message-form
        >

          <label
            class="message-detail-input"
            aria-label="Pesan"
          >

            <textarea
              name="body"
              rows="1"
              maxlength="10000"
              required
              aria-label="Pesan"
              placeholder="Ketik pesan..."
            ></textarea>

          </label>

          <button
            class="message-detail-send"
            type="submit"
            aria-label="Kirim pesan"
            title="Kirim pesan"
          >
            <%- icon('send') %>
            <span>Kirim</span>
          </button>

        </form>

      </footer>

    </section>

  </div>

</section>
