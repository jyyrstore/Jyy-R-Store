<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Pesanan</div><h1><%= order.order_number %></h1><p>Dibuat <%= formatDate(order.created_at) %></p></div><span class="badge badge-<%= String(order.status||'').toLowerCase() %>"><%= labelStatus(order.status) %></span></div><div class="two-column"><div class="panel"><h2>Produk</h2><div class="stack-list"><% order.items.forEach(i=>{ %><div class="list-card"><div><strong><%= i.product_name %></strong><span><%= i.quantity %> × <%= formatIDR(i.unit_price) %></span></div><b><%= formatIDR(i.line_total) %></b></div><% }) %></div></div><aside class="summary-card"><div class="summary-row"><span>Total</span><strong><%= formatIDR(order.total) %></strong></div><a class="button button-primary button-block" href="/delivery">Buka Produk</a></aside></div></section>
