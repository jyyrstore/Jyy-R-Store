<% const contentTypeLabels = { FILE: 'File', IMAGE: 'Gambar', VIDEO: 'Video', AUDIO: 'Audio', TEXT: 'Teks', LINK: 'Tautan' }; const accessTypeLabels = { PURCHASED: 'Setelah pembelian', PUBLIC: 'Publik', PREVIEW: 'Pratinjau' }; %> <% const paymentDetailsMarkup = payment ? include('../partials/payment-details', { payment, heading: 'Rincian Pembayaran', orderNumber: order.order_number }) : ''; %>
<section class="page-shell" data-payment-review-order-detail="<%= req.query.review ? order.id : '' %>"> <div class="two-column"> <div class="order-download-panel"> <div class="panel order-detail-table-card">
<div class="section-header order-detail-table-heading">
  <div>
    <h2>Produk Digital</h2>
    <span class="badge badge-<%= String(order.status||'').toLowerCase() %>"><%= labelStatus(order.status) %></span>
  </div>
  <span class="payment-title-divider" aria-hidden="true"></span>
</div>
<div class="order-detail-table-summary">
  <div class="summary-row order-detail-table-row">
    <span>Pesanan</span>
    <b># <%= order.order_number %></b>
  </div>

  <div class="summary-row order-detail-table-row">
    <span>Dibuat</span>
    <b><%= formatDate(order.created_at) %></b>
  </div>
</div>



<% order.items.forEach(item=>{ %> <div class="section-header order-detail-table-product-row"> <span><%= item.product_name %><%= item.variant_label?' — '+item.variant_label:'' %></span> <b><%= item.quantity %> × <%= formatIDR(item.unit_price) %></b> </div> <div class="section-header order-detail-table-download-row"><span>Download Produk</span><b><%= (item.contents||[]).length %> item</b></div> <% }) %>
</div>
<% let paymentDetailsShown = false; %>
<% order.items.forEach(item=>{ %> <div class="section"> <div class="content-list order-detail-table-content-list"> <% if((item.contents||[]).length===0){ %><%- include('../partials/empty',{title:'Belum ada isi produk',description:'Belum ada isi produk yang ditambahkan untuk produk ini.'}) %><% } %> <% (item.contents||[]).forEach(c=>{ %> <article class="content-card"> <div class="content-main"><div class="content-main-heading"><div class="content-icon"><%- icon(c.type==='VIDEO'?'play':c.type==='AUDIO'?'music':c.type==='IMAGE'?'image':c.type==='LINK'?'external':c.type==='TEXT'?'note':'package') %></div><div class="content-heading order-item-content-heading"> <strong><%= c.title %></strong> <span><%= contentTypeLabels[c.type] || 'Konten' %> · <%= accessTypeLabels[c.access_type] || 'Akses terbatas' %></span> </div> </div>
<% if(c.description){ %> <p class="content-description"><%= c.description %></p> <% } %> <% if(c.type==='TEXT' && c.allowed){ %> <div class="content-text"><%= c.text_content || '' %></div> <% } else if(c.type==='TEXT'){ %> <div class="content-lock-note"> Konten tersedia setelah pembayaran terverifikasi. </div> <% } %> <% if(c.type==='FILE'){ %> <div class="file-meta content-extra-meta"> <span><%= c.mime_type || 'File' %></span> <span><%= c.file_size ? (Number(c.file_size)/1024/1024).toFixed(2)+' MB' : '—' %></span> </div> <% } %> </div> <div class="content-side"> <span class="badge"> <%= c.allowed ? (c.is_preview ? 'Pratinjau' : 'Tersedia') : 'Terkunci' %> </span> <% if(!c.allowed && c.type!=='TEXT' && !(c.type==='LINK' && c.url)){ %> <span class="muted small content-side-note">Pembelian diperlukan</span> <% } %> </div> <div class="content-side-actions"> <% if(c.type==='LINK' && c.url && c.allowed){ %> <button class="button button-primary button-small" type="button" data-download-content="<%= c.id %>" > Buka </button> <% } %> <% if(c.preview_url && ['IMAGE','VIDEO','AUDIO'].includes(c.type)){ %> <button class="button button-secondary button-small" type="button" data-open-content-url="<%= c.preview_url %>"> Pratinjau </button> <% } %> <% if(c.allowed && ['FILE','IMAGE','VIDEO','AUDIO'].includes(c.type)){ %> <button class="button button-primary button-small" type="button" data-download-content="<%= c.id %>"> Akses </button> <% } %> </div> </article> <% }) %> </div>

<% if(paymentDetailsMarkup && !paymentDetailsShown && (item.canReview || item.viewerReview)){ %>
  <div class="payment-details-shell">
    <%- paymentDetailsMarkup %>
  </div>
  <% paymentDetailsShown = true; %>
<% } %>

<% if(item.canReview || item.viewerReview){ %>
  <section
    class="product-review-write panel order-product-review"
    aria-labelledby="order-review-title-<%= item.product_id %>"
  >
    <div class="eyebrow">Rate Bintang</div>

    <h3 id="order-review-title-<%= item.product_id %>">
      <%= item.viewerReview
        ? 'Perbarui ulasan Anda'
        : 'Bagikan pengalaman pembelian'
      %>
    </h3>

    <% if(item.canReview){ %>

      <form
        data-product-review-form
        data-product-id="<%= item.product_id %>"
      >
        <input
          type="hidden"
          name="rating"
          value="<%= item.viewerReview?.rating || '' %>"
          data-review-rating-value
        >

        <div
          class="product-review-rating-picker"
          role="radiogroup"
          aria-label="Rating pembelian 1 sampai 5"
        >
          <% [1,2,3,4,5].forEach(star=>{ %>
            <button
              type="button"
              class="product-review-star-button<%= Number(item.viewerReview?.rating||0) >= star ? ' is-selected' : '' %>"
              data-review-rating="<%= star %>"
              aria-label="Beri rating <%= star %> dari 5"
              aria-pressed="<%= Number(item.viewerReview?.rating||0) === star ? 'true' : 'false' %>"
            >★</button>
          <% }) %>
        </div>

        <textarea
          name="comment"
          rows="4"
          maxlength="100"
          placeholder="Tulis pengalaman Anda setelah membeli produk ini..."
          aria-label="Komentar ulasan"
        ><%= item.viewerReview?.comment || '' %></textarea>

        <button
          class="button button-primary button-block"
          type="submit"
        >
          <%- icon('device-floppy') %>
          <%= item.viewerReview
            ? 'Simpan perubahan'
            : 'Kirim ulasan'
          %>
        </button>
      </form>

    <% } %>
  </section>
<% } %>

</div>

<% }) %>
<% if(paymentDetailsMarkup && !paymentDetailsShown){ %>
  <div class="payment-details-shell">
    <%- paymentDetailsMarkup %>
  </div>
<% } %>
</div>
<aside class="summary-card">
<div class="recipient-order-summary">
  <div class="eyebrow">Kontak Penerima</div>
  <% if(order.recipient_email){ %>
    <div class="summary-row">
      <span>Email</span>
      <strong><%= order.recipient_email %></strong>
    </div>
    <div class="summary-row">
      <span>WhatsApp</span>
      <strong><%= order.recipient_dial_code||'' %><%= order.recipient_phone||'' %></strong>
    </div>
  <% } else { %>
    <span class="muted small">
      Kontak penerima tidak tersedia untuk order ini.
    </span>
  <% } %>
</div>

<div class="summary-row"> <span>Total</span> <strong><%= formatIDR(order.total) %></strong> </div> <div class="security-note"> <%- icon('shield-key-outline') %> <div> <strong>Akses aman</strong> <span> Akses file dan tautan diverifikasi server sebelum dibuka. Tautan file menggunakan akses sementara. </span> </div> </div> <a class="button button-secondary button-block" href="/delivery" > <%- icon('package') %> Produk Saya </a> </aside> </div> </section>
