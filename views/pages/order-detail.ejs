<% const contentTypeLabels = { FILE: 'File', IMAGE: 'Gambar', VIDEO: 'Video', AUDIO: 'Audio', TEXT: 'Teks', LINK: 'Tautan' }; const accessTypeLabels = { PURCHASED: 'Setelah pembelian', PUBLIC: 'Publik', PREVIEW: 'Pratinjau' }; %> <% const paymentDetailsMarkup = payment ? include('../partials/payment-details', { payment, heading: 'Rincian Pembayaran', orderNumber: order.order_number }) : ''; %>
<section class="page-shell" data-payment-review-order-detail="<%= req.query.review ? order.id : '' %>"> <div class="two-column"> <div class="order-download-panel"> <div class="panel order-detail-table-card">
<div class="section-header order-detail-table-heading">
  <div>
    <h2>Produk Digital</h2>
    <span class="badge badge-<%= String(order.status||'').toLowerCase() %>"><%= labelStatus(order.status) %></span>
  </div>
  <span class="payment-title-divider" aria-hidden="true"></span>
</div>
<div class="order-detail-table-summary">
  <div class="summary-row order-detail-table-row">
    <span>Nomor pesanan</span>
    <b># <%= order.order_number %></b>
  </div>

</div>



<% order.items.forEach(item=>{ %> <div class="section-header order-detail-table-product-row"> <span><%= item.variant_id ? (item.variant_label || '—') : item.product_name %></span> <b><%= item.quantity %> × <%= formatIDR(item.unit_price) %></b> </div> <div class="section-header order-detail-table-download-row"><span>Download Produk</span><b><%= (item.contents||[]).length %> item</b></div> <% }) %>
<div class="order-detail-table-summary">
  <div class="summary-row order-detail-table-row">
    <span>Tanggal dibuat</span>
    <b><%= formatDate(order.created_at) %></b>
  </div>
</div>
</div>
<% let paymentDetailsShown = false; %>
<% order.items.forEach(item=>{ %> <div class="section"> <div class="content-list order-detail-table-content-list"> <% if((item.contents||[]).length===0){ %><%- include('../partials/empty',{title:'Belum ada isi produk',description:'Belum ada isi produk yang ditambahkan untuk produk ini.'}) %><% } %> <% (item.contents||[]).forEach(c=>{ %> <article class="content-card"> <div class="content-main"><div class="order-item-content-meta"><% if(item.variant_icon_path || item.product_thumbnail_path){ %><img class="order-item-product-image" src="<%= assetUrl(publicAssetBucket,item.variant_icon_path || item.product_thumbnail_path) %>" alt="" width="44" height="44" loading="lazy" decoding="async"><% } %><div class="order-item-content-copy"><strong><%= item.variant_id ? (item.variant_label || item.product_name) : item.product_name %></strong><small><%= contentTypeLabels[c.type] || 'Konten' %> · <%= accessTypeLabels[c.access_type] || 'Akses terbatas' %></small></div></div>
<% if(c.description){ %> <p class="content-description"><%= c.description %></p> <% } %> <% if(c.type==='TEXT' && c.allowed){ %> <div class="content-text"><%= c.text_content || '' %></div> <% } else if(c.type==='TEXT'){ %> <div class="content-lock-note"> Konten tersedia setelah pembayaran terverifikasi. </div> <% } %> <% if(c.type==='FILE'){ %> <div class="file-meta content-extra-meta"> <span><%= c.mime_type || 'File' %></span> <span><%= c.file_size ? (Number(c.file_size)/1024/1024).toFixed(2)+' MB' : '—' %></span> </div> <% } %> </div> <div class="content-side"> <span class="badge order-item-content-status"> <%= c.allowed ? (c.is_preview ? 'Pratinjau' : 'Tersedia') : 'Terkunci' %> </span> <% if(!c.allowed && c.type!=='TEXT' && !(c.type==='LINK' && c.url)){ %> <span class="muted small content-side-note">Pembelian diperlukan</span> <% } %> </div> <div class="content-side-actions"> <% if(c.type==='LINK' && c.url && c.allowed){ %> <button class="button button-primary button-small" type="button" data-download-content="<%= c.id %>" > Buka </button> <% } %> <% if(c.preview_url && ['IMAGE','VIDEO','AUDIO'].includes(c.type)){ %> <button class="button button-secondary button-small" type="button" data-open-content-url="<%= c.preview_url %>"> Pratinjau </button> <% } %> <% if(c.allowed && ['FILE','IMAGE','VIDEO','AUDIO'].includes(c.type)){ %> <button class="button button-primary button-small" type="button" data-download-content="<%= c.id %>"> Akses </button> <% } %> </div> </article> <% }) %> </div>

<% if(paymentDetailsMarkup && !paymentDetailsShown){ %>
  <div class="payment-details-shell">
    <%- paymentDetailsMarkup %>
  </div>
  <% paymentDetailsShown = true; %>
<% } %>


</div>

<% }) %>
<% if(paymentDetailsMarkup && !paymentDetailsShown){ %>
  <div class="payment-details-shell">
    <%- paymentDetailsMarkup %>
  </div>
<% } %>
</div>
<aside class="summary-card">
<div class="recipient-order-summary">
  <div class="eyebrow">Kontak Penerima</div>
  <% if(order.recipient_email){ %>
    <div class="summary-row">
      <span>Email</span>
      <strong><%= order.recipient_email %></strong>
    </div>
    <div class="summary-row">
      <span>WhatsApp</span>
      <strong><%= order.recipient_dial_code||'' %><%= order.recipient_phone||'' %></strong>
    </div>
  <% } else { %>
    <span class="muted small">
      Kontak penerima tidak tersedia untuk order ini.
    </span>
  <% } %>
</div>

<div class="summary-row"> <span>Total</span> <strong><%= formatIDR(order.total) %></strong> </div> <div class="security-note"> <%- icon('shield-key-outline') %> <div> <strong>Akses aman</strong> <span> Akses file dan tautan diverifikasi server sebelum dibuka. Tautan file menggunakan akses sementara. </span> </div> </div> <a class="button button-secondary button-block" href="/delivery" > <%- icon('package') %> Produk Saya </a> </aside> </div> </section>
