<section class="page-shell"><div class="page-header"><div><h1>Produk populer</h1><p>Ranking produk berdasarkan performa pembelian. Bukan ranking user.</p></div></div><div class="ranking-list"><% items.forEach((p,i)=>{ %><article class="ranking-card">
  <span class="rank"><%= i+1 %></span>
  <div class="ranking-card-content">
    <div class="ranking-card-head">
      <strong class="ranking-product-name"><%= p.name %></strong>
      <span class="ranking-purchases"><%= p.purchase_count %> pembelian</span>
    </div>
    <div class="ranking-card-meta">
      <b class="ranking-price"><%= formatIDR(p.price) %></b>
      <span class="ranking-metrics">· <%= p.view_count %> views · <%= p.cart_add_count %> cart</span>
    </div>
  </div>
</article><% }) %><% if(!items.length){ %><%- include('../partials/empty',{title:'Belum ada data performa',description:'Ranking akan terisi dari event nyata.'}) %><% } %></div></section>
