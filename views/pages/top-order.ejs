<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Top Order</div><h1>Produk populer</h1><p>Ranking produk berdasarkan performa pembelian. Bukan ranking user.</p></div></div><div class="ranking-list"><% items.forEach((p,i)=>{ %><article class="ranking-card"><span class="rank"><%= i+1 %></span><div><strong><%= p.name %></strong><span><%= p.purchase_count %> pembelian · <%= p.view_count %> views · <%= p.cart_add_count %> cart</span></div><b><%= formatIDR(p.price) %></b></article><% }) %><% if(!items.length){ %><%- include('../partials/empty',{title:'Belum ada data performa',description:'Ranking akan terisi dari event nyata.'}) %><% } %></div></section>
