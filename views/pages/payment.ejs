<section class="page-shell narrow"><div class="page-header"><div><div class="eyebrow">Pembayaran</div><h1>Status pembayaran</h1><p>ID pembayaran <code><%= payment.id %></code></p></div><span
  class="badge badge-<%= String(payment.status||'').toLowerCase() %>"
  data-label-pending="<%= labelStatus('PENDING') %>"
  data-label-processing="<%= labelStatus('PROCESSING') %>"
  data-label-paid="<%= labelStatus('PAID') %>"
  data-label-failed="<%= labelStatus('FAILED') %>"
  data-label-expired="<%= labelStatus('EXPIRED') %>"
  data-label-refunded="<%= labelStatus('REFUNDED') %>"
  data-label-cancelled="<%= labelStatus('CANCELLED') %>"
><%= labelStatus(payment.status) %></span></div><div class="panel"><div class="summary-row"><span>Penyedia pembayaran</span><b><%= payment.provider %></b></div><div class="summary-row"><span>Referensi</span><b><%= payment.reference || '—' %></b></div><div class="summary-row"><span>Nominal</span><b><%= formatIDR(payment.amount) %></b></div><div class="summary-row"><span>Dibuat</span><b><%= formatDate(payment.created_at) %></b></div><p class="muted">Status final akan diperbarui oleh backend setelah callback/webhook provider tervalidasi.</p></div></section>

<script nonce="<%= cspNonce %>">
(()=>{
  const badge=document.querySelector('.badge');
  const note=document.querySelector('.panel .muted');

  const terminal=new Set([
    'PAID',
    'FAILED',
    'EXPIRED',
    'REFUNDED',
    'CANCELLED'
  ]);

  const initialStatus='<%= payment.status %>';

  let currentStatus=initialStatus;
  let stopped=false;
  let attempts=0;
  let delay=3000;
  let timer=null;
  let controller=null;

  const statusLabel=value=>{
    const key=String(value||'').toLowerCase();
    return badge?.getAttribute('data-label-'+key) || String(value||'—');
  };

  const stop=()=>{
    stopped=true;

    if(timer){
      clearTimeout(timer);
      timer=null;
    }

    controller?.abort();
    controller=null;
  };

  const schedule=()=>{
    if(stopped || document.hidden)return;

    if(timer)clearTimeout(timer);

    timer=setTimeout(()=>{
      timer=null;
      tick();
    },delay);
  };

  const tick=async()=>{
    if(
      stopped ||
      document.hidden ||
      terminal.has(currentStatus) ||
      attempts>=80
    ){
      if(attempts>=80 && !terminal.has(currentStatus) && note){
        note.textContent='Pembaruan otomatis dihentikan setelah batas waktu. Muat ulang halaman untuk memeriksa kembali.';
      }

      return;
    }

    attempts++;
    controller=new AbortController();

    try{
      const response=await fetch(
        '/api/payment/<%= payment.id %>',
        {
          credentials:'same-origin',
          headers:{'Accept':'application/json'},
          signal:controller.signal
        }
      );

      if(!response.ok){
        if([401,403,404].includes(response.status)){
          if(note){
            note.textContent='Status pembayaran tidak dapat diperbarui otomatis. Periksa halaman pesanan.';
          }

          stop();
          return;
        }

        delay=Math.min(Math.round(delay*1.5),15000);
        schedule();
        return;
      }

      const out=await response.json();
      const p=out.data||out;

      if(p.status){
        currentStatus=String(p.status).toUpperCase();

        if(badge){
          badge.textContent=statusLabel(currentStatus);
        }

        if(terminal.has(currentStatus)){
          stop();
          location.reload();
          return;
        }

        if(note){
          note.textContent='Status pembayaran diperbarui otomatis.';
        }

        delay=3000;
      }

      schedule();
    }catch(error){
      if(error?.name==='AbortError')return;

      delay=Math.min(Math.round(delay*1.5),15000);
      schedule();
    }finally{
      controller=null;
    }
  };

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden){
      if(timer){
        clearTimeout(timer);
        timer=null;
      }

      controller?.abort();
      return;
    }

    if(!stopped && !terminal.has(currentStatus)){
      delay=3000;
      tick();
    }
  });

  window.addEventListener('beforeunload',stop);

  if(!terminal.has(initialStatus)){
    tick();
  }
})();
</script>
