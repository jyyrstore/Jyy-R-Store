<% const paymentMode=String(payment.raw_reference?.paymentMode || (payment.raw_reference?.isTest===true ? 'SANDBOX' : 'LIVE')).toUpperCase(); %>
<% const sandboxResult=String(payment.raw_reference?._sandboxResult||'').toUpperCase(); %>
<% const paymentDisplayStatus=paymentMode==='SANDBOX' && sandboxResult ? sandboxResult : payment.status; %>
<% const paymentDisplayLabel=paymentMode==='SANDBOX' && sandboxResult ? (sandboxResult==='PAID' ? 'Berhasil (simulasi)' : labelStatus(sandboxResult)) : labelStatus(payment.status); %>
<section class="page-shell narrow"><div class="page-header"><div><h1>Status pembayaran</h1><p>ID pembayaran <code><%= payment.id %></code></p></div><span
  class="badge badge-<%= String(paymentDisplayStatus||'').toLowerCase() %>"
  data-label-pending="<%= labelStatus('PENDING') %>"
  data-label-processing="<%= labelStatus('PROCESSING') %>"
  data-label-paid="<%= labelStatus('PAID') %>"
  data-label-failed="<%= labelStatus('FAILED') %>"
  data-label-expired="<%= labelStatus('EXPIRED') %>"
  data-label-refunded="<%= labelStatus('REFUNDED') %>"
  data-label-cancelled="<%= labelStatus('CANCELLED') %>"
><%= paymentDisplayLabel %></span></div><div class="panel"><div class="summary-row"><span>Penyedia pembayaran</span><b><%= payment.provider %></b></div><div class="summary-row"><span>Mode pembayaran</span><b><%= paymentMode==='SANDBOX' ? 'Sandbox (simulasi)' : 'Live' %></b></div><% if(paymentMode==='SANDBOX' && sandboxResult){ %><div class="summary-row"><span>Hasil webhook Sandbox</span><b><%= sandboxResult==='PAID' ? 'Berhasil diterima (simulasi)' : labelStatus(sandboxResult) %></b></div><% } %><div class="summary-row"><span>Referensi</span><b><%= payment.reference || '—' %></b></div><div class="summary-row"><span>Nominal</span><b><%= formatIDR(payment.amount) %></b></div><div class="summary-row"><span>Dibuat</span><b><%= formatDate(payment.created_at) %></b></div><p class="muted">Status final akan diperbarui oleh backend setelah callback/webhook provider tervalidasi.</p></div>
<% const buatqrisImage = payment.raw_reference?.qr_url || payment.raw_reference?.qris_image || null; %>
<% const buatqrisPayLink = payment.raw_reference?.paymentUrl || payment.raw_reference?.payment_url || null; %>
<% if (String(payment.provider || '').toLowerCase() === 'buatqris') { %>
<div class="panel">
  <h2>QRIS BuatQris</h2>
  <% if (buatqrisImage) { %>
    <p>Scan QRIS menggunakan aplikasi pembayaran. Pastikan nominal tagihan sesuai.</p>
    <img src="<%= buatqrisImage %>" alt="QRIS pembayaran" width="260" height="260"
         style="display:block;max-width:100%;height:auto;margin:1rem auto">
  <% } else { %>
    <p>Gunakan halaman pembayaran BuatQris untuk menyelesaikan transaksi.</p>
  <% } %>
  <% if (buatqrisPayLink) { %>
    <p><a href="<%= buatqrisPayLink %>" target="_blank" rel="noopener noreferrer">Buka halaman pembayaran di tab baru</a></p>
  <% } else if (!buatqrisImage) { %>
    <p class="muted">Tautan dan gambar QRIS belum tersedia. Muat ulang halaman untuk memeriksa kembali.</p>
  <% } %>

  <% const sandboxTestFlag = payment.raw_reference?.isTest ?? payment.raw_reference?.is_test; %>
  <% const canSimulateSandbox = Boolean(
    req.profile?.role==='OWNER' &&
    paymentMode==='SANDBOX' &&
    String(payment.provider||'').toLowerCase()==='buatqris' &&
    String(payment.status||'').toUpperCase()==='PENDING' &&
    ['true','1','yes','test'].includes(String(sandboxTestFlag ?? '').toLowerCase()) &&
    payment.order_id &&
    payment.reference
  ); %>

  <% if (canSimulateSandbox) { %>
    <div class="sandbox-simulation" style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border)">
      <h3>Pengujian Owner</h3>
      <p class="muted">Tidak perlu membayar sungguhan. Simulasi berlaku hanya untuk pesanan Sandbox ini dan tidak memengaruhi stok atau omzet asli.</p>
      <button class="button button-secondary button-block" type="button" data-sandbox-simulate>
        Simulasikan pembayaran berhasil
      </button>
      <p class="muted small" data-sandbox-simulate-feedback aria-live="polite">Khusus Owner · transaksi Sandbox yang masih menunggu.</p>
    </div>
  <% } %>
</div>
<% } %>
</section>

<script nonce="<%= cspNonce %>">
(()=>{
  const badge=document.querySelector('.badge');
  const note=document.querySelector('.panel .muted');

  const terminal=new Set([
    'PAID',
    'FAILED',
    'EXPIRED',
    'REFUNDED',
    'CANCELLED'
  ]);

  const initialStatus='<%= payment.status %>';
  const orderId=<%- JSON.stringify(String(payment.order_id || '')) %>;
  const simulatePaymentId=<%- JSON.stringify(String(payment.id || '')) %>;
  const simulationButton=document.querySelector('[data-sandbox-simulate]');
  const simulationFeedback=document.querySelector('[data-sandbox-simulate-feedback]');

  let currentStatus=String(initialStatus||'').toUpperCase();
  let stopped=false;
  let attempts=0;
  let delay=3000;
  let timer=null;
  let controller=null;

  const statusLabel=value=>{
    const key=String(value||'').toLowerCase();
    return badge?.getAttribute('data-label-'+key) || String(value||'—');
  };

  const stop=()=>{
    stopped=true;

    if(timer){
      clearTimeout(timer);
      timer=null;
    }

    controller?.abort();
    controller=null;
  };

  const schedule=()=>{
    if(stopped || document.hidden)return;

    if(timer)clearTimeout(timer);

    timer=setTimeout(()=>{
      timer=null;
      tick();
    },delay);
  };

  const tick=async()=>{
    if(
      stopped ||
      document.hidden ||
      terminal.has(currentStatus) ||
      attempts>=80
    ){
      if(attempts>=80 && !terminal.has(currentStatus) && note){
        note.textContent='Pembaruan otomatis dihentikan setelah batas waktu. Muat ulang halaman untuk memeriksa kembali.';
      }

      return;
    }

    attempts++;
    controller=new AbortController();

    try{
      const response=await fetch(
        '/api/payment/<%= payment.id %>',
        {
          credentials:'same-origin',
          headers:{'Accept':'application/json'},
          signal:controller.signal
        }
      );

      if(!response.ok){
        if([401,403,404].includes(response.status)){
          if(note){
            note.textContent='Status pembayaran tidak dapat diperbarui otomatis. Periksa halaman pesanan.';
          }

          stop();
          return;
        }

        delay=Math.min(Math.round(delay*1.5),15000);
        schedule();
        return;
      }

      const out=await response.json();
      const p=out.data||out;

      if(p.status){
        currentStatus=String(p.status).toUpperCase();

        if(badge){
          badge.textContent=statusLabel(currentStatus);
        }

        if(terminal.has(currentStatus)){
          stop();

          if(currentStatus==='PAID' && orderId){
            if(note){
              note.textContent='Pembayaran berhasil dikonfirmasi. Mengalihkan ke pesanan…';
            }

            location.replace(
              '/orders?reviewOrder='+encodeURIComponent(orderId)
            );
            return;
          }

          // Status gagal/kedaluwarsa tetap ditampilkan di halaman ini.
          location.reload();
          return;
        }

        if(note){
          note.textContent='Status pembayaran diperbarui otomatis.';
        }

        delay=3000;
      }

      schedule();
    }catch(error){
      if(error?.name==='AbortError')return;

      delay=Math.min(Math.round(delay*1.5),15000);
      schedule();
    }finally{
      controller=null;
    }
  };

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden){
      if(timer){
        clearTimeout(timer);
        timer=null;
      }

      controller?.abort();
      return;
    }

    if(!stopped && !terminal.has(currentStatus)){
      delay=3000;
      tick();
    }
  });

  simulationButton?.addEventListener('click',async()=>{
    if(simulationButton.disabled)return;

    simulationButton.disabled=true;
    simulationButton.textContent='Memproses simulasi…';

    if(simulationFeedback){
      simulationFeedback.textContent='Meminta konfirmasi dari server…';
    }

    try{
      if(!window.JYYRApi?.request){
        throw new Error('API JYYR belum siap. Muat ulang halaman lalu coba kembali.');
      }

      const result=await window.JYYRApi.request(
        '/api/payment/'+encodeURIComponent(simulatePaymentId)+'/simulate',
        {method:'POST',body:{}}
      );

      if(
        String(result?.paymentStatus||'').toUpperCase()!=='PAID' ||
        String(result?.orderStatus||'').toUpperCase()!=='PAID'
      ){
        throw new Error('Server belum mengonfirmasi status PAID.');
      }

      currentStatus='PAID';

      if(badge){
        badge.textContent=statusLabel('PAID');
      }

      stop();

      if(simulationFeedback){
        simulationFeedback.textContent='Simulasi dikonfirmasi server. Mengalihkan ke pesanan…';
      }

      location.replace(
        '/orders?reviewOrder='+encodeURIComponent(orderId)
      );
    }catch(error){
      if(simulationFeedback){
        simulationFeedback.textContent=error?.message||'Simulasi gagal. Silakan coba lagi.';
      }

      simulationButton.disabled=false;
      simulationButton.textContent='Coba simulasi lagi';
    }
  });

  window.addEventListener('beforeunload',stop);

  // Status awal PAID hanya mengalihkan pembayaran yang terkait pesanan.
  if(currentStatus==='PAID' && orderId){
    location.replace(
      '/orders?reviewOrder='+encodeURIComponent(orderId)
    );
    return;
  }

  if(!terminal.has(currentStatus)){
    tick();
  }
})();
</script>
