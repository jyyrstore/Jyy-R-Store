<% const paymentMode=String(payment.raw_reference?.paymentMode || (payment.raw_reference?.isTest===true ? 'SANDBOX' : 'LIVE')).toUpperCase(); %>
<% const sandboxResult=String(payment.raw_reference?._sandboxResult||'').toUpperCase(); %>
<% const paymentDisplayStatus=paymentMode==='SANDBOX' && sandboxResult ? sandboxResult : payment.status; %>
<% const paymentDisplayLabel=paymentMode==='SANDBOX' && sandboxResult ? (sandboxResult==='PAID' ? 'Berhasil (simulasi)' : labelStatus(sandboxResult)) : labelStatus(payment.status); %>
<% const isBuatQris=String(payment.provider||'').toLowerCase()==='buatqris'; %>
<% const paymentBaseAmount=Number(payment.amount ?? 0); %>
<% const paymentTotalAmount=isBuatQris ? Number(payment.raw_reference?.totalAmount ?? payment.raw_reference?.total_amount ?? payment.amount ?? 0) : Number(payment.amount ?? 0); %>
<% const paymentServiceFee=isBuatQris ? Math.max(0, paymentTotalAmount-paymentBaseAmount) : 0; %>
<section class="page-shell narrow"><div class="page-header"><div><h1><%- icon('qris', 'icon payment-status-qris', 'QRIS') %></h1></div><span
  class="badge badge-<%= String(paymentDisplayStatus||'').toLowerCase() %>"
  data-label-pending="<%= labelStatus('PENDING') %>"
  data-label-processing="<%= labelStatus('PROCESSING') %>"
  data-label-paid="<%= labelStatus('PAID') %>"
  data-label-failed="<%= labelStatus('FAILED') %>"
  data-label-expired="<%= labelStatus('EXPIRED') %>"
  data-label-refunded="<%= labelStatus('REFUNDED') %>"
  data-label-cancelled="<%= labelStatus('CANCELLED') %>"
><%= paymentDisplayLabel %></span></div>
<% const buatqrisImage = payment.raw_reference?.qr_url || payment.raw_reference?.qris_image || null; %>
<% const buatqrisPayLink = payment.raw_reference?.paymentUrl || payment.raw_reference?.payment_url || null; %>
<% if (String(payment.provider || '').toLowerCase() === 'buatqris') { %>
<% const qrisExpiresAt = payment.expires_at && Number.isFinite(Date.parse(String(payment.expires_at))) ? new Date(payment.expires_at) : null; %>
<% if (qrisExpiresAt) { %>
<div class="qris-expiry-indicator"
     data-qris-expiry
     data-expires-at="<%= qrisExpiresAt.toISOString() %>"
     role="timer"
     aria-label="Sisa waktu pembayaran QRIS">
  <%- icon('timer', 'icon qris-expiry-clock') %>
  <strong data-qris-expiry-countdown>00.00</strong>
  <%- icon('hourglass', 'icon qris-expiry-hourglass') %>
</div>
<% } %>
<div class="panel qris-payment-card">
  <h2>QRIS ALL PAYMENT</h2><span class="payment-title-divider" aria-hidden="true"></span>
  <% if (buatqrisImage) { %>
    <p class="qris-instruction">SCAN QRIS UNTUK MENYELESAIKAN<br>PEMBAYARAN</p>
    <img src="<%= buatqrisImage %>" alt="QRIS pembayaran" width="260" height="260"
         style="display:block;max-width:100%;height:auto;margin:1rem auto">
    <p class="qris-amount"><strong>IDR <%= Number(paymentTotalAmount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></p>
  <% } else { %>
    <p>Gunakan halaman pembayaran BuatQris untuk menyelesaikan transaksi.</p>
  <% } %>
  <% if (payment.id) { %>
    <div class="qris-actions"
         data-qris-actions
         data-payment-link="<%= 'http://jyyrsh.my.id/payment/' + encodeURIComponent(String(payment.id || '')) %>"
         data-qris-image="<%= buatqrisImage || '' %>">
      <button class="button button-primary"
              type="button"
              data-qris-action="copy"
              aria-label="Salin link pembayaran"
              <%= payment.id ? '' : 'disabled' %>>
        <%- icon('copy', 'icon qris-action-icon') %>
        <span>Salin</span>
      </button>
      <button class="button button-primary"
              type="button"
              data-qris-action="share"
              aria-label="Bagikan link pembayaran"
              <%= payment.id ? '' : 'disabled' %>>
        <%- icon('share', 'icon qris-action-icon') %>
        <span>Bagikan</span>
      </button>
      <button class="button button-primary"
              type="button"
              data-qris-action="save"
              aria-label="Download QRIS"
              title="Download QRIS"
              <%= buatqrisImage ? '' : 'disabled' %>>
        <%- icon('download', 'icon qris-action-icon') %>
        <span>Save</span>
      </button>
    </div>
  <% } %>
  <% if (!buatqrisImage && !buatqrisPayLink) { %>
    <p class="muted">Tautan dan gambar QRIS belum tersedia. Muat ulang halaman untuk memeriksa kembali.</p>
  <% } %>

  <% const sandboxTestFlag = payment.raw_reference?.isTest ?? payment.raw_reference?.is_test; %>
  <% const canSimulateSandbox = Boolean(
    req.profile?.role==='OWNER' &&
    paymentMode==='SANDBOX' &&
    String(payment.provider||'').toLowerCase()==='buatqris' &&
    String(payment.status||'').toUpperCase()==='PENDING' &&
    ['true','1','yes','test'].includes(String(sandboxTestFlag ?? '').toLowerCase()) &&
    payment.order_id &&
    payment.reference
  ); %>

  <% if (canSimulateSandbox) { %>
    <div class="sandbox-simulation" style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border)">
      <h3>Pengujian Owner</h3>

      <button class="button button-secondary button-block" type="button" data-sandbox-simulate>
        Simulasikan pembayaran berhasil
      </button>
      <p class="muted small" data-sandbox-simulate-feedback aria-live="polite">Khusus Owner · transaksi Sandbox yang masih menunggu.</p>
    </div>
  <% } %>
</div>

<% } %>
<%- include('../partials/payment-details', { payment, heading: 'Rincian Pesanan' }) %>
<div class="panel">
  <h2>Payment</h2>
  <span class="payment-title-divider" aria-hidden="true"></span>
  <img
    class="payment-banner-image"
    src="<%= staticAsset('/images/banners/Banner-Payment.png') %>"
    alt="Payment"
    loading="lazy"
  >
</div>
</section>

<script nonce="<%= cspNonce %>">
(()=>{
  const badge=document.querySelector('.badge');
  const note=document.querySelector('[data-payment-status-note]');

  const qrisActions=document.querySelector('[data-qris-actions]');

  const qrisExpiry=document.querySelector('[data-qris-expiry]');
  const qrisExpiryCountdown=qrisExpiry?.querySelector('[data-qris-expiry-countdown]');
  const qrisExpiryDeadline=Date.parse(qrisExpiry?.dataset.expiresAt||'');
  let qrisExpiryTimer=null;

  const updateQrisExpiryCountdown=()=>{
    if(!qrisExpiry || !qrisExpiryCountdown)return;

    if(!Number.isFinite(qrisExpiryDeadline)){
      qrisExpiryCountdown.textContent='00.00';
      qrisExpiry.classList.add('is-expired');
      if(qrisExpiryTimer!==null){
        window.clearInterval(qrisExpiryTimer);
        qrisExpiryTimer=null;
      }
      return;
    }

    const remainingSeconds=Math.max(
      0,
      Math.ceil((qrisExpiryDeadline-Date.now())/1000)
    );

    if(remainingSeconds===0){
      qrisExpiryCountdown.textContent='00.00';
      qrisExpiry.classList.add('is-expired');
      if(qrisExpiryTimer!==null){
        window.clearInterval(qrisExpiryTimer);
        qrisExpiryTimer=null;
      }
      return;
    }

    qrisExpiry.classList.remove('is-expired');

    const minutes=Math.floor(remainingSeconds/60);
    const seconds=remainingSeconds%60;
    const pad=value=>String(value).padStart(2,'0');

    qrisExpiryCountdown.textContent=`${pad(minutes)}.${pad(seconds)}`;
  };

  if(qrisExpiryCountdown){
    updateQrisExpiryCountdown();
    if(Number.isFinite(qrisExpiryDeadline) && qrisExpiryDeadline>Date.now()){
      qrisExpiryTimer=window.setInterval(
        updateQrisExpiryCountdown,
        1000
      );
    }
  }

  if(qrisActions){
    const notify=(type,message)=>{
      window.JYYRToast?.[type]?.(message);
    };

    async function copyPaymentLink(value){
      if(navigator.clipboard?.writeText){
        try{
          await navigator.clipboard.writeText(value);
          return;
        }catch{
          // Lanjut ke fallback untuk browser yang menolak Clipboard API.
        }
      }

      const field=document.createElement('textarea');
      field.value=value;
      field.setAttribute('readonly','');
      field.style.position='fixed';
      field.style.opacity='0';
      field.style.pointerEvents='none';
      document.body.appendChild(field);
      field.select();

      let copied=false;
      try{
        copied=document.execCommand('copy');
      }finally{
        field.remove();
      }

      if(!copied){
        throw new Error('Browser tidak dapat menyalin link pembayaran.');
      }
    }

    async function downloadQrisImage(url){
      const response=await fetch(url,{
        mode:'cors',
        credentials:'omit'
      });

      if(!response.ok){
        throw new Error('Gambar QRIS gagal diunduh dari server.');
      }

      const blob=await response.blob();

      if(blob.type && !blob.type.toLowerCase().startsWith('image/')){
        throw new Error('Respons server bukan gambar QRIS.');
      }

      const mime=(blob.type || 'image/png')
        .toLowerCase()
        .split(';')[0];

      const extension={
        'image/png':'png',
        'image/jpeg':'jpg',
        'image/webp':'webp',
        'image/gif':'gif',
        'image/svg+xml':'svg'
      }[mime] || 'png';

      const objectUrl=URL.createObjectURL(blob);
      const downloadLink=document.createElement('a');
      downloadLink.href=objectUrl;
      downloadLink.download='qris-pembayaran.'+extension;
      downloadLink.hidden=true;
      document.body.appendChild(downloadLink);

      try{
        downloadLink.click();
      }finally{
        downloadLink.remove();
        window.setTimeout(
          ()=>URL.revokeObjectURL(objectUrl),
          1000
        );
      }
    }

    qrisActions.addEventListener('click',async event=>{
      const button=event.target.closest('[data-qris-action]');

      if(!button || button.disabled || !qrisActions.contains(button)){
        return;
      }

      const action=button.dataset.qrisAction;
      const paymentLink=qrisActions.dataset.paymentLink || '';
      const qrisImage=qrisActions.dataset.qrisImage || '';

      button.disabled=true;
      button.setAttribute('aria-busy','true');

      try{
        if(action==='copy'){
          if(!paymentLink){
            throw new Error('Link pembayaran belum tersedia.');
          }

          await copyPaymentLink(paymentLink);
          notify('success','Link pembayaran berhasil disalin.');
        }else if(action==='share'){
          if(!paymentLink){
            throw new Error('Link pembayaran belum tersedia.');
          }

          if(navigator.share){
            await navigator.share({
              title:"Jyy'R Store - Pembayaran",
              url:paymentLink
            });

            notify('success','Link pembayaran berhasil dibagikan.');
          }else{
            await copyPaymentLink(paymentLink);
            notify(
              'info',
              'Berbagi langsung tidak tersedia. Link pembayaran disalin.'
            );
          }
        }else if(action==='save'){
          if(!qrisImage){
            throw new Error('Gambar QRIS belum tersedia.');
          }

          await downloadQrisImage(qrisImage);
          notify('success','Unduhan QRIS dimulai.');
        }
      }catch(error){
        if(action==='share' && error?.name==='AbortError'){
          return;
        }

        if(action==='save'){
          notify(
            'error',
            'QRIS tidak dapat diunduh langsung. Periksa koneksi atau tekan lama gambar QRIS untuk menyimpannya.'
          );
        }else{
          notify(
            'error',
            error?.message || 'Aksi pembayaran gagal.'
          );
        }
      }finally{
        button.disabled=false;
        button.removeAttribute('aria-busy');
      }
    });
  }

  const terminal=new Set([
    'PAID',
    'FAILED',
    'EXPIRED',
    'REFUNDED',
    'CANCELLED'
  ]);

  const initialStatus='<%= payment.status %>';
  const orderId=<%- JSON.stringify(String(payment.order_id || '')) %>;
  const simulatePaymentId=<%- JSON.stringify(String(payment.id || '')) %>;
  const simulationButton=document.querySelector('[data-sandbox-simulate]');
  const simulationFeedback=document.querySelector('[data-sandbox-simulate-feedback]');

  let currentStatus=String(initialStatus||'').toUpperCase();
  let stopped=false;
  let delay=10000;
  let timer=null;
  let controller=null;

  const statusLabel=value=>{
    const key=String(value||'').toLowerCase();
    return badge?.getAttribute('data-label-'+key) || String(value||'—');
  };

  const stop=()=>{
    stopped=true;

    if(timer){
      clearTimeout(timer);
      timer=null;
    }

    controller?.abort();
    controller=null;
  };

  const schedule=()=>{
    if(stopped || document.hidden)return;

    if(timer)clearTimeout(timer);

    timer=setTimeout(()=>{
      timer=null;
      tick();
    },delay);
  };

  const tick=async()=>{
    if(
      stopped ||
      document.hidden ||
      terminal.has(currentStatus)
    ){
      return;
    }

    controller=new AbortController();

    try{
      const response=await fetch(
        '/api/payment/<%= payment.id %>',
        {
          credentials:'same-origin',
          headers:{'Accept':'application/json'},
          signal:controller.signal
        }
      );

      if(!response.ok){
        if([401,403,404].includes(response.status)){
          if(note){
            note.textContent='Status pembayaran tidak dapat diperbarui otomatis. Periksa halaman pesanan.';
          }

          stop();
          return;
        }

        delay=Math.min(Math.round(delay*1.5),30000);
        schedule();
        return;
      }

      const out=await response.json();
      const p=out.data||out;

      if(p.status){
        currentStatus=String(p.status).toUpperCase();

        if(badge){
          badge.textContent=statusLabel(currentStatus);
        }

        if(terminal.has(currentStatus)){
          stop();

          if(currentStatus==='PAID' && orderId){
            if(note){
              note.textContent='Pembayaran berhasil dikonfirmasi. Mengalihkan ke pesanan…';
            }

            location.replace(
              '/orders?reviewOrder='+encodeURIComponent(orderId)
            );
            return;
          }

          // Status gagal/kedaluwarsa tetap ditampilkan di halaman ini.
          location.reload();
          return;
        }

        if(note){
          note.textContent='Status pembayaran diperbarui otomatis.';
        }

        delay=10000;
      }

      schedule();
    }catch(error){
      if(error?.name==='AbortError')return;

      delay=Math.min(Math.round(delay*1.5),30000);
      schedule();
    }finally{
      controller=null;
    }
  };

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden){
      if(timer){
        clearTimeout(timer);
        timer=null;
      }

      controller?.abort();
      return;
    }

    if(!stopped && !terminal.has(currentStatus)){
      delay=10000;
      tick();
    }
  });

  simulationButton?.addEventListener('click',async()=>{
    if(simulationButton.disabled)return;

    simulationButton.disabled=true;
    simulationButton.textContent='Memproses simulasi…';

    if(simulationFeedback){
      simulationFeedback.textContent='Meminta konfirmasi dari server…';
    }

    try{
      if(!window.JYYRApi?.request){
        throw new Error('API JYYR belum siap. Muat ulang halaman lalu coba kembali.');
      }

      const result=await window.JYYRApi.request(
        '/api/payment/'+encodeURIComponent(simulatePaymentId)+'/simulate',
        {method:'POST',body:{}}
      );

      if(
        String(result?.paymentStatus||'').toUpperCase()!=='PAID' ||
        String(result?.orderStatus||'').toUpperCase()!=='PAID'
      ){
        throw new Error('Server belum mengonfirmasi status PAID.');
      }

      currentStatus='PAID';

      if(badge){
        badge.textContent=statusLabel('PAID');
      }

      stop();

      if(simulationFeedback){
        simulationFeedback.textContent='Simulasi dikonfirmasi server. Mengalihkan ke pesanan…';
      }

      location.replace(
        '/orders?reviewOrder='+encodeURIComponent(orderId)
      );
    }catch(error){
      if(simulationFeedback){
        simulationFeedback.textContent=error?.message||'Simulasi gagal. Silakan coba lagi.';
      }

      simulationButton.disabled=false;
      simulationButton.textContent='Coba simulasi lagi';
    }
  });

  window.addEventListener('beforeunload',()=>{
    stop();
    if(qrisExpiryTimer!==null){
      window.clearInterval(qrisExpiryTimer);
      qrisExpiryTimer=null;
    }
  });

  // Status awal PAID hanya mengalihkan pembayaran yang terkait pesanan.
  if(currentStatus==='PAID' && orderId){
    location.replace(
      '/orders?reviewOrder='+encodeURIComponent(orderId)
    );
    return;
  }

  if(!terminal.has(currentStatus)){
    tick();
  }
})();
</script>
