<section class="page-shell"><div class="page-header"><div><h1 class="page-title-with-icon"><%- icon('dialog-history','icon page-title-icon') %><span>Riwayat aktivitas</span></h1></div></div><div class="tabs" role="tablist"><button
  class="tab <%= activeHistoryTab==='orders'?'active':'' %>"
  data-tab-target="orders"
>
  Pesanan
</button><button
  class="tab <%= activeHistoryTab==='mutations'?'active':'' %>"
  data-tab-target="mutations"
>
  Transaksi Saldo
</button></div><section
  data-tab="orders"
  class="tab-panel <%= activeHistoryTab==='orders'?'active':'' %>"
><div class="stack-list"><% orders.forEach(o=>{ %><a class="list-card" href="/orders/<%= o.id %>"><div class="order-list-main"><% if(o.variant_icon_path || o.product_thumbnail_path){ %><img class="order-item-product-image" src="<%= assetUrl(publicAssetBucket,o.variant_icon_path || o.product_thumbnail_path) %>" alt="" width="44" height="44" loading="lazy" decoding="async"><% } %><div class="order-list-copy"><strong><%= o.order_number %></strong><span><%= o.variant_id ? (o.variant_label || o.product_name) : o.product_name %> × <%= o.quantity %></span></div></div><div class="align-right"><span class="badge badge-<%= String(o.status||'').toLowerCase() %>"><%= labelStatus(o.status) %></span><b><%= formatIDR(o.line_total) %></b></div></a><% }) %><% if(!orders.length){ %><%- include('../partials/empty',{title:'Belum ada pesanan',description:'Order akan muncul setelah checkout.'}) %><% } %>
<%- include('../partials/pagination',{
  pagination:ordersPagination,
  param:'ordersPage',
  query:{tab:'orders'}
}) %>
</div>
</section>

<section
  data-tab="mutations"
  class="tab-panel <%= activeHistoryTab==='mutations'?'active':'' %>"
><div class="stack-list"><% mutations.forEach(m=>{ %><div class="list-card history-mutation-card">
  <strong class="history-mutation-type"><%= labelStatus(m.type) %></strong>
  <b class="history-mutation-amount"><%= formatIDR(m.amount) %></b>
  <button class="history-mutation-reference history-mutation-reference-copy"
          type="button"
          data-history-reference-copy
          data-copy-value="<%= m.reference || '' %>"
          aria-label="Salin ID lengkap <%= m.reference || '' %>"
          title="Ketuk untuk menyalin ID lengkap"
          <%= m.reference ? '' : 'disabled' %>><%= String(m.reference || '—').length > 27 ? String(m.reference).slice(0, 27) + '...' : (m.reference || '—') %></button>
  <span class="history-mutation-balance">Saldo <%= formatIDR(m.balance_after) %></span>
  <span class="history-mutation-date"><%= new Intl.DateTimeFormat('id-ID', {day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Jakarta'}).format(new Date(m.created_at)) %>, <%= new Intl.DateTimeFormat('id-ID', {hour:'2-digit',minute:'2-digit',hourCycle:'h23',timeZone:'Asia/Jakarta'}).format(new Date(m.created_at)) %></span>
  <span class="history-mutation-zone">[ WIB ]</span>
</div><% }) %></div>
<%- include('../partials/pagination',{
  pagination:mutationsPagination,
  param:'mutationsPage',
  query:{tab:'mutations'}
}) %>
</section>

</section>
