<section class="page-shell"><div class="page-header"><div><div class="eyebrow">History</div><h1>Riwayat aktivitas</h1></div></div><div class="tabs" role="tablist"><button class="tab active" data-tab-target="orders">Pesanan</button><button class="tab" data-tab-target="mutations">Transaksi Saldo</button></div><section data-tab="orders" class="tab-panel active"><div class="stack-list"><% orders.forEach(o=>{ %><a class="list-card" href="/orders/<%= o.id %>"><div><strong><%= o.order_number %></strong><span><%= formatDate(o.created_at) %></span></div><div class="align-right"><b><%= formatIDR(o.total) %></b><span class="badge"><%= o.status %></span></div></a><% }) %></div></section><section data-tab="mutations" class="tab-panel"><div class="stack-list"><% mutations.forEach(m=>{ %><div class="list-card"><div><strong><%= m.type %></strong><span><%= formatDate(m.created_at) %> · <%= m.reference||'—' %></span></div><div class="align-right"><b><%= formatIDR(m.amount) %></b><span>Saldo <%= formatIDR(m.balance_after) %></span></div></div><% }) %></div></section></section>
