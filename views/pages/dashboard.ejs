<section class="page-shell"><div class="page-header"><div><div class="eyebrow">Dashboard</div><h1>Halo, <%= profile.username %></h1><p>Pantau pesanan, saldo, dan aktivitas akunmu.</p></div><a class="button button-secondary" href="/deposit"><%- icon('wallet') %> Deposit</a></div>
<div class="stat-grid"><div class="stat-card"><span>Total Pesanan</span><strong><%= profile.total_orders %></strong><small>Semua order</small></div><div class="stat-card"><span>Total Deposit</span><strong><%= formatIDR(profile.total_deposit) %></strong><small>Kumulatif berhasil</small></div><div class="stat-card"><span>Sisa Saldo</span><strong><%= formatIDR(profile.balance) %></strong><small>Wallet aktif</small></div></div>
<div class="two-column section"><div><div class="section-header"><h2>Pesanan terbaru</h2><a href="/orders">Lihat semua</a></div><div class="stack-list"><% orders.forEach(o=>{ %><a class="list-card" href="/orders/<%= o.id %>"><div><strong><%= o.order_number %></strong><span><%= o.items?.map(i=>i.product_name).join(', ') %></span></div><div class="align-right"><b><%= formatIDR(o.total) %></b><span class="badge badge-<%= o.status.toLowerCase() %>"><%= o.status %></span></div></a><% }) %><% if(!orders.length){ %><%- include('../partials/empty',{title:'Belum ada pesanan',description:'Mulai dari katalog produk.'}) %><% } %></div></div><div><div class="section-header"><h2>Aktivitas saldo</h2><a href="/history">Riwayat</a></div><div class="stack-list"><% mutations.forEach(m=>{ %><div class="list-card"><div><strong><%= m.type %></strong><span><%= m.reference || '—' %></span></div><div class="align-right"><b><%= formatIDR(m.amount) %></b><span><%= formatDate(m.created_at) %></span></div></div><% }) %><% if(!mutations.length){ %><%- include('../partials/empty',{title:'Belum ada transaksi',description:'Deposit atau pembelian akan tampil di sini.'}) %><% } %></div></div></div>
<section class="section"><div class="section-header"><h2>Layanan pilihan</h2><a href="/services">Semua layanan</a></div><div class="service-grid"><% services.forEach(s=>{ %><article class="service-card"><div><div class="eyebrow"><%= s.category||'Service' %></div><h3><%= s.name %></h3><p><%= s.description||'Service JyyR Store.' %></p></div><div class="service-footer"><b><%= formatIDR(s.price) %></b><a href="/services" class="text-link">Detail</a></div></article><% }) %></div></section>
</section>
