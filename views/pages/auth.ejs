<% if(mode==='login' || mode==='register'){ %>
<div class="auth-card auth-card-login">
  <section class="auth-login-aside">
    <a class="brand auth-login-brand" href="/">
      <span class="brand-mark"><%- icon('shop-twotone') %></span>
      <span>Jyyr Store</span>
    </a>

    <div class="auth-login-aside-copy">
      <h1><%= mode==='register' ? 'Mulai perjalanan Anda.' : 'Selamat datang kembali.' %></h1>
      <p><%= mode==='register' ? 'Buat akun untuk menjelajahi produk, mengelola wallet, dan mengikuti pesanan Anda.' : 'Masuk untuk melanjutkan belanja, mengelola wallet, dan mengakses pesanan Anda.' %></p>
    </div>

    <div class="auth-login-benefits">
      <div class="auth-login-benefit">
        <span class="auth-login-benefit-icon">
          <%- icon('shop-twotone') %>
        </span>
        <div>
          <strong>Semua aktivitas dalam satu akun</strong>
          <span>Produk, pesanan, wallet, dan layanan tetap terhubung.</span>
        </div>
      </div>

      <div class="auth-login-benefit">
        <span class="auth-login-benefit-icon">
          <%- icon('shield-key-outline') %>
        </span>
        <div>
          <strong>Akses akun yang terkontrol</strong>
          <span>Gunakan kredensial akun Anda untuk melanjutkan.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="auth-login-main">
    <div class="auth-login-heading">

      <h2><%= mode==='register' && verificationStep ? 'Verifikasi email' : mode==='register' ? 'Buat akun Anda' : 'Masuk ke akun Anda' %></h2>
      <p><%= mode==='register' && verificationStep ? 'Masukkan kode OTP 4 digit yang dikirim ke email Anda.' : mode==='register' ? 'Lengkapi data akun agar bisa mulai berbelanja.' : 'Gunakan email dan password yang terdaftar.' %></p>
    </div>

    <% if(error){ %>
      <div class="alert alert-error" role="alert">
        <%- icon('circle-alert') %>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if(success){ %>
      <div class="alert alert-success" role="status">
        <%- icon('circle-check') %>
        <span><%= success %></span>
      </div>
    <% } %>

    <form
      class="stack-form auth-login-form"
      data-auth-form="<%= mode %>"
      method="POST"
      action="<%= mode==='register' ? '/auth/register' : '/auth/login?next='+encodeURIComponent(nextPath || '/dashboard') %>"
      <% if(mode==='login'){ %>data-next="<%= nextPath || '/dashboard' %>"<% } %>
      <% if(mode==='register' && verificationStep){ %>hidden<% } %>
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
      <% if(mode==='register'){ %>
      <label class="field auth-login-field">
        <input
          name="username"
          autocomplete="username"
          placeholder=" "
          minlength="3"
          maxlength="32"
          required
        >
        <span class="auth-login-field-placeholder"><%- icon('user') %> Username</span>
      </label>
      <% } %>

      <% if(mode==='login'){ %>
      <label class="field auth-login-field">
        <input
          type="email"
          name="email"
          autocomplete="email"
          placeholder=" "
          required
        >
        <span class="auth-login-field-placeholder"><%- icon('envelope') %> Email</span>
      </label>

      <label class="field auth-login-field">
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder=" "
          required
        >
        <span class="auth-login-field-placeholder"><%- icon('lock') %> Password</span>
      </label>
      <% } else { %>
      <label class="field auth-login-field">
        <input
          type="email"
          name="email"
          autocomplete="email"
          placeholder=" "
          required
        >
        <span class="auth-login-field-placeholder"><%- icon('envelope') %> Email</span>
      </label>

      <label class="field auth-login-field">
        <input
          type="password"
          name="password"
          autocomplete="new-password"
          placeholder=" "
          minlength="8"
          required
        >
        <span class="auth-login-field-placeholder"><%- icon('lock') %> Password</span>
      </label>
      <% } %>

      <% if(mode==='login'){ %>
      <div class="auth-login-meta">
        <label class="auth-login-remember">
          <input type="checkbox" name="rememberMe" value="true">
          <span>Ingat saya</span>
        </label>
        <a href="/auth/forgot-password">Lupa Password?</a>
      </div>
      <% } %>

      <button type="submit" class="button button-primary button-block auth-login-submit">
        <%= mode==='register' ? 'Daftar' : 'Masuk' %>
      </button>
    </form>

    <% if(mode==='register'){ %>
    <section
      class="auth-register-verification"
      data-register-verification
      <%= verificationStep ? '' : 'hidden' %>
    >
      <p class="auth-register-verification-copy">
        Kode OTP 4 digit dikirim ke
        <strong data-register-verification-email><%= verificationEmail || 'email Anda' %></strong>.
        Kode berlaku selama 10 menit.
      </p>

      <div
        class="alert alert-error"
        data-register-feedback
        role="alert"
        hidden
      ></div>

      <form
        class="stack-form auth-login-form"
        data-auth-form="verify"
        method="POST"
        action="/auth/verify-email"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <input
          type="hidden"
          name="email"
          value="<%= verificationEmail || '' %>"
          data-register-email
        >
        <input type="hidden" value="" data-otp-code>

        <label class="field">
          <span>OTP 4 digit</span>
          <input
            type="text"
            name="code"
            data-otp-fallback
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{4}"
            minlength="4"
            maxlength="4"
            placeholder="Masukkan kode OTP"
            required
          >

          <div
            class="auth-otp-fields"
            data-otp-fields
            hidden
            role="group"
            aria-label="Masukkan empat digit kode OTP"
          >
            <input
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{1,4}"
              maxlength="4"
              data-otp-digit
              aria-label="Digit OTP 1"
            >
            <input
              type="text"
              inputmode="numeric"
              autocomplete="off"
              pattern="[0-9]"
              maxlength="1"
              data-otp-digit
              aria-label="Digit OTP 2"
            >
            <input
              type="text"
              inputmode="numeric"
              autocomplete="off"
              pattern="[0-9]"
              maxlength="1"
              data-otp-digit
              aria-label="Digit OTP 3"
            >
            <input
              type="text"
              inputmode="numeric"
              autocomplete="off"
              pattern="[0-9]"
              maxlength="1"
              data-otp-digit
              aria-label="Digit OTP 4"
            >
          </div>
        </label>

        <button
          type="submit"
          class="button button-primary button-block auth-login-submit"
        >
          Verifikasi dan masuk
        </button>
      </form>

      <form
        class="stack-form auth-login-form auth-register-resend"
        data-auth-form="resend"
        method="POST"
        action="/auth/resend-email-otp"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <input
          type="hidden"
          name="email"
          value="<%= verificationEmail || '' %>"
          data-register-email
        >

        <button type="submit" class="button button-secondary button-block">
          Kirim ulang OTP
        </button>
      </form>
    </section>
    <% } %>

    <a
      class="button button-block auth-google-button"
      data-register-google
      <% if(mode==='register' && verificationStep){ %>hidden<% } %>
      href="<%= mode==='register' ? '/auth/google?next=/dashboard' : '/auth/google?next='+encodeURIComponent(nextPath || '/dashboard') %>"
    >
      <img
        class="auth-google-logo"
        src="<%= staticAsset('/images/branding/google-g-logo.svg') %>"
        alt=""
        aria-hidden="true"
      >
      <span><%= mode==='register' ? 'Daftar dengan Google' : 'Lanjutkan dengan Google' %></span>
    </a>

    <div
      class="auth-login-register"
      data-register-links
      <% if(mode==='register' && verificationStep){ %>hidden<% } %>
    >
      <% if(mode==='register'){ %>
        Sudah punya akun?
        <a href="/auth/login">Masuk</a>
      <% } else { %>
        Belum punya akun?
        <a href="/auth/register">Buat akun baru</a>
      <% } %>
    </div>

    <p
      class="auth-login-note"
      data-register-note
      <% if(mode==='register' && verificationStep){ %>hidden<% } %>
    >
      <%- icon('shield-key-outline') %>
      <span>Jangan bagikan password akun Anda kepada orang lain.</span>
    </p>
  </section>
</div>

<% } else { %>

<div class="auth-card">
  <a class="brand brand-center" href="/">
    <span class="brand-mark"><%- icon('shop-twotone') %></span>
    <span>Jyyr Store</span>
  </a>

  <% if(error){ %>
    <div class="alert alert-error">
      <%- icon('circle-alert') %>
      <span><%= error %></span>
    </div>
  <% } %>
  <% if(success){ %>
    <div class="alert alert-success" role="status">
      <%- icon('circle-check') %>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if(mode==='forgot'){ %>

    <h1>Reset password</h1>
    <p>Kami akan mengirim instruksi ke email akun.</p>

    <form class="stack-form" data-auth-form="forgot" method="POST" action="/auth/forgot-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
      <label class="field">
        <span>Email</span>
        <input
          type="email"
          name="email"
          required
        >
      </label>

      <button type="submit" class="button button-primary button-block">
        Kirim
      </button>
    </form>

    <div class="auth-links">
      <a href="/auth/login">Kembali ke login</a>
    </div>

  <% } else { %>

    <h1>Password baru</h1>

    <form class="stack-form" data-auth-form="reset" method="POST" action="/auth/reset-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
      <label class="field">
        <span>Password baru</span>
        <input
          type="password"
          name="password"
          minlength="8"
          required
        >
      </label>

      <button type="submit" class="button button-primary button-block">
        Simpan password
      </button>
    </form>

  <% } %>
</div>

<% } %>
