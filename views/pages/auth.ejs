<div class="auth-card"><a class="brand brand-center" href="/"><span class="brand-mark"><%- icon('package') %></span><span>Jyy'R Store</span></a><% if(error){ %><div class="alert alert-error"><%- icon('alert') %><span><%= error %></span></div><% } %><% if(mode==='login'){ %><h1>Masuk</h1><p>Gunakan akun Jyy'R Store.</p><form class="stack-form" data-auth-form="login"><label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label><label class="field"><span>Password</span><input type="password" name="password" autocomplete="current-password" required></label><button class="button button-primary button-block">Masuk</button></form><div class="auth-links"><a href="/auth/forgot-password">Lupa password?</a><a href="/auth/register">Buat akun</a></div><% } else if(mode==='register'){ %><h1>Buat akun</h1><p>Daftar untuk membeli produk dan menggunakan wallet.</p><form class="stack-form" data-auth-form="register"><label class="field"><span>Username</span><input name="username" required minlength="3" maxlength="32"></label><label class="field"><span>Email</span><input type="email" name="email" required></label><label class="field"><span>Password</span><input type="password" name="password" minlength="8" required></label><button class="button button-primary button-block">Daftar</button></form><div class="auth-links"><a href="/auth/login">Sudah punya akun?</a></div><% } else if(mode==='forgot'){ %><h1>Reset password</h1><p>Kami akan mengirim instruksi ke email akun.</p><form class="stack-form" data-auth-form="forgot"><label class="field"><span>Email</span><input type="email" name="email" required></label><button class="button button-primary button-block">Kirim</button></form><div class="auth-links"><a href="/auth/login">Kembali ke login</a></div><% } else { %><h1>Password baru</h1><form class="stack-form" data-auth-form="reset"><label class="field"><span>Password baru</span><input type="password" name="password" minlength="8" required></label><button class="button button-primary button-block">Simpan password</button></form><% } %></div>
