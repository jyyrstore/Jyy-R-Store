<section class="page-shell notifications-page" data-notifications-page>
  <div class="page-header">
    <div>
      <div class="eyebrow">Notifikasi</div>
      <h1>Notifikasi</h1>
    </div>

    <% if(notifications.length){ %>
      <div class="header-actions">
        <button
          class="button button-secondary"
          type="button"
          data-notification-select-mode
          aria-pressed="false">
          <%- icon('layers') %>
          Pilih
        </button>

        <button
          class="button button-secondary"
          type="button"
          data-notification-select-all
          data-notification-selection-control
          aria-pressed="false"
          hidden>
          <%- icon('check') %>
          <span data-notification-selection-label>Pilih semua</span>
        </button>

        <button
          class="button button-secondary"
          type="button"
          data-notification-read-all>
          <%- icon('check') %>
          Tandai semua telah dibaca
        </button>

        <button
          class="button button-danger"
          type="button"
          data-notification-delete-selected
          data-notification-selection-control
          disabled
          hidden>
          <%- icon('trash-can') %>
          Hapus pesan yang dipilih
        </button>

        <button
          class="button button-danger"
          type="button"
          data-notification-delete-all>
          <%- icon('trash-can') %>
          Hapus semua pesan
        </button>
      </div>
    <% } %>
  </div>
  <div class="stack-list"><% notifications.forEach(n=>{ %><article class="notification-card \1" data-notification-id="<%= n.id %>">
  <label class="notification-select">
    <input
      type="checkbox"
      data-notification-select
      value="<%= n.id %>"
      aria-label="Pilih notifikasi <%= n.title %>">
  </label>
  <div class="content-icon">
    <%- icon(
      n.type==='PAYMENT'
        ? 'check'
        : n.type==='TICKET'
          ? 'ticket'
          : n.type==='ORDER'
            ? 'clipboard-list'
            : n.type==='DEPOSIT'
              ? 'deposit'
              : n.type==='SYSTEM'
                ? 'server'
                : n.type==='PROMOTION'
                  ? 'trophy'
                  : 'info'
    ) %>
  </div>

  <div class="notification-content">
    <div class="notification-head">
      <strong><%= n.title %></strong>
      <time datetime="<%= n.created_at %>"><%= formatDate(n.created_at) %></time>
    </div>

    <p><%= n.body %></p>
  </div>

  <% if(n.link || !n.is_read){ %>
    <div class="inline-actions">
      <% if(n.link){ %>
        <a class="button button-secondary button-small" href="<%= n.link %>">Buka</a>
      <% } %>

      <% if(!n.is_read){ %>
        <button
          class="button button-secondary button-small"
          type="button"
          aria-label="Tandai notifikasi sebagai dibaca"
          data-read-notification="<%= n.id %>">
          Tandai dibaca
        </button>
      <% } %>
    </div>
  <% } %>
</article><% }) %><% if(!notifications.length){ %><%- include('../partials/empty',{title:'Tidak ada notifikasi',description:'Notifikasi order, pembayaran, dan support akan tampil di sini.'}) %><% } %>
<%- include('../partials/pagination',{
  pagination:notificationsPagination,
  param:'page'
}) %>
</div></section>
