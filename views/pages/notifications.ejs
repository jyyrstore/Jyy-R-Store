<section class="page-shell notifications-page" data-notifications-page>
  <div class="page-header">
    <div>

      <h1>Notifikasi</h1>
    </div>

    <% if(notifications.length){ %>
      <div class="header-actions">
        <button
          class="button button-secondary notification-action-button"
          type="button"
          data-notification-select-mode
          aria-label="Pilih notifikasi"
          title="Pilih notifikasi"
          aria-pressed="false">
          <%- icon('layers') %>
        </button>

        <button
          class="button button-secondary notification-action-button"
          type="button"
          data-notification-select-all
          data-notification-selection-control
          aria-label="Pilih semua"
          title="Pilih semua"
          aria-pressed="false"
          hidden>
          <%- icon('list-check') %>
        </button>

        <button
          class="button button-secondary notification-action-button"
          type="button"
          data-notification-read-all
          aria-label="Tandai semua telah dibaca"
          title="Tandai semua telah dibaca"
          hidden>
          <%- icon('mail-check') %>
        </button>

        <button
          class="button button-danger notification-action-button"
          type="button"
          data-notification-delete-selected
          data-notification-selection-control
          aria-label="Hapus notifikasi yang dipilih"
          title="Hapus notifikasi yang dipilih"
          disabled
          hidden>
          <%- icon('trash-check') %>
        </button>

        <button
          class="button button-danger notification-action-button"
          type="button"
          data-notification-delete-all
          aria-label="Hapus semua notifikasi"
          title="Hapus semua notifikasi"
          hidden>
          <%- icon('trash-can') %>
        </button>
      </div>
    <% } %>
  </div>
  <div class="stack-list"><% notifications.forEach(n=>{ %><article class="notification-card <%= n.is_read ? '' : 'unread' %>" data-notification-id="<%= n.id %>" data-notification-link="<%= n.link || '' %>">
  <label class="notification-select">
    <input
      type="checkbox"
      data-notification-select
      value="<%= n.id %>"
      aria-label="Pilih notifikasi <%= n.title %>">
  </label>
  <div class="content-icon">
    <%- icon(
      n.type==='PAYMENT'
        ? 'check'
        : n.type==='TICKET'
          ? 'ticket'
          : n.type==='ORDER'
            ? 'clipboard-list'
            : n.type==='DEPOSIT'
              ? 'deposit'
              : n.type==='SYSTEM'
                ? 'server'
                : n.type==='PROMOTION'
                  ? 'trophy'
                  : 'info'
    ) %>
  </div>

  <div class="notification-content">
    <div class="notification-head">
      <strong><%= n.title %></strong>
      <time datetime="<%= n.created_at %>"><%= formatDate(n.created_at) %></time>
    </div>

    <p><%= n.body %></p>
  </div>

  <% if(!n.is_read){ %>
    <div class="inline-actions">
      <% if(!n.is_read){ %>
        <button
          class="button button-secondary button-small"
          type="button"
          aria-label="Tandai notifikasi sebagai dibaca"
          data-read-notification="<%= n.id %>">
          Tandai dibaca
        </button>
      <% } %>
    </div>
  <% } %>
</article><% }) %><% if(!notifications.length){ %><%- include('../partials/empty',{title:'Tidak ada notifikasi',description:'Notifikasi order, pembayaran, dan support akan tampil di sini.'}) %><% } %>
<%- include('../partials/pagination',{
  pagination:notificationsPagination,
  param:'page'
}) %>
</div></section>
