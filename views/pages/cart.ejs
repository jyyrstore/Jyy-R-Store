<section class="page-shell">
  <% const cartItemCount=(cart.items||[]).reduce((sum,item)=>sum+Number(item.quantity||0),0); %>
  <div class="page-header">
    <div>
      <div class="eyebrow">Keranjang</div>
      <h1>Keranjang <span class="muted small">(<%= cartItemCount %> item)</span></h1>
      <p>Periksa produk sebelum lanjut ke pembayaran.</p>
    </div>
    <div class="cart-header-actions">
      <a href="/store" class="button button-secondary">Lanjut belanja</a>
      <% if(cart.items.length){ %>
        <button
          class="button button-secondary cart-clear-button"
          type="button"
          data-cart-clear
        >Kosongkan keranjang</button>
      <% } %>
    </div>
  </div>

  <div class="cart-layout">
    <div class="stack-list">
      <% cart.items.forEach(i=>{ %>
        <article
          class="cart-item"
          data-cart-item="<%= i.id %>"
        >
          <% if(i.thumbnail_path){ %>
            <img
              src="<%= assetUrl(publicAssetBucket,i.thumbnail_path) %>"
              alt="<%= i.name %>"
            >
          <% } else { %>
            <div class="cart-thumb image-fallback">
              <%- icon('image') %>
            </div>
          <% } %>

          <div class="cart-main">
            <a href="/product/<%= i.slug %>">
              <strong><%= i.name %></strong>
            </a>

            <span><%= formatIDR(i.price) %> / item</span>

            <div class="quantity">
              <button
                class="icon-button"
                data-cart-minus="<%= i.id %>"
                aria-label="Kurangi jumlah"
                type="button"
              ><%- icon('minus') %></button>

              <span aria-live="polite"><%= i.quantity %></span>

              <button
                class="icon-button"
                data-cart-plus="<%= i.id %>"
                aria-label="Tambah jumlah"
                type="button"
              ><%- icon('plus') %></button>
            </div>
          </div>

          <div class="align-right">
            <b data-cart-line-total><%= formatIDR(i.lineTotal) %></b>
            <button
              class="icon-button danger"
              data-cart-remove="<%= i.id %>"
              aria-label="Hapus"
              type="button"
            ><%- icon('trash-can') %></button>
          </div>
        </article>
      <% }) %>

      <% if(!cart.items.length){ %>
        <%- include('../partials/empty',{
          title:'Keranjang masih kosong',
          description:'Tambahkan produk dari store.',
          cta:'/store',
          ctaText:'Buka Store'
        }) %>
      <% } %>
    </div>


      <section class="recipient-contact-card">
          <div class="recipient-contact-header">
            <div>
              <div class="eyebrow">Kontak Penerima</div>
              <h2>Kontak Penerima</h2>
              <p class="muted small">
                Kontak ini digunakan untuk informasi pesanan dan komunikasi admin.
              </p>
            </div>
          </div>

          <form data-recipient-contact-form class="stack-form">
            <label class="field">
              <span>Email Penerima</span>
              <input
                type="email"
                name="email"
                value="<%= cart.recipientContact?.email||'' %>"
                placeholder="Email@gmail.com"
                maxlength="254"
                autocomplete="email"
                required
              >
              <small>
                Diperlukan untuk mengirim informasi pesanan melalui email.
                Pastikan email Anda aktif, dapat menerima pesan, dan storage email
                tidak penuh.
              </small>
            </label>

            <% const countryFlag=(code)=>String(code||'').toUpperCase().split('').map(char=>String.fromCodePoint(127397+char.charCodeAt(0))).join(''); %>

            <%
              const selectedRecipientCountry =
                (recipientCountries||[]).find(
                  country=>country.code===(cart.recipientContact?.countryCode||'ID')
                ) ||
                (recipientCountries||[])[0] ||
                {code:'ID',name:'Indonesia',dialCode:'+62'};
            %>

            <label class="field recipient-country-field">
              <span>Nomor WhatsApp</span>

              <input
                type="hidden"
                name="countryCode"
                data-recipient-country
                value="<%= selectedRecipientCountry.code %>"
              >

              <button
                type="button"
                class="recipient-country-trigger"
                data-recipient-country-trigger
                aria-haspopup="dialog"
              >
                <span data-recipient-country-label>
                  <%= selectedRecipientCountry.name %> <%= countryFlag(selectedRecipientCountry.code) %>
                </span>
                <span class="recipient-country-trigger-arrow" aria-hidden="true">⌄</span>
              </button>

              <template data-recipient-country-options>
                <% (recipientCountries||[]).forEach(country=>{ %>
                  <button
                    type="button"
                    class="recipient-country-option<%= country.code===selectedRecipientCountry.code ? ' is-active' : '' %>"
                    data-recipient-country-option
                    data-country-code="<%= country.code %>"
                    data-dial-code="<%= country.dialCode %>"
                    data-country-name="<%= country.name %>"
                    data-country-flag="<%= countryFlag(country.code) %>"
                    aria-selected="<%= country.code===selectedRecipientCountry.code ? 'true' : 'false' %>"
                  >
                    <span>
                      <%= country.name %> <%= countryFlag(country.code) %>
                    </span>
                    <strong><%= country.dialCode %></strong>
                  </button>
                <% }) %>
              </template>
            </label>

            <div class="recipient-phone-row">
              <div class="recipient-dial-field">
                <div class="recipient-dial-code" data-recipient-dial-code>
                  <strong><%= cart.recipientContact?.dialCode||'+62' %></strong>
                </div>
              </div>

              <label class="field recipient-phone-field">
                <input
                  type="tel"
                  name="phone"
                  value="<%= cart.recipientContact?.phone||'' %>"
                  placeholder="Nomor WhatsApp"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  maxlength="14"
                  pattern="[1-9][0-9]{5,13}"
                  required
                >
              </label>
            </div>

            <small>
              Pilih negara, lalu isi nomor tanpa angka 0 di depan
              agar admin bisa menghubungi Anda via WhatsApp saat ada kendala pesanan.
            </small>

            <div class="recipient-contact-actions">
              <button class="button button-primary" type="submit">
                <%- icon('device-floppy') %>
                Simpan kontak
              </button>
            </div>
          </form>
        </section>

<aside class="summary-card">
      <div class="eyebrow">Ringkasan pesanan</div>

      <div class="summary-row">
        <span>Subtotal</span>
        <strong data-cart-summary-total><%= formatIDR(cart.total) %></strong>
      </div>

      <% if(cart.items.length){ %>
        <a class="button button-primary button-block" href="/checkout" data-cart-checkout>
          Lanjut ke pembayaran
        </a>
      <% } else { %>
        <button class="button button-primary button-block" type="button" disabled>
          Lanjut ke pembayaran
        </button>
      <% } %>
    </aside>
  </div>
</section>
