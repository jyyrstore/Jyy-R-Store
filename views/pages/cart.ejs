<section class="page-shell">
  <% const cartItemCount=(cart.items||[]).reduce((sum,item)=>sum+Number(item.quantity||0),0); %>
  <div class="page-header">
    <div>
      <div class="eyebrow">Keranjang</div>
      <h1>Keranjang <span class="muted small">(<%= cartItemCount %> item)</span></h1>
      <p>Periksa produk sebelum lanjut ke pembayaran.</p>
    </div>
    <div class="cart-header-actions">
      <a href="/store" class="button button-secondary">Lanjut belanja</a>
      <% if(cart.items.length){ %>
        <button
          class="button button-secondary cart-clear-button"
          type="button"
          data-cart-clear
        >Kosongkan keranjang</button>
      <% } %>
    </div>
  </div>

  <div class="cart-layout">
    <div class="stack-list">
      <% cart.items.forEach(i=>{ %>
        <article
          class="cart-item"
          data-cart-item="<%= i.id %>"
        >
          <% if(i.thumbnail_path){ %>
            <img
              src="<%= assetUrl(publicAssetBucket,i.thumbnail_path) %>"
              alt="<%= i.name %>"
            >
          <% } else { %>
            <div class="cart-thumb image-fallback">
              <%- icon('image') %>
            </div>
          <% } %>

          <div class="cart-main">
            <a href="/product/<%= i.slug %>">
              <strong><%= i.name %></strong>
            </a>

            <span><%= formatIDR(i.price) %> / item</span>

            <div class="quantity">
              <button
                class="icon-button"
                data-cart-minus="<%= i.id %>"
                aria-label="Kurangi jumlah"
                type="button"
              ><%- icon('minus') %></button>

              <span aria-live="polite"><%= i.quantity %></span>

              <button
                class="icon-button"
                data-cart-plus="<%= i.id %>"
                aria-label="Tambah jumlah"
                type="button"
              ><%- icon('plus') %></button>
            </div>
          </div>

          <div class="align-right">
            <b data-cart-line-total><%= formatIDR(i.lineTotal) %></b>
            <button
              class="icon-button danger"
              data-cart-remove="<%= i.id %>"
              aria-label="Hapus"
              type="button"
            ><%- icon('trash-can') %></button>
          </div>
        </article>
      <% }) %>

      <% if(!cart.items.length){ %>
        <%- include('../partials/empty',{
          title:'Keranjang masih kosong',
          description:'Tambahkan produk dari store.',
          cta:'/store',
          ctaText:'Buka Store'
        }) %>
      <% } %>
    </div>

    <aside class="summary-card">
      <div class="eyebrow">Ringkasan pesanan</div>

      <div class="summary-row">
        <span>Subtotal</span>
        <strong data-cart-summary-total><%= formatIDR(cart.total) %></strong>
      </div>

      <% if(cart.items.length){ %>
        <a class="button button-primary button-block" href="/checkout">
          Lanjut ke pembayaran
        </a>
      <% } else { %>
        <button class="button button-primary button-block" type="button" disabled>
          Lanjut ke pembayaran
        </button>
      <% } %>
    </aside>
  </div>
</section>
