<footer class="site-footer" aria-label="Footer">
  <div class="site-footer-brand">
    <strong>Jyyr Store</strong>
    <p>Toko digital terpercaya untuk berbagai produk, layanan, pembayaran, serta kebutuhan akses digital yang aman dan praktis.</p>
  </div>

  <div class="site-footer-divider" aria-hidden="true"></div>

  <section class="site-footer-social" aria-labelledby="footer-social-title">
    <h2 id="footer-social-title">Social Media</h2>

    <div class="site-footer-social-links">
      <% for (const [,label,url,iconName] of (socialLinks || [])) { %>
        <a
          class="site-footer-social-link"
          href="<%= url %>"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="<%= label %>"
          title="<%= label %>"
        >
          <%- icon(iconName, 'site-footer-social-icon', label) %>
        </a>
      <% } %>
    </div>

    <p class="site-footer-social-text">
      <strong>Stay connected with Jyyr Store</strong>
      <span>update, info, dan promo terbaru ada di sini.</span>
    </p>
  </section>

  <div class="site-footer-divider" aria-hidden="true"></div>

  <div class="site-footer-links">
    <nav class="footer-group site-footer-products" aria-labelledby="footer-products">
      <h2 id="footer-products">Produk</h2>
      <ul>
        <li><a href="/store">Semua produk</a></li>
        <li><a href="/search">Cari produk</a></li>
        <li><a href="/store">Daftar Harga</a></li>
      </ul>
    </nav>

    <nav class="footer-group site-footer-help" aria-labelledby="footer-help">
      <h2 id="footer-help">Bantuan</h2>
      <ul>
        <li><a href="/tickets">Hubungi Kami</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/orders">Cek Transaksi</a></li>
      </ul>
    </nav>

    <nav class="footer-group site-footer-legal" aria-labelledby="footer-legal">
      <h2 id="footer-legal">Legal</h2>
      <ul>
        <li><a href="/services">Layanan</a></li>
        <li><a href="/terms">Ketentuan</a></li>
        <li><a href="/privacy">Kebijakan Privasi</a></li>
        <li><a href="/dmca">DMCA / Hak Cipta</a></li>
      </ul>
    </nav>
  </div>

  <div class="site-footer-bottom">
    © <%= new Date().getFullYear() %> Jyyr Store • All rights reserved.<br>
    All trademarks belong to their respective owners.
  </div>
</footer>
