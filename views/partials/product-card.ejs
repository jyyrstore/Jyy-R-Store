<% const stock = Number(product.stock) || 0; %>
<article class="product-card" data-product-card data-product-id="<%= product.id %>">
  <div class="product-thumb-wrap">
    <a
      href="/product/<%= product.slug %>"
      class="product-cover-link"
      aria-label="Lihat produk <%= product.name %>"
    >
      <% if (product.thumbnail_url || product.thumbnail_path) { %><img loading="lazy" class="product-thumb" src="<%= product.thumbnail_url || assetUrl(publicAssetBucket, product.thumbnail_path) %>" alt="<%= product.name %>" data-image-fallback><div class="image-fallback" hidden><%- icon('image') %><span>Gambar tidak tersedia</span></div><% } else { %><div class="image-fallback"><%- icon('image') %><span>Gambar tidak tersedia</span></div><% } %>

      <span
        class="product-stock product-stock--<%= stock >= 500 ? 'green' : stock >= 250 ? 'blue' : stock > 0 ? 'orange' : 'sold-out' %> product-stock--cover"
        aria-label="<%= stock > 0 ? stock + ' produk tersedia' : 'Produk habis' %>"
        title="<%= stock > 0 ? stock + ' produk tersedia' : 'Produk habis' %>"
      >
        <span class="product-stock-dot" aria-hidden="true">•</span>
        <%= stock > 0 ? stock : 'Habis' %>
      </span>
    </a>



  </div>
  <div class="product-body">

    <div class="product-actions">
      <div class="product-action-row">
        <a
          href="/product/<%= product.slug %>"
          class="product-title"
        ><%= product.name %></a>
      </div>
    </div>
  </div>
</article>
