<% const stock = Math.max(0, Number(product.stock) || 0); %>
<% const stockStatus = stock <= 0 ? 'sold-out' : 'green'; %>
<% const stockLabel = stockStatus === 'sold-out' ? 'Habis' : 'Tersedia'; %>
<% const imageLoading = typeof productCardImageLoading !== 'undefined' ? productCardImageLoading : 'lazy'; %>
<% const imageFetchPriority = typeof productCardImageFetchPriority !== 'undefined' ? productCardImageFetchPriority : null; %>
<article class="product-card" data-product-card data-product-id="<%= product.id %>">
  <div class="product-thumb-wrap">
    <a
      href="/product/<%= product.slug %>"
      class="product-cover-link"
      aria-label="Lihat produk <%= product.name %>"
    >
      <% if (product.thumbnail_url || product.thumbnail_path) { %>
        <img
          class="product-thumb"
          src="<%= product.thumbnail_url || assetUrl(publicAssetBucket, product.thumbnail_path) %>"
          alt="<%= product.name %>"
          width="600"
          height="600"
          loading="<%= imageLoading %>"
          <% if (imageFetchPriority) { %>fetchpriority="<%= imageFetchPriority %>"<% } %>
          decoding="async"
          data-image-fallback
        >
        <div class="image-fallback" hidden><%- icon('image') %><span>Gambar tidak tersedia</span></div>
      <% } else { %>
        <div class="image-fallback"><%- icon('image') %><span>Gambar tidak tersedia</span></div>
      <% } %>

      <span
        class="product-stock product-stock--<%= stockStatus %> product-stock--cover"
        aria-label="<%= stockLabel %>"
        title="<%= stockLabel %>"
      >
        <span class="product-stock-dot" aria-hidden="true">•</span>
        <%= stockLabel %>
      </span>
    </a>



  </div>
  <div class="product-body">

    <div class="product-actions">
      <div class="product-action-row">
        <a
          href="/product/<%= product.slug %>"
          class="product-title"
        ><%= product.name %></a>
      </div>
    </div>
  </div>
</article>
