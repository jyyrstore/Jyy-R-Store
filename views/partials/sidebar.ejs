<%
const currentPath=String(req.originalUrl||req.path||'').split('?')[0];

const ownerMode=profile?.role==='OWNER' &&
  (currentPath==='/owner' || currentPath.startsWith('/owner/'));

const activeOwnerSection=currentPath.split('/')[2] || 'dashboard';

const ownerNav=[['dashboard','Dashboard','dashboard-owner'],['products','Produk','shop-twotone'],['categories','Kategori','layers'],['orders','Pesanan','transaction-history'],['payments','Pembayaran','credit-card'],['deposits','Deposit','wallet-plus'],['users','Pengguna','interface-user-circle-circle-geometric'],['roles','Peran','user-id-outline'],['tickets','Tiket','user-headset-outline'],['messages','Pesan','message'],['services','Layanan','layanan'],['information','Informasi','text-box-multiple-outline'],['faq','FAQ','help-circle'],['notifications','Notifikasi','bell'],['maintenance','Pemeliharaan','wrench'],['storage','Penyimpanan','server-security'],['activity','Log Aktivitas','user-time'],['login-history','Riwayat Login','log-in'],['reports','Laporan','bar-chart-outlined'],['top-orders','Pesanan Teratas','trophy'],['security','Keamanan','shield-key-outline'],['refunds','Pengembalian','money-bill-transfer'],['settings','Pengaturan','gear'],['system','Sistem','server-security']];
%>
<aside class="sidebar <%= ownerMode?'sidebar-owner':'' %>" id="sidebar">
  <div class="sidebar-inner">
    <% if (ownerMode) { %>
      <a class="nav-link sidebar-owner-back" href="/dashboard">
        <span class="sidebar-back-arrow" aria-hidden="true"><%- icon('nav-dashboards') %></span>
        <span>Kembali ke Dashboard</span>
      </a>

      <div class="sidebar-section-label">Owner Panel</div>

      <% ownerNav.forEach(([key,label,ic])=>{ %>
        <a
          class="nav-link <%= activeOwnerSection===key?'active':'' %>"
          href="/owner/<%= key %>"
        >
          <%- icon(ic) %>
          <span><%= label %></span>
        </a>
      <% }) %>

      <% if (currentUser) { %>
        <div class="sidebar-section-label">Profil & Sesi</div>
        <a class="nav-link <%= req.path.startsWith('/profile')?'active':'' %>" href="/profile">
          <%- icon('user') %><span>Profil</span>
        </a>
        <button class="nav-link nav-button" data-logout>
          <%- icon('logout') %><span>Keluar</span>
        </button>
      <% } %>
    <% } else { %>
    <div class="sidebar-section-label">Toko</div>
    <a class="nav-link <%= req.path==='/'?'active':'' %>" href="/"><%- icon('home') %><span>Beranda</span></a>
    <a class="nav-link <%= req.path==='/store'?'active':'' %>" href="/store"><%- icon('shop-twotone') %><span>Toko</span></a>

    <% if (currentUser) { %>
      <div class="sidebar-section-label">Akun</div>
      <a class="nav-link <%= req.path==='/dashboard'?'active':'' %>" href="/dashboard"><%- icon('nav-dashboards') %><span>Dashboard</span></a>
      <a class="nav-link <%= req.path.startsWith('/orders')?'active':'' %>" href="/orders"><%- icon('transaction-history') %><span>Pesanan</span></a>
      <a class="nav-link <%= req.path.startsWith('/delivery')?'active':'' %>" href="/delivery"><%- icon('archive-box-arrow-down') %><span>Produk Saya</span></a>
      <a class="nav-link <%= req.path==='/history'?'active':'' %>" href="/history"><%- icon('dialog-history') %><span>Riwayat</span></a>
      <a class="nav-link <%= req.path.startsWith('/deposit')?'active':'' %>" href="/deposit"><%- icon('wallet') %><span>Wallet</span></a>

      <div class="sidebar-section-label">Bantuan</div>
      <a class="nav-link <%= req.path.startsWith('/messages')?'active':'' %>" href="/messages"><%- icon('message') %><span>Pesan</span></a>
      <a class="nav-link <%= req.path.startsWith('/tickets')?'active':'' %>" href="/tickets"><%- icon('user-headset-outline') %><span>Tiket</span></a>
      <a class="nav-link <%= req.path.startsWith('/notifications')?'active':'' %>" href="/notifications"><%- icon('bell') %><span>Notifikasi</span></a>
    <% } %>

    <div class="sidebar-section-label">Sumber Daya</div>
    <% if (currentUser) { %>
      <a class="nav-link" href="/services"><%- icon('layanan') %><span>Layanan</span></a>
      <a class="nav-link" href="/top-order"><%- icon('trophy') %><span>Top Order</span></a>
    <% } %>
    <a class="nav-link <%= req.path.startsWith('/faq')?'active':'' %>" href="/faq"><%- icon('help-circle') %><span>FAQ</span></a>
    <a class="nav-link <%= req.path.startsWith('/security')?'active':'' %>" href="/security"><%- icon('shield-key-outline') %><span>Keamanan</span></a>

    <% if (profile?.role === 'OWNER') { %>
      <div class="sidebar-section-label">Management</div>
      <a class="nav-link <%= req.path.startsWith('/owner')?'active':'' %>" href="/owner"><%- icon('dashboard-owner') %><span>Owner Panel</span></a>
    <% } %>

    <% if (currentUser) { %>
      <div class="sidebar-section-label">Profil & Sesi</div>
      <a class="nav-link <%= req.path.startsWith('/profile')?'active':'' %>" href="/profile"><%- icon('user') %><span>Profil</span></a>
      <button class="nav-link nav-button" data-logout><%- icon('logout') %><span>Keluar</span></button>
    <% } %>
    <% } %>
  </div>
</aside>
<div class="drawer-backdrop" data-drawer-close></div>
