<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">
    <div class="sidebar-section-label">Store</div>
    <a class="nav-link <%= req.path==='/'?'active':'' %>" href="/"><%- icon('home') %><span>Home</span></a>
    <% if (currentUser) { %>
      <a class="nav-link <%= req.path==='/dashboard'?'active':'' %>" href="/dashboard"><%- icon('dashboard') %><span>Dashboard</span></a>
      <a class="nav-link <%= req.path==='/history'?'active':'' %>" href="/history"><%- icon('history') %><span>Riwayat</span></a>
      <a class="nav-link <%= req.path.startsWith('/messages')?'active':'' %>" href="/messages"><%- icon('message') %><span>Pesan</span></a>
      <a class="nav-link" href="/top-order"><%- icon('package') %><span>Top Order</span></a>
      <a class="nav-link" href="/deposit"><%- icon('wallet') %><span>Deposit</span></a>
      <a class="nav-link" href="/services"><%- icon('settings') %><span>Layanan</span></a>
      <a class="nav-link" href="/tickets"><%- icon('ticket') %><span>Tiket</span></a>
    <% end %>
    <% } %>
    <a class="nav-link" href="/faq"><%- icon('info') %><span>FAQ</span></a>
    <a class="nav-link" href="/security"><%- icon('shield') %><span>Security</span></a>
    <% if (profile?.role === 'OWNER' || profile?.role === 'ADMIN' || profile?.role === 'MODERATOR') { %>
      <div class="sidebar-section-label">Management</div>
      <a class="nav-link" href="/owner"><%- icon('dashboard') %><span>Owner Panel</span></a>
    <% } %>
    <% if (currentUser) { %>
      <a class="nav-link" href="/profile"><%- icon('user') %><span>Profil</span></a>
      <button class="nav-link nav-button" data-logout><%- icon('external') %><span>Logout</span></button>
    <% } %>
  </div>
</aside>
<div class="drawer-backdrop" data-drawer-close></div>
