# Jyy'R Store environment contract — no production secrets here.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Jyy'R Store

# Supabase (service-role is SERVER ONLY)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Storage
PUBLIC_ASSET_BUCKET=public-assets
PRIVATE_PRODUCT_BUCKET=private-products
USER_UPLOAD_BUCKET=user-uploads
SIGNED_URL_EXPIRATION=300
MAX_UPLOAD_MB=100

# Auth/session security
SESSION_SECRET=GENERATE_SECURE_RANDOM_SECRET
COOKIE_SECRET=GENERATE_SECURE_RANDOM_SECRET
CSRF_SECRET=GENERATE_SECURE_RANDOM_SECRET
ENCRYPTION_KEY=GENERATE_32_BYTE_BASE64_KEY

# Payment provider adapter (provider-specific; do not invent values)
PAYMENT_PROVIDER=generic-json
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-signature
PAYMENT_WEBHOOK_SIGNATURE_ALGORITHM=sha256
PAYMENT_ENVIRONMENT=sandbox

# Email / SMTP (optional until owner configures provider)
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=Jyy'R Store
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Operational controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SENSITIVE_RATE_LIMIT_MAX=20
ENABLE_CRON=false
CRON_SECRET=
LOG_LEVEL=info
ALLOW_INCOMPLETE_DEV_CONFIG=true

# Optional public store configuration; never put secrets here.
WHATSAPP_ORDER=
WHATSAPP_SUPPORT=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
SOCIAL_TELEGRAM=
SOCIAL_DISCORD=
SOCIAL_GITHUB=

OWNER_USER_ID=
